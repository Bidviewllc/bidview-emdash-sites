---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/bidview-homepage.css';

import raw from '../../Pages/bidview-homepage.html?raw';
const bodyMatch = raw.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const bodyHtml = bodyMatch ? bodyMatch[1] : '';
const pageHtml = bodyHtml
  .replace(/<header class="site-header"[\s\S]*?<\/header>/i, '')
  .replace(/<footer class="site-footer"[\s\S]*?<\/footer>/i, '')
  .replace(/<script\s+src="\.\/[^\"]+\.js"[^>]*><\/script>\s*$/i, '')
  .trim();
---
<BaseLayout
  title="Revenue-Focused Digital Marketing Agency | Bidview Marketing"
  metaDescription="Bidview Marketing helps growing businesses increase revenue through SEO, website development, paid advertising, branding, content, and AI automation."
  canonicalPath="/"
  scriptSrc="/scripts/bidview-homepage.js"
>
  <SiteHeader />
  <Fragment set:html={pageHtml} />
  <SiteFooter />
</BaseLayout>
