---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../../Pages/internal-pages-custom.css';

import raw from '../../Pages/About.html?raw';
const bodyMatch = raw.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
const bodyHtml = bodyMatch ? bodyMatch[1] : '';
const pageHtml = bodyHtml
  .replace(/<header class="site-header"[\s\S]*?<\/header>/i, '')
  .replace(/<footer class="site-footer"[\s\S]*?<\/footer>/i, '')
  .trim();
---
<BaseLayout
  title="About - Bidview Marketing"
  metaDescription="Bidview Marketing helps professional service businesses grow revenue by building clear, predictable systems that attract the right clients and convert demand"
  ogImage="/Assets/line-drawing-of-cameron-working-on-building-drawings.jpg"
  schema={[{ '@type': 'AboutPage', '@id': 'https://www.bidviewmarketing.com/about/#aboutpage', url: 'https://www.bidviewmarketing.com/about/', name: 'About - Bidview Marketing' }]}
>
  <SiteHeader />
  <Fragment set:html={pageHtml} />
  <SiteFooter />
</BaseLayout>
