{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidviewmarketing-staging",
  "account_id": "239e9d015c7a3a39cdc2e9400312f553",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bidviewmarketing-staging",
      "database_id": "128e040b-501c-496a-bddc-7bfeb94e2e97"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bidviewmarketing-staging-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "028dfa4da881449cb1fcfb8ae46b6e2e"
    }
  ]
}
