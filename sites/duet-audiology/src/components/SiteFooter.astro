---
<!-- Sticky mobile CTA bar -->
<div class="mobile-sticky-cta">
  <a href="tel:8472951185" class="mobile-sticky-cta-inner">
    <span class="mobile-sticky-icon">
      <svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z" fill="white"/>
      </svg>
    </span>
    <span class="mobile-sticky-text">
      <span class="mobile-sticky-label">Have Questions?</span>
      <span class="mobile-sticky-number">Call Us Today! (847) 295-1185</span>
    </span>
  </a>
</div>

<!-- Cloudflare Turnstile — anti-spam widget script -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<!-- Schedule Appointment popup (opened by all Schedule buttons) -->
<div class="schedule-popup" id="schedulePopup" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="schedulePopupTitle">
  <div class="schedule-popup-backdrop" data-popup-close></div>
  <div class="schedule-popup-card">
    <button type="button" class="schedule-popup-close" data-popup-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4 L16 16 M16 4 L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="schedule-popup-body">
      <p class="schedule-popup-eyebrow">Request an appointment</p>
      <h2 class="schedule-popup-title" id="schedulePopupTitle">Schedule your first visit</h2>
      <p class="schedule-popup-desc">Tell us a little about you and we'll be in touch within 1-2 business days to confirm your visit.</p>
      <form class="schedule-form" id="scheduleForm" novalidate>
        <div class="schedule-row">
          <label class="schedule-field">
            <span class="schedule-label">First name <span class="req">*</span></span>
            <input type="text" name="firstName" required autocomplete="given-name">
          </label>
          <label class="schedule-field">
            <span class="schedule-label">Last name <span class="req">*</span></span>
            <input type="text" name="lastName" required autocomplete="family-name">
          </label>
        </div>
        <div class="schedule-row">
          <label class="schedule-field">
            <span class="schedule-label">Email <span class="req">*</span></span>
            <input type="email" name="email" required autocomplete="email">
          </label>
          <label class="schedule-field">
            <span class="schedule-label">Phone <span class="req">*</span></span>
            <input type="tel" name="phone" required autocomplete="tel">
          </label>
        </div>
        <label class="schedule-field">
          <span class="schedule-label">Preferred date</span>
          <input type="date" name="preferredDate">
        </label>
        <label class="schedule-field">
          <span class="schedule-label">Reason for visit</span>
          <select name="reason">
            <option value="">Select an option…</option>
            <option>Ear to Brain Evaluation™</option>
            <option>Ear to Brain Fitness™</option>
            <option>Tinnitus consultation</option>
            <option>General hearing check-up</option>
            <option>Other</option>
          </select>
        </label>
        <label class="schedule-field">
          <span class="schedule-label">Message</span>
          <textarea name="message" rows="3" placeholder="Anything we should know in advance?"></textarea>
        </label>
        <!-- Honeypot: hidden from humans, bots fill it -->
        <label class="schedule-honeypot" aria-hidden="true" tabindex="-1">
          Website
          <input type="text" name="website" autocomplete="off" tabindex="-1">
        </label>
        <!-- Cloudflare Turnstile widget — anti-spam -->
        <div class="cf-turnstile schedule-turnstile" data-sitekey="0x4AAAAAADyoU6TDMeVTGFsC" data-theme="light"></div>
        <p class="schedule-error" id="scheduleError" hidden></p>
        <button type="submit" class="schedule-submit">
          Request appointment
          <span class="schedule-submit-arrow" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M14 7L19 12L14 17" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <p class="schedule-fine">By submitting this form you agree to our <a href="/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a> and consent to be contacted by Duet Hearing.</p>
      </form>
      <div class="schedule-success" id="scheduleSuccess" hidden>
        <div class="schedule-success-icon" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
            <circle cx="28" cy="28" r="26" stroke="#00B2E4" stroke-width="3"/>
            <path d="M16 28 L25 37 L40 19" stroke="#00B2E4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </div>
        <h3>Thanks — we'll be in touch!</h3>
        <p>Your request was received. Someone from our team will reach out within 1-2 business days.</p>
        <button type="button" class="schedule-success-close" data-popup-close>Close</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ── Inheritance resets ────────────────────────────────────────────
     interior.css sets body { font-family: Plus Jakarta Sans; line-height: 1.5;
     color: #21273F } which cascades into every contact + footer descendant.
     Reset on every contact/footer element so the contact + footer always
     matches the homepage rendering. */
  .contact-footer-wrap,
  .contact-footer-wrap *,
  .footer,
  .footer *,
  .mobile-sticky-cta,
  .mobile-sticky-cta * {
    font-family: 'Suisse BP Intl', sans-serif !important;
    line-height: normal !important;
  }
  /* Re-apply specific fonts that aren't Suisse */
  .footer-nl-heading,
  .footer-nl-btn,
  .contact-eyebrow,
  .contact-cta {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
  }
  .footer-nl-input {
    font-family: 'Inter', 'Suisse BP Intl', sans-serif !important;
  }
  /* Re-apply line-heights that aren't "normal" on the homepage */
  .footer-nl-desc { line-height: 24px !important; }
  .footer-nl-disclaimer { line-height: 21px !important; }

  /* ── Specific font-size + color overrides ──────────────────────────
     interior.css selectors like .footer-newsletter p (0,1,1) outrank
     styles.css .footer-nl-heading (0,1,0). These !important re-apply
     the homepage values. */
  .footer-nl-heading {
    font-size: 18px !important;
    font-weight: 400 !important;
    color: #00B2E4 !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    margin-bottom: 16px !important;
  }
  .footer-nl-desc {
    font-size: 16px !important;
    color: #4E5779 !important;
    margin-bottom: 24px !important;
  }
  .footer-nl-disclaimer {
    font-size: 14px !important;
    color: #9CA1C7 !important;
    line-height: 21px !important;
  }
  .footer-nl-disclaimer a { color: #21273F !important; }
  .footer-nav-title {
    font-size: 16px !important;
    font-weight: 500 !important;
    color: #21273F !important;
    margin-bottom: 16px !important;
  }
  .footer-nav-list a {
    font-size: 14px !important;
    color: #4E5779 !important;
  }
  .footer-nl-input {
    padding: 14px 24px !important;
    font-size: 16px !important;
    color: #21273F !important;
    border: none !important;
    background: none !important;
    flex: 1 !important;
    outline: none !important;
    border-radius: 0 !important;
  }
  .footer-nl-btn {
    padding: 12px 28px !important;
    font-size: 20px !important;
    color: #00B2E4 !important;
    background: none !important;
    border: none !important;
    border-radius: 0 !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
  }
  .footer-legal-links a {
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #21273F !important;
    text-decoration: underline !important;
  }
  .footer-copyright {
    font-size: 14px !important;
