    font-family: 'Barlow Condensed', 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  @media (max-width: 1024px) {
    .mobile-sticky-cta { display: block; }
    /* Push content above sticky CTA */
    body { padding-bottom: 76px; }
