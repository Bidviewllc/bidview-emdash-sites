  @media (max-width: 540px) {
    .schedule-popup-body { padding: 32px 24px 24px; }
    .schedule-popup-title { font-size: 26px !important; }
    .schedule-row { grid-template-columns: 1fr; }
  }
  /* Lock body scroll when popup is open */
  body.schedule-popup-open { overflow: hidden; }
</style>

<script is:inline>
(function() {
  function initAnimObserver() {
    const els = document.querySelectorAll('[data-anim]');
    if (!els.length) return;
    const obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var delay = parseInt(el.dataset.delay || 0);
          setTimeout(function() { el.classList.add('anim-visible'); }, delay);
          obs.unobserve(el);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function(el) { obs.observe(el); });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimObserver);
  } else {
    initAnimObserver();
  }

  // ── Schedule popup ────────────────────────────────────────────────
  function initSchedulePopup() {
    const popup = document.getElementById('schedulePopup');
    if (!popup) return;
    const form = document.getElementById('scheduleForm');
    const successPanel = document.getElementById('scheduleSuccess');
    const errorEl = document.getElementById('scheduleError');

    function openPopup() {
      form.style.display = '';
      successPanel.hidden = true;
      if (errorEl) errorEl.hidden = true;
      popup.classList.add('is-open');
      popup.setAttribute('aria-hidden', 'false');
      document.body.classList.add('schedule-popup-open');
      // Focus first field shortly after open
      setTimeout(function() {
        var first = form.querySelector('input[name="firstName"]');
        if (first) first.focus();
      }, 80);
    }
    function closePopup() {
      popup.classList.remove('is-open');
      popup.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('schedule-popup-open');
    }
    window.duetOpenSchedule = openPopup;

    // Wire up all Schedule-style buttons site-wide
    var triggerSelectors = [
      '.btn-schedule',
      '.mobile-nav-cta',
      '.contact-cta'
    ];
    document.addEventListener('click', function(e) {
      var match = e.target.closest(triggerSelectors.join(','));
      if (match) {
        e.preventDefault();
        openPopup();
        return;
      }
      // Close on backdrop / close-button click
      var closer = e.target.closest('[data-popup-close]');
      if (closer && popup.contains(closer)) {
        e.preventDefault();
        closePopup();
      }
    });
    // Escape key closes
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && popup.classList.contains('is-open')) closePopup();
    });

    // Submit handler — client-side validation only (backend not wired yet)
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      errorEl.hidden = true;

      // Honeypot check
      if (form.elements['website'].value) {
        // Silently pretend success — don't tip off bot
        form.style.display = 'none';
        successPanel.hidden = false;
        return;
      }

      // Required-field check
      var required = ['firstName', 'lastName', 'email', 'phone'];
      for (var i = 0; i < required.length; i++) {
        var field = form.elements[required[i]];
        if (!field || !field.value.trim()) {
          errorEl.textContent = 'Please fill in all required fields.';
          errorEl.hidden = false;
          field && field.focus();
          return;
        }
      }
      // Basic email format check
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.elements['email'].value.trim())) {
        errorEl.textContent = 'Please enter a valid email address.';
        errorEl.hidden = false;
        form.elements['email'].focus();
        return;
      }

      // Cloudflare Turnstile token — client-side anti-spam
      var turnstileToken = '';
      try {
        if (window.turnstile && typeof window.turnstile.getResponse === 'function') {
          turnstileToken = window.turnstile.getResponse() || '';
        }
      } catch (e) {}
      if (!turnstileToken) {
        errorEl.textContent = 'Please complete the anti-spam check before submitting.';
        errorEl.hidden = false;
        return;
      }

      var payload = {
        firstName: form.elements['firstName'].value.trim(),
        lastName: form.elements['lastName'].value.trim(),
        email: form.elements['email'].value.trim(),
        phone: form.elements['phone'].value.trim(),
        preferredDate: form.elements['preferredDate'].value,
        reason: form.elements['reason'].value,
        message: form.elements['message'].value.trim(),
        website: form.elements['website'].value,
        turnstileToken: turnstileToken
      };

      var submitBtn = form.querySelector('.schedule-submit');
      if (submitBtn) submitBtn.disabled = true;

      fetch('/api/schedule/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, body: j }; }); })
      .then(function(res) {
        if (res.ok && res.body && res.body.ok) {
          form.style.display = 'none';
          successPanel.hidden = false;
          // GA4 conversion. The submit is intercepted below, so enhanced measurement's
          // automatic form_submit cannot be relied on: fire it explicitly on success only.
          if (typeof gtag === 'function') {
            gtag('event', 'form_submit', { form_id: 'scheduleForm', form_name: 'Request an appointment' });
          }
        } else {
          var msg = 'Something went wrong sending your request. Please try again or call (847) 295-1185.';
          if (res.body && res.body.error === 'turnstile_failed') msg = 'Anti-spam verification failed. Please try again.';
          errorEl.textContent = msg;
          errorEl.hidden = false;
          try { if (window.turnstile) window.turnstile.reset(); } catch (e) {}
        }
      })
      .catch(function() {
        errorEl.textContent = 'Could not reach the server. Please try again or call (847) 295-1185.';
        errorEl.hidden = false;
        try { if (window.turnstile) window.turnstile.reset(); } catch (e) {}
      })
      .finally(function() {
        if (submitBtn) submitBtn.disabled = false;
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSchedulePopup);
  } else {
    initSchedulePopup();
  }
})();
</script>
