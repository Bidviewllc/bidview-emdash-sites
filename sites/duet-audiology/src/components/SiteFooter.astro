  .schedule-popup-close:hover { background: #00B2E4; color: #ffffff; }
  .schedule-popup-body { padding: 40px 40px 32px; }
  .schedule-popup-eyebrow {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 14px !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    color: #00B2E4 !important;
    margin: 0 0 8px !important;
  }
  .schedule-popup-title {
    font-family: 'Suisse BP Intl', sans-serif !important;
    font-size: 32px !important;
    font-weight: 300 !important;
    line-height: 1.15 !important;
    color: #21273F !important;
    margin: 0 0 8px !important;
