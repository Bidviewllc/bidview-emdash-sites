  .schedule-honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }
  .schedule-math-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .schedule-math-question {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 20px !important;
    font-weight: 500 !important;
    color: #00B2E4 !important;
    background: #F3FAFF;
    padding: 10px 16px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .schedule-math-row input { max-width: 100px; }
  .schedule-turnstile { margin: 4px 0 8px; min-height: 65px; }
  .schedule-error {
    font-family: 'Suisse BP Intl', sans-serif !important;
    font-size: 14px !important;
    color: #d4456a !important;
    background: rgba(212, 69, 106, 0.08);
    padding: 10px 14px;
    border-radius: 10px;
    margin: 0 !important;
  }
  .schedule-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #00B2E4 !important;
    color: #ffffff !important;
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 18px !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
    padding: 14px 24px !important;
    border: none !important;
    border-radius: 100px !important;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.2s ease;
    margin-top: 8px;
  }
  .schedule-submit:hover { background: #009dcc !important; transform: translateX(2px); }
  .schedule-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .schedule-submit-arrow {
    display: inline-flex;
    width: 28px; height: 28px;
    background: #FEA153;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
  }
  .schedule-fine {
    font-family: 'Suisse BP Intl', sans-serif !important;
    font-size: 12px !important;
    color: #9CA1C7 !important;
    line-height: 1.4 !important;
    margin: 4px 0 0 !important;
  }
  .schedule-success { text-align: center; padding: 20px 0; }
  .schedule-success-icon { margin-bottom: 16px; }
  .schedule-success h3 {
    font-family: 'Suisse BP Intl', sans-serif !important;
    font-size: 24px !important;
    font-weight: 300 !important;
    color: #21273F !important;
