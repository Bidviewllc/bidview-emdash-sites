  /* ── Schedule appointment popup ─────────────────────────────────── */
  .schedule-popup {
    position: fixed; inset: 0;
    z-index: 9000;
    display: none;
    align-items: center; justify-content: center;
    padding: 20px;
  }
  .schedule-popup.is-open { display: flex; }
  .schedule-popup-backdrop {
    position: absolute; inset: 0;
    background: rgba(24, 28, 46, 0.62);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: schPopupFade 0.2s ease;
  }
  .schedule-popup-card {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
    animation: schPopupRise 0.25s cubic-bezier(.2,.8,.2,1);
  }
  @keyframes schPopupFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes schPopupRise { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
