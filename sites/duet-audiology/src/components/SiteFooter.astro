    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .mobile-sticky-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.85;
