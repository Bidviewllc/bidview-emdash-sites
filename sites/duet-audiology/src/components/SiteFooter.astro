  /* Hide Quick Links + About footer columns for now (DOM preserved for easy
     re-enable). Targets the first two .footer-nav-col elements; the third
     (Follow Us w/ social list) stays visible and is pushed to the far right. */
  .footer-nav .footer-nav-col:nth-child(1),
  .footer-nav .footer-nav-col:nth-child(2) {
    display: none !important;
  }
  /* With only one column visible, the .footer-nav container collapses around it.
     Force it to span the full width and push the visible col to the right. */
  .footer-nav {
    width: 100% !important;
    display: flex !important;
    justify-content: flex-end !important;
  }
  .footer-nav .footer-nav-col:nth-child(3) {
    margin-left: auto !important;
    text-align: left !important;
  }
  .footer-nav .footer-nav-col:nth-child(3) .footer-social-list {
    align-items: flex-start !important;
  }
  .footer-nav .footer-nav-col:nth-child(3) .footer-social-list li {
    justify-content: flex-start !important;
  }

  /* ── Contact section overrides (beat interior.css .contact-* rules) ──
     interior.css has its own contact section design — different fonts,
     info-card styling, padding, layout. These !important match homepage. */
  .contact-heading {
    font-size: 60px !important;
    font-weight: 300 !important;
    line-height: 1.1 !important;
    color: #fff !important;
    margin: 0 0 40px !important;
    max-width: none !important;
    letter-spacing: normal !important;
  }
  .contact-info {
    background: #009BC6 !important;
    border-radius: 0 0 24px 24px !important;
    padding: 32px 40px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 24px !important;
    grid-template-columns: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
  .contact-frame {
    gap: 60px !important;
  }
  .contact-left {
    flex: 1 !important;
    max-width: 500px !important;
  }
  /* Map + info card stack flush (homepage gap 0, interior.css sets 30px) */
  .contact-right {
    gap: 0 !important;
  }
  .contact-step-desc {
    line-height: 1.5 !important;
  }
  .contact-note {
    line-height: 1.5 !important;
  }
  /* Restore homepage map height (interior.css sets 530px on .location-map but
     homepage uses .contact-map at a different height) */

  .mobile-sticky-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3900;
    background: #00B2E4;
  }
  .mobile-sticky-cta-inner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
