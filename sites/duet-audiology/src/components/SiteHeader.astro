<style is:global>
  /* ── CSS custom properties ─────────────────────────────────────────── */
  :root {
    /* Announce bar hidden — header sits at top: 0 */
    --announce-height: 0px;
    --header-top-offset: 0px;
  }

  /* ── Inheritance resets ────────────────────────────────────────────
     interior.css sets body { font-family: Plus Jakarta Sans; line-height: 1.5;
     color: #21273F } which cascades into every header descendant and shifts
     link heights, button heights, and bar text color. Reset on every header
     element so the header always matches the homepage. */
  .announce-bar,
  .announce-bar *,
  .site-header,
  .site-header *,
  .mobile-nav,
  .mobile-nav * {
    font-family: 'Suisse BP Intl', sans-serif !important;
    line-height: normal !important;
    color: inherit;
  }
  .announce-bar, .announce-bar * { color: #ffffff; }
  /* Re-apply specific fonts/colors that aren't Suisse */
  .btn-schedule-text,
  .announce-cta {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
  }
  .nav-links a { color: #21273F !important; }
  .nav-phone-num { color: #4D5779 !important; }

  /* ── Trademark symbol ─────────────────────────────────────────── */
  .tm {
    font-size: 0.55em;
    vertical-align: super;
    line-height: 0;
    margin-left: 1px;
  }

  /* ── Logo: DUET SVG + tagline (matches staging design) ───────── */
  .logo-link {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important;
    gap: 2px !important;
    height: auto !important;
    width: auto !important;
    text-decoration: none !important;
    line-height: 1 !important;
    padding: 0 !important;
    overflow: visible !important;
  }
  .logo-svg {
    display: block !important;
    flex-shrink: 0 !important;
    width: 120px !important;
    height: 68px !important;
  }
  .logo-tagline {
    font-family: 'Suisse BP Intl', sans-serif !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0.15px !important;
    color: #00B2E4 !important;
    text-transform: none !important;
    white-space: nowrap !important;
    margin-left: 14px !important;
    transition: color 0.4s ease;
  }
  /* Dark-slide: DUET letters + tagline white over dark/cyan bg */
  html.dark-slide .logo-svg path {
    fill: #ffffff !important;
  }
  html.dark-slide .logo-tagline {
    color: #ffffff !important;
  }

  /* ── Submenu dropdowns ────────────────────────────────────────── */
  .nav-links li.has-submenu {
    position: relative;
  }
  .nav-submenu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 18px;
    min-width: 220px;
    padding: 20px 0;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(33, 39, 63, 0.12), 0 2px 6px rgba(33, 39, 63, 0.08);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
    z-index: 100;
  }
  .nav-links li.has-submenu:hover > .nav-submenu,
  .nav-links li.has-submenu:focus-within > .nav-submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
  }
  .nav-submenu li {
    list-style: none;
  }
  .nav-links .nav-submenu a {
    display: block !important;
    padding: 14px 24px !important;
    font-size: 15px !important;
    color: #21273F !important;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-links .nav-submenu a:hover {
    background: #F3FAFF !important;
    color: #00B2E4 !important;
  }

  /* ── 3rd-level submenu (Team) ─────────────────────────────────── */
  .nav-submenu li.has-subsubmenu {
    position: relative;
  }
  .nav-submenu li.has-subsubmenu > a {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px;
  }
  .nav-submenu .chevron-right {
    width: 8px !important;
    height: 10px !important;
    transform: rotate(-90deg);
  }
  .nav-subsubmenu {
    position: absolute;
    top: 0;
    left: 100%;
    margin-left: 8px;
    min-width: 220px;
    padding: 20px 0;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(33, 39, 63, 0.12), 0 2px 6px rgba(33, 39, 63, 0.08);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
    z-index: 110;
  }
  .nav-submenu li.has-subsubmenu:hover > .nav-subsubmenu,
  .nav-submenu li.has-subsubmenu:focus-within > .nav-subsubmenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
  }
  .nav-subsubmenu li { list-style: none; }
  .nav-subsubmenu a {
    display: block !important;
    padding: 12px 24px !important;
    font-size: 15px !important;
    color: #21273F !important;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-subsubmenu a:hover {
    background: #F3FAFF !important;
    color: #00B2E4 !important;
  }

  /* ── Mobile submenu ───────────────────────────────────────────── */
  .mobile-subnav {
    list-style: none;
    padding: 8px 0 8px 16px;
    margin: 0;
  }
  .mobile-subnav a {
    font-size: 15px !important;
    padding: 6px 0 !important;
    opacity: 0.85;
  }
  .mobile-subnav-group { margin: 6px 0; }
  .mobile-subnav-group-label {
    display: block;
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 13px !important;
    letter-spacing: 1.5px !important;
    text-transform: uppercase !important;
    color: #9CA1C7 !important;
    margin: 8px 0 4px !important;
  }
  .mobile-subsubnav {
    list-style: none;
    padding: 0 0 0 14px;
    margin: 0;
  }
  .mobile-subsubnav a {
    font-size: 14px !important;
    padding: 5px 0 !important;
    opacity: 0.85;
  }

  /* ── Announce bar ──────────────────────────────────────────────────── */
  /* Hidden for now per client request — keep styles for easy re-enable. */
  .announce-bar { display: none !important; }
  .announce-bar.legacy-show {
    width: 100% !important;
    background: #00AED0 !important;
    height: 44px !important;
    display: flex !important;
    align-items: center !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 4001 !important;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .announce-bar.hero-hidden {
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }
  .announce-inner {
    width: 100% !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
