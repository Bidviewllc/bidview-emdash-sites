    function s11Resize() { const r = s11wc.parentElement.getBoundingClientRect(); s11wc.width = r.width * s11dpr; s11wc.height = r.height * s11dpr; }
    s11Resize(); window.addEventListener('resize', s11Resize);
    const s11t0 = performance.now();
    function s11Draw(t) {
      const w = s11wc.width / s11dpr, h = s11wc.height / s11dpr;
      s11ctx.setTransform(s11dpr,0,0,s11dpr,0,0); s11ctx.clearRect(0,0,w,h);
      const p = (t - s11t0) * 0.0008;
      s11ctx.beginPath(); s11ctx.strokeStyle='#00B2E4'; s11ctx.lineWidth=2; s11ctx.globalAlpha=0.15;
      for(let x=0;x<=w;x+=2){const y=h*0.55+40*Math.sin((x/w)*Math.PI*3+p);x===0?s11ctx.moveTo(x,y):s11ctx.lineTo(x,y);} s11ctx.stroke();
      s11ctx.beginPath(); s11ctx.globalAlpha=0.1;
      for(let x=0;x<=w;x+=2){const y=h*0.45+35*Math.sin((x/w)*Math.PI*2.5+p*0.8+1);x===0?s11ctx.moveTo(x,y):s11ctx.lineTo(x,y);} s11ctx.stroke();
      s11ctx.beginPath(); s11ctx.strokeStyle='#FEA153'; s11ctx.lineWidth=1.5; s11ctx.globalAlpha=0.12;
      for(let x=0;x<=w;x+=2){const y=h*0.5+45*Math.sin((x/w)*Math.PI*2.5+p*0.6+1.5);x===0?s11ctx.moveTo(x,y):s11ctx.lineTo(x,y);} s11ctx.stroke(); s11ctx.globalAlpha=1;
