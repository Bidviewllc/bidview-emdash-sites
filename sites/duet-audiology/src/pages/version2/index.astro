---
import Base from "../../layouts/Base.astro";
---
<Base title="Duet Hearing — Healthy Hearing. Healthy Brain.">
<link rel="stylesheet" href="/version2/styles.css" />

<div class="snap-section">
<!-- ANNOUNCEMENT BAR -->
<div class="announce-bar" role="banner">
  <div class="announce-inner">
    <svg class="announce-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <rect x="1" y="2.5" width="16" height="14.5" rx="2" stroke="white" stroke-width="1.4"/>
      <path d="M1 7h16" stroke="white" stroke-width="1.4"/>
      <path d="M5 1v3M13 1v3" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
      <rect x="4" y="10" width="2.5" height="2.5" rx="0.5" fill="white"/>
      <rect x="7.75" y="10" width="2.5" height="2.5" rx="0.5" fill="white"/>
    </svg>
    <span class="announce-text">
      <strong>Event Name Here Like This 2026</strong>
      <span class="sep">|</span>
      <strong>Friday May 14th</strong>
      <span class="sep">|</span>
      Join us for "Preserving Your Hearing and the Science Behind It!" with Dr. Lori Halvorson
    </span>
    <a href="#" class="announce-learn">Learn more</a>
    <a href="#" class="announce-cta" role="button">
      Register Now
      <span class="announce-cta-arrow" aria-hidden="true">
        <svg width="9" height="9" viewBox="0 0 9 9" fill="none">
          <path d="M1.5 4.5H7.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M5 2L7.5 4.5L5 7" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
    <button class="announce-close" aria-label="Close" onclick="this.closest('.announce-bar').style.display='none'">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1L13 13M13 1L1 13" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<!-- HERO + HEADER (header overlays hero) -->
<div style="position:relative;">

  <!-- HERO SECTION -->
  <section class="hero" aria-label="Hero">

    <!-- Full-width background: brain/head from Figma -->
    <div class="hero-bg" aria-hidden="true">
      <img src="/hero-head.png" alt="" />
    </div>

    <!-- Soundwave: @(0,142) 761×340 within 1440px canvas -->
    <div class="hero-soundwave" aria-hidden="true">
      <canvas id="heroWaveCanvas"></canvas>
    </div>

    <!-- 1440px centered canvas for Figma-positioned elements -->
    <div class="hero-canvas">

      <!-- Pills -->
      <div class="pill pill-1" aria-hidden="true">
        <span class="pill-dot" style="background:#6B7DEB;"></span>
        Neural timing &amp; rhythm training
      </div>
      <div class="pill pill-2" aria-hidden="true">
        <span class="pill-dot" style="background:#FC6887;"></span>
        All 3 regions of the ear
      </div>
      <div class="pill pill-3" aria-hidden="true">
        <span class="pill-dot" style="background:#6B7DEB;"></span>
        Ear-to-Brain Fitness
      </div>
      <div class="pill pill-4" aria-hidden="true">
        <span class="pill-dot" style="background:#FEA153;"></span>
        Biology-first diagnostics
      </div>

      <!-- Text content -->
      <div class="hero-content">
        <span class="hero-eyebrow">Hearing &amp; the Brain: A Harmonious Duet</span>
        <h1 class="hero-heading">
          The future of hearing health<br>
          starts <em>before</em> you lose it.
        </h1>
        <p class="hero-body">
          Duet introduces a new standard in prevention-first hearing care, designed
          to preserve clarity, connection, and cognitive vitality for life.
        </p>
      </div>

      <!-- Scroll indicator pinned to bottom center -->
      <div class="hero-scroll">
        <div class="hero-scroll-dot"></div>
        <span class="hero-scroll-label">Scroll to continue</span>
      </div>

    </div>
  </section>

  <!-- HEADER — absolute over hero -->
  <header class="site-header" aria-label="Site header">
    <div class="header-inner">

      <!-- Logo: DUET wordmark + tagline, all cyan, no background box -->
      <a href="/" class="logo-link" aria-label="Duet Hearing home">
        <svg width="177" height="100" viewBox="0 0 176 100" fill="none" xmlns="http://www.w3.org/2000/svg">
