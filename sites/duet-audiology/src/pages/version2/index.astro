        return rect.top <= midpoint && rect.bottom >= midpoint;
      });
      document.documentElement.classList.toggle('dark-slide', hasDark);
    };
    window.addEventListener('scroll', updateDarkTheme, { passive: true });
    window.addEventListener('resize', updateDarkTheme);
    updateDarkTheme();
  }

  // Top chrome lives at body level so sections can't bury it.
  const announceBar = document.querySelector('.announce-bar');
  const siteHeaderEl = document.querySelector('.site-header');
  if (announceBar && announceBar.parentElement !== document.body) {
    document.body.appendChild(announceBar);
  }
  if (siteHeaderEl && siteHeaderEl.parentElement !== document.body) {
    document.body.appendChild(siteHeaderEl);
  }
  const syncHeaderOffset = () => {
    const announceHeight = announceBar &&
      announceBar.style.display !== 'none' &&
      !announceBar.classList.contains('hero-hidden')
      ? `${announceBar.offsetHeight}px`
      : '0px';
    document.documentElement.style.setProperty('--header-top-offset', announceHeight);
  };
  syncHeaderOffset();

  // Sticky header — toggle scrolled class when hero leaves viewport
  const siteHeader = document.querySelector('.site-header');
  const heroSection = document.querySelector('.hero');
  if (siteHeader && heroSection) {
    const heroObs = new IntersectionObserver(([e]) => {
      const showAnnounce = e.isIntersecting && e.intersectionRatio >= 0.45;
      announceBar?.classList.toggle('hero-hidden', !showAnnounce);
      siteHeader.classList.toggle('scrolled', !e.isIntersecting || e.intersectionRatio < 0.5);
      syncHeaderOffset();
    }, { threshold: [0, 0.5, 1] });
    heroObs.observe(heroSection);
  } else if (siteHeader) {
    window.addEventListener('scroll', () => {
      siteHeader.classList.toggle('scrolled', window.scrollY > 100);
    });
  }

  // Announce bar dismiss
  if (announceBar) {
    announceBar.querySelector('.announce-close')?.addEventListener('click', () => {
      announceBar.style.display = 'none';
      syncHeaderOffset();
    });
  }

  // Universal scroll animation observer
  (function() {
    const animEls = document.querySelectorAll('[data-anim]');
    if (!animEls.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('anim-exit');
          entry.target.classList.add('anim-visible');
        } else if (entry.boundingClientRect.top < 0) {
          // Scrolled past — exit upward
          entry.target.classList.remove('anim-visible');
          entry.target.classList.add('anim-exit');
        } else {
          // Below viewport — reset so it can re-enter
          entry.target.classList.remove('anim-visible', 'anim-exit');
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

    animEls.forEach(el => observer.observe(el));
  })();
</script>
</Base>
