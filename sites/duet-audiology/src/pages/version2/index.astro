      const morph = Math.min(elapsed / 2500, 1);
      const eased = 1 - Math.pow(1 - morph, 3);
      const phase = time * 0.0008;

      // Cyan wave
      ctx.beginPath();
      ctx.strokeStyle = '#00B2E4';
      ctx.lineWidth = 2;
      ctx.globalAlpha = 0.8;
      for (let x = 0; x <= w; x += 2) {
        const y = cy + eased * 55 * Math.sin((x / w) * Math.PI * 3 + phase);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Orange wave
      ctx.beginPath();
      ctx.strokeStyle = '#FEA153';
      ctx.lineWidth = 1.5;
      ctx.globalAlpha = 0.28;
      for (let x = 0; x <= w; x += 2) {
        const y = cy + eased * 40 * Math.sin((x / w) * Math.PI * 2.5 + phase * 0.7 + 1.5);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      requestAnimationFrame(draw);
    }
