---
import Interior from '../layouts/Interior.astro';

const SITE = 'https://duethearing.com';
const description = "DUET Method™ Training & Certification: a comprehensive hearing and brain health framework for clinicians, integrating biologic assessment, auditory neuroscience, vestibular function, cognitive wellness, and ear-to-brain rehabilitation.";

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'DUET Method™ Training & Certification',
  description,
  provider: {
    '@type': ['MedicalBusiness', 'MedicalOrganization'],
    '@id': `${SITE}/#organization`,
    name: 'Duet Hearing',
  },
  url: `${SITE}/duet-method-courses/`,
};
const businessService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'DUET Method Courses',
  serviceType: 'MedicalService',
  provider: { '@id': 'https://duethearing.com/#organization' },
  areaServed: { '@type': 'City', name: 'Lake Forest, Illinois' },
  audience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  description,
  url: 'https://duethearing.com/duet-method-courses/',
};

const allSchemas = [courseSchema, businessService];

---
<Interior
  title="DUET Method™ Courses | Duet Hearing"
  description={description}
  schema={allSchemas}
>

<section class="page-hero page-hero--no-media">
  <div class="page-hero-inner">
  <div class="page-hero-text">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">DUET Method Courses</span>
    </nav>

    <h1 class="page-title">DUET Method<sup class="tm">&trade;</sup> Training &amp; Certification Overview</h1>
    <div class="page-underline"></div>
  </div>
  </div>
</section>

<div class="hero-curve curve-arch" aria-hidden="true"></div>

<main class="interior-main">
  <div class="interior-main-inner">

    <article class="article-col service-article">

      <p class="service-intro">The DUET Method<sup class="tm">&trade;</sup> is "a comprehensive hearing and brain health framework that integrates biologic hearing assessment, auditory neuroscience, vestibular function, cognitive wellness, and ear-to-brain rehabilitation."</p>

      <section class="service-block">
        <h2>Educational Offerings</h2>
        <p>Healthcare professionals can access several training tracks, including foundational courses, advanced clinical workshops, and specialized certifications in areas such as ear-to-brain fitness, balance assessment, relaxation techniques, tinnitus management, and brain function evaluation.</p>
      </section>

      <section class="service-block">
        <h2>Professional Credentials</h2>
        <p>Practitioners who complete the training may earn certification and licensing status, enabling them to deliver DUET Method<sup class="tm">&trade;</sup> protocols and patient care strategies in their clinical settings. The approach targets clinicians wanting to adopt a "more comprehensive, brain-based approach to hearing health" rather than conventional hearing care methods.</p>
      </section>

    </article>

    <aside class="sidebar service-sidebar">
      <div class="side-cta">
        <div class="side-cta-image" aria-hidden="true">
          <img src="/s9-card-2.jpg" alt="" />
        </div>
        <div class="side-cta-body">
          <h3>Schedule your first visit</h3>
          <p>Begin with a one-on-one consult to discuss your hearing health goals.</p>
          <a class="btn-schedule" href="#">
            <span class="btn-schedule-text">Schedule</span>
            <span class="btn-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M14 7L19 12L14 17" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </aside>

  </div>
</main>

<style is:global>
  .page-hero--no-media .page-hero-inner {
    grid-template-columns: 1fr !important;
  }
  .service-article :where(.service-intro) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #4E5779 !important;
    margin: 0 0 24px !important;
  }
  .service-article :where(.service-block) {
    padding: 28px 0;
    border-bottom: 1px solid rgba(33, 39, 63, 0.08);
  }
  .service-article :where(.service-block):last-of-type { border-bottom: none; }
  .service-article :where(.service-block h2) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 26px !important;
    font-weight: 600 !important;
    color: #21273F !important;
    margin: 0 0 14px !important;
    line-height: 1.2 !important;
  }
  .service-article :where(.service-block p) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #4E5779 !important;
    margin: 0 !important;
  }
  .service-sidebar .side-cta {
    background: #00B2E4;
    color: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    position: sticky;
    top: 100px;
  }
  .service-sidebar .side-cta-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    position: relative;
  }
  .service-sidebar .side-cta-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,178,228,0) 60%, rgba(0,178,228,0.65) 100%);
  }
  .service-sidebar .side-cta-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block;
  }
  .service-sidebar .side-cta-body { padding: 24px 28px 28px; }
  .service-sidebar h3 {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .service-sidebar p {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.5 !important;
    color: rgba(255,255,255,0.92) !important;
    margin: 0 0 20px !important;
  }
  .service-sidebar .btn-schedule {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    background: #21273F !important;
    color: #ffffff !important;
    padding: 12px 8px 12px 18px !important;
    border-radius: 100px !important;
    text-decoration: none !important;
  }
  .service-sidebar .btn-schedule-text {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 18px !important;
    color: #ffffff !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
  }
  .service-sidebar .btn-arrow {
    width: 36px;
    height: 36px;
    background: #FEA153;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 1024px) {
    .service-sidebar .side-cta { position: static; }
  }
</style>

</Interior>
