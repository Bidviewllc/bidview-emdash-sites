---
import Interior from '../layouts/Interior.astro';
---
<Interior
  title="Terms of Service | Duet Hearing"
  description="The terms that govern your use of the Duet Hearing website."
>

<section class="page-hero">
  <div class="page-hero-inner">
  <div class="page-hero-text">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Terms of Service</span>
    </nav>
    <h1 class="page-title">Terms of Service</h1>
    <div class="page-underline"></div>
    <p class="page-dek">The terms that govern your use of the Duet Hearing website.</p>
  </div>
  <div class="page-hero-media" aria-hidden="true"></div>
  </div>
</section>

<div class="hero-curve curve-arch" aria-hidden="true"></div>

<main class="interior-main">
  <div class="interior-main-inner">
    <article class="article-col legal-article">
      <p class="legal-effective">Effective: June 2, 2026</p>

      <h2>1. Acceptance of Terms</h2>
      <p>
        By accessing or using the Duet Hearing website ("Site"), you agree to these Terms of Service ("Terms"). If you do not agree to these Terms, please do not use the Site.
      </p>

      <h2>2. Use of the Site</h2>
      <p>
