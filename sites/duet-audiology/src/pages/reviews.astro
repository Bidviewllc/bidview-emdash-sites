---
import Interior from '../layouts/Interior.astro';
import reviewData from '../data/google-reviews.json';

const reviews = reviewData.reviews;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Duet Hearing, 267 E Westminster Avenue, Lake Forest, IL 60045')}&query_place_id=${reviewData.placeId}`;
const formatDate = (value: string) => {
  const date = new Date(value);
  return Number.isNaN(date.valueOf()) ? '' : new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
};
const initials = (name: string) => name.trim().slice(0, 1).toUpperCase() || 'G';
---
<Interior title="Google Reviews | Duet Hearing" description="Read Google reviews from patients of Duet Hearing in Lake Forest, Illinois." canonical="https://duethearing.com/reviews/">
  <section class="page-hero reviews-hero">
    <div class="page-hero-inner">
      <div class="page-hero-text">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><span class="current">Reviews</span></nav>
        <h1 class="page-title">Duet Hearing Reviews</h1><div class="page-underline"></div>
        <p class="page-dek">Read what patients say about their experience with our Lake Forest hearing care team.</p>
      </div>
      <a class="google-summary" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="View Duet Hearing reviews on Google">
        <span class="google-mark" aria-hidden="true">G</span><span><strong>{reviewData.googleRating.toFixed(1)} out of 5</strong><small>{reviewData.googleReviewCount.toLocaleString('en-US')} Google reviews</small></span>
      </a>
    </div>
  </section>
  <div class="hero-curve curve-arch" aria-hidden="true"></div>
  <main class="reviews-main" data-review-list data-page-size="10">
    <div class="reviews-head"><p>Patient feedback</p><h2>Shared by our patients</h2></div>
    <div class="review-grid">
      {reviews.map((review, index) => (
        <article class="review-card" data-review-card hidden={index >= 10}>
          <header>
            {review.profileImageUrl ? <img src={review.profileImageUrl} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="avatar-initial" aria-hidden="true">{initials(review.authorName)}</span>}
            <div class="review-person"><h3>{review.authorName}</h3><p>{formatDate(review.timestamp) || review.relativeTime}</p></div><span class="source-mark" aria-label="Google review">G</span>
          </header>
          <div class="stars" aria-label={`${review.rating} out of 5 stars`}>{Array.from({ length: 5 }, (_, star) => <span class:list={['star', { empty: star >= Math.round(review.rating) }]} aria-hidden="true">★</span>)}</div>
          {review.text && <p class="review-text">{review.text}</p>}
          <footer><span>Duet Hearing</span><a href={review.reviewUrl || mapsUrl} target="_blank" rel="noopener noreferrer">View on Google <span aria-hidden="true">↗</span></a></footer>
        </article>
      ))}
    </div>
    <div class="review-actions"><p><span data-visible-count>{Math.min(10, reviews.length)}</span> of {reviews.length} reviews</p>{reviews.length > 10 && <button type="button" data-load-more>Load more reviews <span aria-hidden="true">↓</span></button>}</div>
  </main>
  <script>
    const list = document.querySelector<HTMLElement>('[data-review-list]');
    if (list) {
      const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-review-card]'));
      const button = list.querySelector<HTMLButtonElement>('[data-load-more]');
      const counter = list.querySelector<HTMLElement>('[data-visible-count]');
      const pageSize = Number(list.dataset.pageSize || 10);
      let visible = Math.min(pageSize, cards.length);
      button?.addEventListener('click', () => {
        const next = Math.min(visible + pageSize, cards.length);
        cards.slice(visible, next).forEach((card) => { card.hidden = false; }); visible = next;
        if (counter) counter.textContent = String(visible); if (button && visible >= cards.length) button.hidden = true;
      });
    }
  </script>
  <style>
    .reviews-hero .page-hero-inner{align-items:end!important}.google-summary{display:flex;align-items:center;gap:14px;justify-self:end;min-width:260px;padding:16px 20px;border:1px solid rgba(0,178,228,.25);border-radius:16px;background:#fff;color:#21273f;text-decoration:none;box-shadow:0 12px 32px rgba(33,39,63,.08)}.google-summary:hover{border-color:#00b2e4}.google-mark,.source-mark{display:grid;place-items:center;color:#4285f4;font-family:Arial,sans-serif;font-weight:700}.google-mark{width:40px;height:40px;border-radius:50%;background:#f3faff;font-size:21px}.google-summary span:last-child{display:grid;gap:3px}.google-summary strong{font:600 16px 'Plus Jakarta Sans',sans-serif}.google-summary small{color:#4e5779;font:13px 'Plus Jakarta Sans',sans-serif}
    .reviews-main{width:min(1180px,calc(100% - 40px));margin:0 auto;padding:72px 0 96px}.reviews-head{margin-bottom:34px}.reviews-head>p{margin:0 0 8px;color:#00b2e4;font:500 14px 'Alternate Gothic','Barlow Condensed',sans-serif;letter-spacing:1.5px;text-transform:uppercase}.reviews-head h2{margin:0;color:#21273f;font:300 clamp(34px,4vw,52px)/1.1 'Plus Jakarta Sans',sans-serif}.review-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.review-card{display:flex;flex-direction:column;min-width:0;padding:28px;border:1px solid #e1ecf3;border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(33,39,63,.06)}.review-card[hidden]{display:none}.review-card header{display:grid;grid-template-columns:48px minmax(0,1fr) 24px;align-items:center;gap:13px}.review-card header img,.avatar-initial{width:48px;height:48px;border-radius:50%;object-fit:cover}.avatar-initial{display:grid;place-items:center;background:#dff5fb;color:#007da5;font:600 18px 'Plus Jakarta Sans',sans-serif}.review-person{min-width:0}.review-person h3{overflow:hidden;margin:0 0 3px;color:#21273f;font:600 16px 'Plus Jakarta Sans',sans-serif;text-overflow:ellipsis;white-space:nowrap}.review-person p{margin:0;color:#69708c;font:13px 'Plus Jakarta Sans',sans-serif}.source-mark{font-size:18px}.stars{display:flex;gap:2px;margin:20px 0 14px}.star{color:#f5aa00;font-size:19px}.star.empty{color:#d8d8d8}.review-text{margin:0 0 24px;color:#4e5779;font:16px/1.7 'Plus Jakarta Sans',sans-serif;white-space:pre-line}.review-card footer{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:auto;padding-top:18px;border-top:1px solid #e9f0f4;color:#69708c;font:13px 'Plus Jakarta Sans',sans-serif}.review-card footer a{color:#009bc6;font-weight:600;text-decoration:none;white-space:nowrap}.review-actions{display:grid;justify-items:center;gap:16px;margin-top:42px}.review-actions p{margin:0;color:#69708c;font:14px 'Plus Jakarta Sans',sans-serif}.review-actions button{padding:13px 24px;border:0;border-radius:100px;background:#21273f;color:#fff;cursor:pointer;font:600 15px 'Plus Jakarta Sans',sans-serif}.review-actions button:hover{background:#00b2e4}
    @media(max-width:1024px){.reviews-hero .page-hero-inner{align-items:start!important}.google-summary{justify-self:start}}@media(max-width:767px){.reviews-main{width:min(100% - 28px,1180px);padding:48px 0 72px}.review-grid{grid-template-columns:1fr;gap:16px}.review-card{padding:22px}.review-card footer{align-items:flex-start;flex-direction:column;gap:8px}.google-summary{min-width:0;width:100%;box-sizing:border-box}}
  </style>
</Interior>
