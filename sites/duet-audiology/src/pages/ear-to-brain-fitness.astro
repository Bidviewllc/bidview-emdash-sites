---
import Interior from '../layouts/Interior.astro';

const SITE = 'https://duethearing.com';
const description = "DUET's exclusive Ear to Brain Fitness™ programs strengthen how the brain processes, interprets, and connects with sound — through Timing & Rhythm, Cortex Calm™, Walk & Wire™, SHR Vibrational Therapy™, and Myofascial Release™.";

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: 'Ear to Brain Fitness',
  procedureType: 'NoninvasiveProcedure',
  description,
  url: `${SITE}/ear-to-brain-fitness/`,
};
---
<Interior
  title="Ear to Brain Fitness™ | Duet Hearing"
  description={description}
  schema={serviceSchema}
>

<section class="page-hero page-hero--no-media">
  <div class="page-hero-inner">
  <div class="page-hero-text">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="current">Ear to Brain Fitness</span>
    </nav>

    <h1 class="page-title">Ear to Brain Fitness<sup class="tm">&trade;</sup></h1>
    <div class="page-underline"></div>
  </div>
  </div>
</section>

<div class="hero-curve curve-arch" aria-hidden="true"></div>

<main class="interior-main">
  <div class="interior-main-inner">

    <article class="article-col service-article">

      <p class="service-intro">DUET's exclusive Ear to Brain Fitness<sup class="tm">&trade;</sup> programs are designed for people who want more than hearing aids, they want to strengthen how their brain processes, interprets, and connects with sound.</p>

      <p class="service-intro">Hearing is not just about the ears; it is a whole-brain activity. Our Ear to Brain Fitness<sup class="tm">&trade;</sup> programs target the neural pathways involved in listening, communication, attention, balance, and sensory regulation to help you hear and process fast and efficiently to help your brain age strong.</p>

      <section class="service-block">
        <h2>Ear to Brain Fitness<sup class="tm">&trade;</sup> – Timing &amp; Rhythm</h2>
        <p>Enhances auditory timing, speech-in-noise understanding, and neural processing speed, helping the brain interpret sound more efficiently and with less effort.</p>
      </section>

      <section class="service-block">
        <h2>Ear to Brain Fitness<sup class="tm">&trade;</sup> – Cortex Calm<sup class="tm">&trade;</sup></h2>
        <p>Supports reduced auditory hyper-reactivity and sound sensitivity, helping the brain shift from constant sound vigilance to more balanced and comfortable listening.</p>
      </section>

      <section class="service-block">
        <h2>Ear to Brain Fitness<sup class="tm">&trade;</sup> – Walk &amp; Wire<sup class="tm">&trade;</sup></h2>
        <p>Combines movement and sensory integration activities to strengthen communication between brain networks and improve auditory coordination.</p>
      </section>

      <section class="service-block">
        <h2>Ear to Brain Fitness<sup class="tm">&trade;</sup> – SHR Vibrational Therapy<sup class="tm">&trade;</sup></h2>
        <p>Uses therapeutic vibration to support nervous system regulation, reduce stress-related auditory sensitivity, and promote healthy sound processing.</p>
      </section>

      <section class="service-block">
        <h2>Ear to Brain Fitness<sup class="tm">&trade;</sup> – Myofascial Release<sup class="tm">&trade;</sup></h2>
        <p>Addresses tension in the head, neck, and jaw that may contribute to auditory strain, tinnitus, dizziness, and sound sensitivity.</p>
      </section>

      <p class="service-outro">Every Ear to Brain Fitness<sup class="tm">&trade;</sup> program is customized to your unique auditory and neurologic profile, because optimal hearing is never one-size-fits-all.</p>

    </article>

    <aside class="sidebar service-sidebar">
      <div class="side-cta">
        <div class="side-cta-image" aria-hidden="true">
          <img src="/s9-card-3.jpg" alt="" />
        </div>
        <div class="side-cta-body">
          <h3>Schedule your first visit</h3>
          <p>Begin with a one-on-one consult to discuss your hearing health goals.</p>
          <a class="btn-schedule" href="#">
            <span class="btn-schedule-text">Schedule</span>
            <span class="btn-arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                <path d="M14 7L19 12L14 17" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </aside>

  </div>
</main>

<style is:global>
  .page-hero--no-media .page-hero-inner {
    grid-template-columns: 1fr !important;
  }
  .service-article :where(.service-intro) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #4E5779 !important;
    margin: 0 0 18px !important;
  }
  .service-article :where(.service-outro) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #4E5779 !important;
    margin: 28px 0 0 !important;
  }
  .service-article :where(.service-block) {
    padding: 28px 0;
    border-bottom: 1px solid rgba(33, 39, 63, 0.08);
  }
  .service-article :where(.service-block):last-of-type { border-bottom: none; }
  .service-article :where(.service-block h2) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    color: #21273F !important;
    margin: 0 0 12px !important;
    line-height: 1.25 !important;
  }
  .service-article :where(.service-block p) {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 17px !important;
    line-height: 1.7 !important;
    color: #4E5779 !important;
    margin: 0 !important;
  }
  .service-sidebar .side-cta {
    background: #00B2E4;
    color: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    position: sticky;
    top: 100px;
  }
  .service-sidebar .side-cta-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    position: relative;
  }
  .service-sidebar .side-cta-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,178,228,0) 60%, rgba(0,178,228,0.65) 100%);
  }
  .service-sidebar .side-cta-image img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block;
  }
  .service-sidebar .side-cta-body { padding: 24px 28px 28px; }
  .service-sidebar h3 {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    margin: 0 0 12px !important;
    line-height: 1.2 !important;
  }
  .service-sidebar p {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.5 !important;
    color: rgba(255,255,255,0.92) !important;
    margin: 0 0 20px !important;
  }
  .service-sidebar .btn-schedule {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    background: #21273F !important;
    color: #ffffff !important;
    padding: 12px 8px 12px 18px !important;
    border-radius: 100px !important;
    text-decoration: none !important;
  }
  .service-sidebar .btn-schedule-text {
    font-family: 'Alternate Gothic', 'Barlow Condensed', sans-serif !important;
    font-size: 18px !important;
    color: #ffffff !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
  }
  .service-sidebar .btn-arrow {
    width: 36px;
    height: 36px;
    background: #FEA153;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 1024px) {
    .service-sidebar .side-cta { position: static; }
  }
</style>

</Interior>
