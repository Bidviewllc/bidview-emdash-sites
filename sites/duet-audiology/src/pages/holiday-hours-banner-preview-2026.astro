---
import Base from '../layouts/Base.astro';
---

<Base title="Holiday Hours Banner Preview | Duet Hearing" noIndex>
  <aside slot="above-header" class="duet-holiday-notice" aria-label="Holiday hours">
    <strong>Holiday closures</strong> · Nov 26–27, Dec 25 &amp; Jan 1
  </aside>
  <main class="preview">
    <h1>Holiday hours banner preview</h1>
  </main>
</Base>

<style>
  .duet-holiday-notice {
    background: #00b2e4;
    color: #21273f;
    padding: 9px 16px;
    font-size: clamp(0.875rem, 3.75vw, 1rem);
    line-height: 1.4;
    text-align: center;
  }

  :global(body:has(> .duet-holiday-notice) > .site-header) {
    position: sticky !important;
    top: 0 !important;
    background: #f3faff !important;
  }

  .preview {
    display: grid;
    place-items: center;
    min-height: 55vh;
    padding: 32px 24px;
    color: #21273f;
    text-align: center;
  }

  .preview h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.15;
  }
</style>
