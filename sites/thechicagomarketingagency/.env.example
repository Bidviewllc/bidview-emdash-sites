# Optional. Copy to .env for local dev. Do not commit real values.
# Production: wrangler secret put <NAME> --name thechicagomarketingagency
# Public ids (GA, GTM, Turnstile site key) can be [vars] instead of secrets.

# Comma-separated. The worker secret is already these three, which are also
# the send_email allowed_destination_addresses. A missing secret falls back
# to the same list.
LEAD_NOTIFY_EMAILS=cameron@bidviewmarketing.com,vince@bidviewmarketing.com,erika@bidviewmarketing.com

# Set both to turn Turnstile on. Either one alone does not block submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rendered only when the value matches G-… or GTM-…
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
