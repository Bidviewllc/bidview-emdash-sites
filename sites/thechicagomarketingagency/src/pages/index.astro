---
import Base from "../layouts/Base.astro";
import AuditForm from "../components/AuditForm.astro";
import TrustStrip from "../components/TrustStrip.astro";
import WhatNext from "../components/WhatNext.astro";
import FaqBlock from "../components/FaqBlock.astro";
import Objections from "../components/Objections.astro";
import BidviewProof from "../components/BidviewProof.astro";

export const cacheHint = 3600;

const services = [
	{ href: "/services/seo/", name: "SEO", text: "Technical fixes, the local profile, and pages that match how people in Chicago search." },
	{ href: "/services/web-design/", name: "Web design", text: "Sites that load on a phone and make the next step obvious." },
	{ href: "/services/paid-advertising/", name: "Paid advertising", text: "Search and social, with the media budget kept separate from the management." },
	{ href: "/services/content-marketing/", name: "Content", text: "Pages and articles tied to a real search, not a monthly post quota." },
	{ href: "/services/conversion-optimization/", name: "Conversion", text: "When the visits are already there and the lead is not." },
	{ href: "/services/social-media/", name: "Social", text: "A consistent presence on the platforms your customers actually use." },
	{ href: "/services/video-production/", name: "Video", text: "Films and cutdowns for the site, social, and ads." },
];

const industries = [
	{ href: "/industries/construction/", name: "Construction" },
	{ href: "/industries/law-firms/", name: "Law firms" },
	{ href: "/industries/dentists/", name: "Dentists" },
	{ href: "/industries/healthcare/", name: "Healthcare" },
	{ href: "/industries/hvac/", name: "HVAC" },
	{ href: "/industries/home-services/", name: "Home services" },
	{ href: "/industries/restaurants/", name: "Restaurants" },
	{ href: "/industries/real-estate/", name: "Real estate" },
	{ href: "/industries/ecommerce/", name: "E-commerce" },
	{ href: "/industries/financial-services/", name: "Financial services" },
	{ href: "/industries/fitness/", name: "Fitness" },
	{ href: "/industries/auto-dealers/", name: "Auto dealers" },
];

const areas = [
	["lincoln-park", "Lincoln Park"],
	["wicker-park", "Wicker Park"],
	["logan-square", "Logan Square"],
	["river-north", "River North"],
	["the-loop", "The Loop"],
	["west-loop", "West Loop"],
	["lakeview", "Lakeview"],
	["hyde-park", "Hyde Park"],
	["pilsen", "Pilsen"],
	["andersonville", "Andersonville"],
];

const faqs = [
	{
		q: "What do I get from the free marketing audit?",
		a: "You send your name, email, and website. Someone from Bidview Marketing looks at the site and the searches that should be bringing you work, then replies within one business day with what to fix first. There is no charge and no storefront visit.",
	},
	{
		q: "Are those percentages a promise for my company?",
		a: "No. They are published client results, linked from the results page. They are not a forecast for your company.",
	},
	{
		q: "Do you work outside the city?",
		a: "Yes. Neighborhood hubs cover Chicago. Suburb pages are separate, for the towns this brand sells. The audit says which of those match how you actually work.",
	},
	{
		q: "How do you charge?",
		a: "There is no public rate card. After the audit, if the work is a fit, you get a written scope. If ads are part of it, the media budget is paid to the ad platform and kept separate from management.",
	},
];
---

<Base
	title="Digital Marketing for Chicago Businesses"
	description="SEO, websites, and ads for Chicago businesses and the suburbs. Request a free marketing audit."
	cro="quiet"
>
	<section class="home-hero">
		<div class="container home-hero-grid">
			<div class="home-hero-copy">
				<p class="eyebrow">Chicago and the suburbs</p>
				<h1>Marketing for Chicago businesses that need leads</h1>
				<p class="lede">
					SEO, websites, and ads for businesses that want more of the right leads.
					The free audit is how it starts.
				</p>
				<p class="hero-links">
					<a href="/results/">See the published results</a>
					<a href="/services/seo/">Chicago SEO services</a>
				</p>
			</div>
			<AuditForm />
		</div>
	</section>

	<TrustStrip />
	<WhatNext />

	<section class="home-services">
		<div class="container">
			<p class="eyebrow">Services</p>
			<h2>One primary offer. The channels behind it.</h2>
			<p class="section-intro">Every page on this site points at the same next step: the free audit. These are the kinds of work that audit can turn into a scope.</p>
			<ul class="service-list">
				{services.map((service, i) => (
					<li>
						<a href={service.href}>
							<span class="service-index">0{i + 1}</span>
							<span>
								<strong>{service.name}</strong>
								<span>{service.text}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<BidviewProof
		showStats={false}
		showQuotes
		quoteCount={4}
		heading="What Bidview Marketing clients have said"
	/>

	<section class="home-industries">
		<div class="container">
			<p class="eyebrow">Industries</p>
			<h2>Built around the businesses the work already fits</h2>
			<ul class="industry-list">
				{industries.map((item) => (
					<li><a href={item.href}>{item.name}</a></li>
				))}
			</ul>
		</div>
	</section>

	<section class="home-areas">
		<div class="container">
			<p class="eyebrow">Where the work shows up</p>
			<h2>Neighborhoods and suburbs, kept as real pages</h2>
			<p class="section-intro">Neighborhood hubs and suburb pages are separate. A service is not repeated as a thin URL for every town.</p>
			<ul class="area-list">
				{areas.map(([slug, name]) => (
					<li><a href={`/${slug}/`}>{name}</a></li>
				))}
			</ul>
			<p class="area-more">
				<a href="/neighborhoods/">All neighborhoods</a>
				<a href="/suburbs/">Suburbs</a>
			</p>
		</div>
	</section>

	<FaqBlock
		heading="Questions before the audit"
		faqs={faqs}
		schema
	/>
	<Objections />

	<section class="home-close">
		<div class="container home-close-inner">
			<p class="eyebrow">The only ask</p>
			<h2>Send the site. We’ll reply within one business day.</h2>
			<a href="/free-seo-audit/" class="btn btn-primary">Request my free audit</a>
		</div>
	</section>
</Base>

<style>
	.home-hero {
		background-color: var(--ink);
		background-image:
			linear-gradient(rgba(255, 252, 248, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 252, 248, 0.04) 1px, transparent 1px);
		background-size: 56px 56px;
		color: var(--paper);
		padding: 72px 0 64px;
	}
	.home-hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 48px;
		align-items: start;
	}
	.home-hero-copy { padding-top: 12px; }
	.home-hero h1 {
		font-size: clamp(2.6rem, 5vw, 4.4rem);
		line-height: 0.98;
		color: var(--paper);
		max-width: 12ch;
		margin: 8px 0 18px;
	}
	.lede {
		font-size: 1.125rem;
		line-height: 1.6;
		color: rgba(255, 252, 248, 0.78);
		max-width: 38ch;
	}
	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 22px;
		margin-top: 22px;
	}
	.hero-links a {
		color: var(--paper);
		text-decoration: underline;
		text-underline-offset: 3px;
		font-weight: 600;
	}
	.home-services, .home-industries, .home-areas { padding: 72px 0; }
	.home-services { background: var(--white); }
	.home-industries { background: var(--ink); color: var(--paper); }
	.home-areas { background: var(--sand); }
	.home-services h2, .home-areas h2, .home-industries h2 {
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		max-width: 20ch;
		margin-bottom: 12px;
	}
	.section-intro {
		color: var(--text-muted);
		max-width: 52ch;
		margin-bottom: 28px;
		line-height: 1.6;
	}
	.home-industries .section-intro, .home-industries .eyebrow { color: inherit; }
	.service-list, .industry-list, .area-list { list-style: none; }
	.service-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: 1px solid var(--border);
	}
	.service-list a {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 16px;
		padding: 22px 18px;
		border-bottom: 1px solid var(--border);
		min-height: 100%;
	}
	.service-list li:nth-child(odd) a { border-right: 1px solid var(--border); }
	.service-list a:hover { background: var(--sand); }
	.service-index {
		font-family: var(--display);
		color: var(--lake);
		font-size: 1.1rem;
	}
	.service-list strong { display: block; font-size: 1.15rem; margin-bottom: 4px; }
	.service-list span span { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }
	.industry-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 22px;
	}
	.industry-list a {
		display: inline-block;
		border: 1px solid rgba(255, 252, 248, 0.2);
		border-radius: 999px;
		padding: 10px 16px;
		color: var(--paper);
	}
	.industry-list a:hover { background: var(--brick); border-color: var(--brick); }
	.area-list { display: flex; flex-wrap: wrap; gap: 8px; }
	.area-list a, .area-more a {
		display: inline-block;
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 8px 14px;
		font-size: 0.92rem;
	}
	.area-list a:hover, .area-more a:hover { border-color: var(--lake); color: var(--lake-deep); }
	.area-more { display: flex; gap: 10px; margin-top: 18px; }
	.area-more a { font-weight: 700; }
	.home-close {
		background: var(--ink);
		color: var(--paper);
		padding: 72px 0;
	}
	.home-close-inner { max-width: 640px; }
	.home-close h2 {
		font-size: clamp(1.8rem, 3vw, 2.7rem);
		color: var(--paper);
		margin: 8px 0 20px;
	}
	@media (max-width: 860px) {
		.home-hero { padding: 40px 0 36px; }
		.home-hero-grid, .service-list { grid-template-columns: 1fr; }
		.service-list li:nth-child(odd) a { border-right: none; }
		.home-hero h1 { max-width: none; }
		.home-services, .home-industries, .home-areas, .home-close { padding: 48px 0; }
	}
</style>
