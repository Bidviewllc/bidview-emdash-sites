---
import { NEIGHBORHOOD_SLUGS } from "../../lib/proof";

const SERVICES = new Set([
	"seo",
	"web-design",
	"video-production",
	"paid-advertising",
	"content-marketing",
	"social-media",
	"conversion-optimization",
]);

const neighborhood = Astro.params.neighborhood ?? "";
const service = Astro.params.service ?? "";

if (!SERVICES.has(service) || !(NEIGHBORHOOD_SLUGS as readonly string[]).includes(neighborhood)) {
	return Astro.rewrite("/404");
}

return Astro.redirect(`/${neighborhood}/`, 301);
---
