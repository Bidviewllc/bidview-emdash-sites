---
import Base from "../layouts/Base.astro";
import BidviewProof from "../components/BidviewProof.astro";

export const cacheHint = 3600;
---

<Base
	title="Results"
	description="Published client results from Bidview Marketing, the team that delivers work for The Chicago Marketing Agency."
>
	<!-- ── HERO ── -->
	<section class="results-hero">
		<div class="container">
			<span class="eyebrow">Published results</span>
			<h1>Results from the team that does the work</h1>
			<p>The Chicago Marketing Agency does not publish a separate case-study list. The figures and quotes below are on Bidview Marketing's site, and that team delivers the work for this brand.</p>
		</div>
	</section>

	<BidviewProof showStats showQuotes quoteCount={4} heading="What Bidview Marketing publishes" />

	<!-- ── CTA ── -->
	<section class="results-cta">
		<div class="container results-cta-inner">
			<h2>Want this kind of work for your business?</h2>
			<p>Tell us about the company. We'll follow up within one business day.</p>
			<a href="/free-seo-audit/" class="btn btn-primary">Request my free audit</a>
		</div>
	</section>
</Base>

<style>
.results-hero {
	background: var(--navy);
	padding: 80px 0;
}
.results-hero h1 {
	font-size: clamp(2rem, 4vw, 2.75rem);
	color: var(--white);
	margin-bottom: 16px;
	max-width: 620px;
}
.results-hero p {
	font-size: 1.0625rem;
	color: rgba(255,255,255,0.65);
	max-width: 480px;
}

.results-stats-bar {
	background: #F0F2F5;
	border-bottom: 1px solid var(--border);
}
.results-stats-inner {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	height: 100px;
}
.results-stat {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	border-right: 1px solid var(--border);
	gap: 4px;
}
.results-stat:last-child { border-right: none; }
.rs-value {
	font-size: 1.75rem;
	font-weight: 900;
	color: var(--text-dark);
	letter-spacing: -0.03em;
}
.rs-label {
	font-size: 0.8125rem;
	color: var(--text-muted);
}

.case-studies {
	padding: 64px 0 80px;
	background: var(--white);
}
.cs-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 24px;
}
.cs-card {
	border: 1px solid var(--border);
	border-radius: var(--radius-lg);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}
.cs-card-top {
	padding: 28px 28px 0;
	flex: 1;
}
.cs-meta {
	display: flex;
	gap: 8px;
	margin-bottom: 12px;
}
.cs-industry, .cs-service {
	font-size: 0.75rem;
	font-weight: 600;
	padding: 3px 10px;
	border-radius: 20px;
}
.cs-industry {
	background: var(--off-white);
	color: var(--text-muted);
	border: 1px solid var(--border);
}
.cs-service {
	background: rgba(220,38,38,0.08);
	color: var(--red);
	border: 1px solid rgba(220,38,38,0.2);
}
.cs-client {
	font-size: 0.8125rem;
	font-weight: 600;
	color: var(--text-muted);
	margin-bottom: 6px;
}
.cs-card h2 {
	font-size: 1.125rem;
	color: var(--text-dark);
	margin-bottom: 10px;
}
.cs-excerpt {
	font-size: 0.9375rem;
	color: var(--text-muted);
	line-height: 1.6;
	margin-bottom: 24px;
}
.cs-stats {
	display: flex;
	background: var(--navy);
	padding: 20px 28px;
	gap: 32px;
}
.cs-stat {
	display: flex;
	flex-direction: column;
	gap: 4px;
}
.cs-stat-value {
	font-size: 1.5rem;
	font-weight: 900;
	color: var(--red);
	letter-spacing: -0.03em;
}
.cs-stat-label {
	font-size: 0.75rem;
	color: rgba(255,255,255,0.5);
}

.results-testimonials {
	padding: 72px 0;
	background: var(--off-white);
}
.testimonials-heading {
	font-size: clamp(1.75rem, 3vw, 2.25rem);
	text-align: center;
	margin-bottom: 48px;
}
.testimonials-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 24px;
}
.testimonial {
	background: var(--white);
	border: 1px solid var(--border);
	border-left: 3px solid var(--red);
	border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
	padding: 28px;
	margin: 0;
}
.testimonial p {
	font-size: 1rem;
	color: var(--text-dark);
	line-height: 1.7;
	margin-bottom: 20px;
	font-style: italic;
}
.testimonial footer strong {
	display: block;
	font-size: 0.9375rem;
	color: var(--text-dark);
	margin-bottom: 2px;
}
.testimonial footer span {
	font-size: 0.8125rem;
	color: var(--text-muted);
}

.results-cta {
	background: var(--navy);
	padding: 80px 0;
}
.results-cta-inner {
	text-align: center;
	max-width: 540px;
	margin: 0 auto;
}
.results-cta-inner h2 {
	font-size: clamp(1.75rem, 3vw, 2.25rem);
	color: var(--white);
	margin-bottom: 12px;
}
.results-cta-inner p {
	color: rgba(255,255,255,0.65);
	margin-bottom: 28px;
}

@media (max-width: 768px) {
	.results-stats-inner { grid-template-columns: repeat(2, 1fr); height: auto; padding: 24px 0; }
	.results-stat { padding: 16px 0; }
	.cs-grid { grid-template-columns: 1fr; }
	.testimonials-grid { grid-template-columns: 1fr; }
	.map-layout { grid-template-columns: 1fr; }
}
</style>
