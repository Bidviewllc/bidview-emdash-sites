---
import Base from "../layouts/Base.astro";
import SpamFields from "../components/SpamFields.astro";
import LeadEvent from "../components/LeadEvent.astro";
import ThankYou from "../components/ThankYou.astro";
import WhatNext from "../components/WhatNext.astro";
import { handleLead, trackingIds, turnstileSiteKey, type LeadStatus } from "../lib/leads";

export const cacheHint = 0;

const turnstileKey = turnstileSiteKey();
const tracking = trackingIds();
let formStatus: LeadStatus | "idle" = "idle";
let formMessage = "";
let trackLead = false;

if (Astro.request.method === "POST") {
	const result = await handleLead(Astro.request, "contact");
	formStatus = result.status;
	formMessage = result.message;
	trackLead = result.track;
}

const services = [
	"SEO Services",
	"Web Design",
	"Video Production",
	"Paid Advertising",
	"Content Marketing",
	"Social Media Management",
	"Conversion Optimization",
	"Full-Service Retainer",
];
---

<Base
	title="Contact Us"
	description="Send a message or request the free marketing audit. We respond within one business day."
	cro="quiet"
>
	<!-- ── HERO ── -->
	<section class="contact-hero">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span>/</span>
				<span>Contact</span>
			</nav>
			<span class="eyebrow">Get in Touch</span>
			<h1>Tell us about the business</h1>
			<p>Send a message, or use the free audit if you already have a site to look at. We respond within one business day.</p>
		</div>
	</section>

	<!-- ── FORM + OFFICE ── -->
	<section class="contact-section">
		<div class="container contact-grid">
			<!-- Form -->
			<div class="contact-form-col">
				<h2>Send Us a Message</h2>
				{formStatus === "success" || formStatus === "saved" ? (
					<>
						<ThankYou
							title={formStatus === "saved" ? "Message saved" : "Message received"}
							message={formMessage}
							saved={formStatus === "saved"}
						/>
						{trackLead && <LeadEvent formType="contact" ga={tracking.ga} gtm={tracking.gtm} />}
					</>
				) : (
					<form id="lead-form" method="POST" class="contact-form">
						{formStatus === "error" && (
							<div class="form-error">{formMessage}</div>
						)}

						<div class="form-row">
							<div class="form-field">
								<label for="firstName">First Name <span>*</span></label>
								<input type="text" id="firstName" name="firstName" placeholder="John" required autocomplete="given-name" />
							</div>
							<div class="form-field">
								<label for="lastName">Last Name</label>
								<input type="text" id="lastName" name="lastName" placeholder="Smith" autocomplete="family-name" />
							</div>
						</div>

						<div class="form-field">
							<label for="email">Business Email <span>*</span></label>
							<input type="email" id="email" name="email" placeholder="john@yourcompany.com" required autocomplete="email" />
						</div>

						<div class="form-field">
							<label for="phone">Phone Number</label>
							<input type="tel" id="phone" name="phone" placeholder="(312) 555-0000" autocomplete="tel" />
						</div>

						<div class="form-field">
							<label for="service">Service You're Interested In</label>
							<select id="service" name="service">
								<option value="" disabled selected>SEO, Web Design, Paid Ads...</option>
								{services.map((s) => (
									<option value={s}>{s}</option>
								))}
							</select>
						</div>

						<div class="form-field">
							<label for="message">Tell Us About Your Business <span>*</span></label>
							<textarea id="message" name="message" rows="5" placeholder="Share your goals, challenges, and what you're trying to achieve..." required></textarea>
						</div>

						<SpamFields turnstileSiteKey={turnstileKey} />
						<button type="submit" class="btn btn-primary">Send Message →</button>
					</form>
				)}
			</div>

			<div class="contact-office">
				<h2>Chicago and the suburbs</h2>
				<p class="office-lead">We don't publish a Chicago storefront. The Chicago Marketing Agency serves businesses in the city and the surrounding suburbs. The work is done by the team at <a href="https://www.bidviewmarketing.com/">Bidview Marketing</a> in the Libertyville and Chicago area.</p>
				<div class="office-details">
					<div class="office-item">
						<span class="office-icon">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
						</span>
						<a href="mailto:hello@thechicagomarketingagency.com">hello@thechicagomarketingagency.com</a>
					</div>
				</div>

				<div class="office-hours">
					<h4>Hours</h4>
					<p>Monday – Friday: 9am – 6pm CST</p>
					<p>Weekend: Closed (emails answered Monday)</p>
				</div>
			</div>
		</div>
	</section>
	<WhatNext />
</Base>

<style>
/* ── HERO ── */
.contact-hero {
	background: var(--navy);
	padding: 64px 0;
}

.breadcrumb {
	display: flex;
	align-items: center;
	gap: 8px;
	font-size: 0.8125rem;
	color: rgba(255,255,255,0.45);
	margin-bottom: 20px;
}

.breadcrumb a {
	color: rgba(255,255,255,0.45);
	transition: color var(--transition);
}

.breadcrumb a:hover { color: rgba(255,255,255,0.7); }
.breadcrumb span:last-child { color: rgba(255,255,255,0.65); }

.contact-hero h1 {
	font-size: clamp(2rem, 4vw, 2.75rem);
	color: var(--white);
	margin-bottom: 16px;
	max-width: 580px;
}

.contact-hero p {
	font-size: 1.0625rem;
	color: rgba(255,255,255,0.65);
	max-width: 480px;
}

/* ── SECTION ── */
.contact-section {
	padding: 64px 0 80px;
	background: var(--white);
}

.contact-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 80px;
	align-items: start;
}

/* ── FORM ── */
.contact-form-col h2,
.office-lead {
	color: var(--text-muted);
	margin: 12px 0 20px;
	line-height: 1.6;
}
.office-lead a { color: var(--red); text-decoration: underline; }

.contact-office h2 {
	font-size: 1.5rem;
	color: var(--text-dark);
	margin-bottom: 28px;
}

.contact-form {
	display: flex;
	flex-direction: column;
	gap: 20px;
}

.form-row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 16px;
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 6px;
}

.form-field label {
	font-size: 0.875rem;
	font-weight: 500;
	color: var(--text-dark);
}

.form-field label span {
	color: var(--red);
}

.form-field input,
.form-field select,
.form-field textarea {
	font-family: var(--font);
	font-size: 0.9375rem;
	color: var(--text-dark);
	background: var(--white);
	border: 1px solid var(--border);
	border-radius: var(--radius);
	padding: 11px 14px;
	min-height: 44px;
	transition: border-color var(--transition), box-shadow var(--transition);
	width: 100%;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
	outline: none;
	border-color: var(--red);
	box-shadow: 0 0 0 3px rgba(220,38,38,0.1);
}

.form-field input::placeholder,
.form-field textarea::placeholder {
	color: var(--text-light);
}

.form-field select {
	appearance: none;
	background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 7L11 1' stroke='%2364748b' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
	background-repeat: no-repeat;
	background-position: right 14px center;
	padding-right: 40px;
	cursor: pointer;
}

.form-field textarea { resize: vertical; min-height: 120px; }

.form-error {
	padding: 12px 16px;
	background: rgba(220,38,38,0.08);
	border: 1px solid rgba(220,38,38,0.25);
	border-radius: var(--radius);
	color: var(--red);
	font-size: 0.875rem;
}

.form-success {
	text-align: center;
	padding: 40px 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 16px;
}

.success-icon {
	width: 56px;
	height: 56px;
	background: #16a34a;
	color: var(--white);
	font-size: 1.5rem;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.form-success h3 {
	font-size: 1.5rem;
	color: var(--text-dark);
}

.form-success p {
	color: var(--text-muted);
}

/* ── OFFICE ── */
.office-image img {
	width: 100%;
	height: 240px;
	object-fit: cover;
	border-radius: var(--radius-lg);
	margin-bottom: 28px;
}

.office-details {
	display: flex;
	flex-direction: column;
	gap: 16px;
	margin-bottom: 28px;
}

.office-item {
	display: flex;
	align-items: flex-start;
	gap: 12px;
}

.office-icon {
	width: 32px;
	height: 32px;
	background: var(--off-white);
	border: 1px solid var(--border);
	border-radius: var(--radius);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--red);
	flex-shrink: 0;
}

.office-item div,
.office-item a {
	font-size: 0.9375rem;
	color: var(--text-dark);
	line-height: 1.5;
	overflow-wrap: break-word;
	word-break: break-all;
}

.office-item div {
	display: flex;
	flex-direction: column;
}

.office-item a:hover { color: var(--red); }

.office-hours {
	padding: 20px;
	background: var(--off-white);
	border-radius: var(--radius-lg);
}

.office-hours h4 {
	font-size: 0.8125rem;
	font-weight: 700;
	color: var(--text-dark);
	margin-bottom: 8px;
	letter-spacing: 0.04em;
	text-transform: uppercase;
}

.office-hours p {
	font-size: 0.875rem;
	color: var(--text-muted);
	line-height: 1.6;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
	.contact-grid { grid-template-columns: 1fr; gap: 48px; }
	.form-row { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
	.office-image img { height: 180px; }
}
</style>
