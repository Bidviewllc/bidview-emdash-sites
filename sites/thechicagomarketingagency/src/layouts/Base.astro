				border-top: 3px solid var(--lake);
			}

			.header-inner {
				display: flex;
				align-items: center;
				gap: 40px;
				height: 72px;
			}

			.logo {
				display: flex;
				align-items: center;
				gap: 10px;
				flex-shrink: 0;
				text-decoration: none;
			}

			.logo-icon {
				width: 36px;
				height: 36px;
				background: var(--ink);
				color: var(--paper);
				font-size: 1.15rem;
				font-weight: 560;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 4px;
				flex-shrink: 0;
				font-family: var(--display);
			}

			.logo-text {
				display: flex;
				flex-direction: column;
				line-height: 1.25;
			}

			.logo-l1 {
				font-size: 0.8125rem;
				font-weight: 700;
				color: var(--text-dark);
				letter-spacing: -0.01em;
			}

			.logo-l2 {
				font-size: 0.6875rem;
				font-weight: 500;
				color: var(--text-muted);
			}

			.logo-inv .logo-l1,
			.logo-inv .logo-l2 {
				color: var(--white);
			}
			.logo-inv .logo-icon {
				background: var(--brick);
				color: var(--paper);
			}

			.primary-nav {
				display: flex;
				align-items: center;
				gap: 4px;
				margin-left: auto;
			}

			.nav-link {
				font-size: 0.9375rem;
				font-weight: 500;
				color: var(--text-muted);
				padding: 6px 14px;
				border-radius: 6px;
				transition: color var(--transition);
			}

			.nav-link:hover { color: var(--text-dark); }
			.nav-chevron {
				display: inline-block;
				width: 0.4rem;
				height: 0.4rem;
				margin-left: 6px;
				border-right: 1.5px solid currentColor;
				border-bottom: 1.5px solid currentColor;
				transform: rotate(45deg) translateY(-2px);
				transition: transform 150ms ease;
			}

			/* ── DROPDOWNS ── */
			.nav-dropdown { position: relative; }
			.nav-dropdown:hover .dropdown-panel { opacity: 1; visibility: visible; transform: translateY(0); }
			.nav-dropdown:hover .nav-chevron,
			.nav-dropdown:focus-within .nav-chevron { transform: rotate(225deg) translateY(-1px); }
			.nav-dropdown:focus-within .dropdown-panel { opacity: 1; visibility: visible; transform: translateY(0); }
			.nav-dropdown-mega:focus-within .mega-panel { transform: translateX(-50%) translateY(0); }

			.dropdown-panel {
				position: absolute;
				top: 100%;
				left: 0;
				min-width: 220px;
				background: var(--white);
				border: 1px solid var(--border);
				border-radius: 10px;
				box-shadow: 0 12px 32px rgba(0,0,0,0.1);
				padding: 8px;
				opacity: 0;
				visibility: hidden;
				transform: translateY(8px);
				transition: all 150ms ease;
				z-index: 200;
			}

			/* ── MEGA MENU ── */
			.nav-dropdown-mega { position: static; }
			.mega-panel {
				left: 50%;
				transform: translateX(-50%) translateY(8px);
				min-width: 680px;
				padding: 0;
			}
			.nav-dropdown-mega:hover .mega-panel {
				transform: translateX(-50%) translateY(0);
			}
			.mega-inner {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr 200px;
				gap: 0;
			}
			.mega-col {
				padding: 20px 16px;
				border-right: 1px solid var(--border);
			}
			.mega-col:last-of-type { border-right: none; }
			.mega-label {
				display: block;
				font-size: 0.6875rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--text-light);
				padding: 0 14px 8px;
				margin-bottom: 4px;
			}
			.mega-cta {
				padding: 24px 20px;
				background: var(--off-white);
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 16px;
				border-radius: 0 10px 10px 0;
			}
			.mega-cta-text {
				font-size: 0.8125rem;
				color: var(--text-muted);
				line-height: 1.5;
			}
			.mega-btn {
				font-size: 0.8125rem;
				padding: 10px 16px;
				text-align: center;
				justify-content: center;
			}

			.dropdown-item {
				display: block;
				padding: 10px 14px;
				font-size: 0.875rem;
				font-weight: 500;
				color: var(--text-muted);
				border-radius: 6px;
				transition: all 100ms ease;
			}
			.dropdown-item:hover {
				background: var(--off-white);
				color: var(--text-dark);
			}
			.dropdown-all {
				color: var(--red);
				font-weight: 600;
				border-top: 1px solid var(--border);
				margin-top: 4px;
				padding-top: 12px;
				border-radius: 0;
			}

			.header-cta { padding: 12px 20px; font-size: 0.875rem; min-height: 44px; }

			.mobile-btn {
				display: none;
				flex-direction: column;
				gap: 5px;
				background: none;
				border: none;
				cursor: pointer;
				padding: 10px;
				margin-left: auto;
				min-width: 44px;
				min-height: 44px;
				align-items: center;
				justify-content: center;
			}

			.mobile-btn span {
				display: block;
				width: 24px;
				height: 2px;
				background: var(--text-dark);
				border-radius: 2px;
				transition: all var(--transition);
			}

			/* ── FOOTER ── */
			.site-footer {
				background: var(--ink);
				color: var(--paper);
				padding: 0;
				content-visibility: auto;
				contain-intrinsic-size: auto 520px;
			}
			.layout-close-band {
				background: var(--ink);
				color: var(--paper);
				padding: 28px 0 36px;
			}
			.layout-close-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 24px;
			}
			.layout-close-band h2 {
				color: var(--paper);
				font-size: clamp(1.5rem, 3vw, 2rem);
				max-width: 22ch;
				margin-bottom: 8px;
			}
			.layout-close-band p { color: rgba(251, 248, 243, 0.72); max-width: 52ch; }
			.sticky-cta {
				display: none;
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
				gap: 32px;
				padding: 60px 0 48px;
				border-bottom: 1px solid rgba(255,255,255,0.07);
			}

			.footer-tagline {
				font-size: 0.875rem;
				color: var(--text-light);
				line-height: 1.7;
				margin-top: 16px;
				max-width: 320px;
			}

			.footer-backing {
				margin-top: 16px;
				font-size: 0.875rem;
			}

			.footer-backing a {
				color: var(--white);
				text-decoration: underline;
			}

			.footer-social {
				display: flex;
				gap: 10px;
				margin-top: 24px;
			}

			.footer-social a {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				border: 1px solid var(--border-dark);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text-light);
				transition: all var(--transition);
			}

			.footer-social a:hover {
				border-color: var(--red);
				color: var(--red);
			}

			.footer-col h4 {
				font-size: 0.75rem;
				font-weight: 700;
				color: #ffffff;
				margin-bottom: 20px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.footer-col a,
			.footer-col address span {
				display: block;
				font-size: 0.875rem;
				color: var(--text-light);
				padding: 4px 0;
				transition: color var(--transition);
				font-style: normal;
				line-height: 1.6;
				text-decoration: none;
			}

			.footer-col a:hover { color: var(--white); }

			.footer-col address {
				display: flex;
				flex-direction: column;
				gap: 8px;
				font-style: normal;
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 20px 0 32px;
				font-size: 0.8125rem;
				color: var(--text-light);
			}

			.footer-legal {
				display: flex;
				gap: 24px;
			}

			.footer-legal a {
				color: var(--text-light);
				transition: color var(--transition);
				font-size: 0.8125rem;
			}

			.footer-legal a:hover { color: var(--white); }

			/* ── RESPONSIVE ── */
			@media (max-width: 1024px) {
				.footer-grid {
					grid-template-columns: 1fr 1fr;
				}
				.footer-brand { grid-column: 1 / -1; }
			}

			@media (max-width: 768px) {
				.primary-nav { display: none; }
				.header-cta { display: none; }
				.mobile-btn { display: flex; }
				body { padding-bottom: calc(72px + env(safe-area-inset-bottom)); }
				.sticky-cta {
					display: flex;
					position: fixed;
					left: 12px;
					right: 12px;
					bottom: calc(10px + env(safe-area-inset-bottom));
					z-index: 90;
					align-items: center;
					justify-content: center;
					min-height: 48px;
					background: var(--brick);
					color: var(--paper);
					font-weight: 700;
					border-radius: 999px;
					box-shadow: 0 10px 30px rgba(16, 32, 41, 0.28);
				}
				body:has(#mobile-menu.is-open) .sticky-cta,
				.sticky-cta.is-hidden { display: none; }
				.layout-close-inner { flex-direction: column; align-items: flex-start; }

				.footer-grid {
					grid-template-columns: 1fr 1fr;
					gap: 32px;
				}

				.footer-bottom {
					flex-direction: column;
					gap: 12px;
					text-align: center;
				}
			}

			@media (max-width: 480px) {
				.footer-grid { grid-template-columns: 1fr; }
				.mobile-menu-inner { padding: 24px 20px 40px; }
				.mobile-nav-link { font-size: 1.125rem; padding: 15px 0; }
			}

			/* ── MOBILE MENU ── */
			.mobile-menu {
				position: fixed;
				top: 72px;
				left: 0;
				right: 0;
				bottom: 0;
				background: var(--white);
				z-index: 99;
				transform: translateX(100%);
				transition: transform 280ms ease;
				overflow-y: auto;
			}

			.mobile-menu.is-open {
				transform: translateX(0);
			}

			.mobile-menu-inner {
				padding: 32px 24px 48px;
				display: flex;
				flex-direction: column;
				gap: 32px;
			}

			.mobile-nav {
				display: flex;
				flex-direction: column;
			}

			.mobile-nav-link {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-dark);
				padding: 18px 0;
				border-bottom: 1px solid var(--border);
				letter-spacing: -0.01em;
				transition: color var(--transition);
			}

			.mobile-nav-link:first-child {
				border-top: 1px solid var(--border);
			}

			.mobile-nav-link:hover { color: var(--red); }

			.mobile-accordion { border-bottom: 1px solid var(--border); }
			.mobile-accordion summary { list-style: none; cursor: pointer; }
			.mobile-accordion summary::-webkit-details-marker { display: none; }
			.mobile-accordion summary::after { content: "+"; float: right; font-size: 1.25rem; color: var(--text-muted); transition: transform 150ms ease; }
			.mobile-accordion[open] summary::after { transform: rotate(45deg); }
			.mobile-accordion .mobile-nav-link { border-bottom: none; }
			.mobile-sub { display: flex; flex-direction: column; padding: 0 0 16px 16px; }
			.mobile-sub a { font-size: 1rem; font-weight: 500; color: var(--text-muted); padding: 10px 0; }
			.mobile-sub a:hover { color: var(--red); }

			.mobile-cta {
				width: 100%;
				justify-content: center;
				font-size: 1rem;
				padding: 16px;
			}

			.mobile-overlay {
				display: none;
				position: fixed;
				inset: 0;
				background: rgba(0,0,0,0.4);
				z-index: 98;
			}

			.mobile-overlay.is-open { display: block; }

			/* hamburger → X animation */
			.mobile-btn.is-open span:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}
			.mobile-btn.is-open span:nth-child(2) {
				opacity: 0;
				transform: scaleX(0);
			}
			.mobile-btn.is-open span:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}
		</style>

		<script>
			const toggle = document.getElementById('mobile-toggle');
			const menu = document.getElementById('mobile-menu');
			const overlay = document.getElementById('mobile-overlay');

			function openMenu() {
				menu?.classList.add('is-open');
				overlay?.classList.add('is-open');
				toggle?.classList.add('is-open');
				toggle?.setAttribute('aria-expanded', 'true');
				document.body.style.overflow = 'hidden';
			}

			function closeMenu() {
				menu?.classList.remove('is-open');
				overlay?.classList.remove('is-open');
				toggle?.classList.remove('is-open');
				toggle?.setAttribute('aria-expanded', 'false');
				document.body.style.overflow = '';
			}

			toggle?.addEventListener('click', () => {
				menu?.classList.contains('is-open') ? closeMenu() : openMenu();
			});

			const leadForm = document.getElementById('lead-form');
			const sticky = document.querySelector('.sticky-cta');
			if (leadForm && sticky) {
				sticky.setAttribute('href', '#lead-form');
				if ('IntersectionObserver' in window) {
					const observer = new IntersectionObserver((entries) => {
						sticky.classList.toggle('is-hidden', entries.some((entry) => entry.isIntersecting));
					}, { threshold: 0.2 });
					observer.observe(leadForm);
				}
			}

			overlay?.addEventListener('click', closeMenu);

			// Close on nav link click
			menu?.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', closeMenu);
			});
		</script>
	</body>
</html>
