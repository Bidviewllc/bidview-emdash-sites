---
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { trackingIds } from "../lib/leads";
import { AUDIT_PROMISE } from "../lib/offer";
import WhatNext from "../components/WhatNext.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	geoNeighborhood?: string;
	/** quiet skips the shared closing audit band. Sticky mobile CTA stays. */
	cro?: "quiet" | "band";
}

const { title, description, image, geoNeighborhood, cro = "band" } = Astro.props;

const BRAND = "The Chicago Marketing Agency";
function withBrand(raw?: string) {
	if (!raw) return `${BRAND} | SEO, Web Design & Digital Marketing in Chicago`;
	let text = raw.trim();
	const suffixes = [` — ${BRAND}`, ` – ${BRAND}`, ` - ${BRAND}`, ` | ${BRAND}`];
	let changed = true;
	while (changed) {
		changed = false;
		for (const suffix of suffixes) {
			if (text.toLowerCase().endsWith(suffix.toLowerCase())) {
				text = text.slice(0, -suffix.length).trim();
				changed = true;
			}
		}
	}
	if (!text || text.toLowerCase() === BRAND.toLowerCase()) {
		return `${BRAND} | SEO, Web Design & Digital Marketing in Chicago`;
	}
	return `${text} — ${BRAND}`;
}

const fullTitle = withBrand(title);
const siteDescription =
	description ||
	"Digital marketing for Chicago businesses and the suburbs. Strategy, SEO, websites, and ads.";
const ogImage = image || "https://thechicagomarketingagency.com/og.png";
const noindexHost = Astro.url.hostname.endsWith(".workers.dev");
const { ga, gtm } = trackingIds();

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isFormPage = path === "/contact" || path === "/free-seo-audit" || path === "/subscribe";
const croQuiet = cro === "quiet" || path === "/privacy-policy" || path === "/terms";
const stickyHref = path === "/free-seo-audit" || path === "/contact" ? "#lead-form" : "/free-seo-audit/";
if (!isFormPage) {
	Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
}

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	description: siteDescription,
	canonical: `https://thechicagomarketingagency.com${Astro.url.pathname}`,
	image: ogImage,
	seo: { ogImage },
	siteName: BRAND,
});
---

