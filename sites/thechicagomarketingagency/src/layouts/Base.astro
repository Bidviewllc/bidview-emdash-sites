				--lake-deep: #0a5258;
				--brick: #c4492a;
				--brick-deep: #9a341c;
				--sand: #f3eee6;
				--paper: #fbf8f3;
				--line: #e3dacb;
				--gold: #a9783a;
				--red: var(--brick);
