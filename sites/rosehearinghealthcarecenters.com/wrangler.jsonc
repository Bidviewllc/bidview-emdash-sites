{
  "send_email": [{ "name": "SEND_EMAIL", "destination_address": "leads@proheargroup.com" }],
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rosehearinghealthcarecenters-staging",
	"account_id": "239e9d015c7a3a39cdc2e9400312f553",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rosehearinghealthcarecenters-staging-db",
			"database_id": "bb250e15-1c27-499c-ba8e-287b2946c172",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rosehearinghealthcarecenters-staging-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "028dfa4da881449cb1fcfb8ae46b6e2e",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
