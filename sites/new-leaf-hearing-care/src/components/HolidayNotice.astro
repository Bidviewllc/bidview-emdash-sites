---
const expiresAt = Date.parse("2026-12-26T07:00:00Z");
---

{Date.now() < expiresAt && (
  <aside class="seasonal-holiday-notice" aria-label="Holiday office hours">
    <strong>Holiday hours:</strong>
    Arvada and Littleton are closed Nov 26–27 and Dec 24–25.
  </aside>
)}

<style>
  .seasonal-holiday-notice {
    padding: 9px 16px;
    background: var(--primary-light);
    color: var(--secondary);
    text-align: center;
    font-size: 1rem;
    line-height: 1.4;
  }
  :global(body:has(> .seasonal-holiday-notice) > .site-header) {
    position: sticky;
  }
</style>
