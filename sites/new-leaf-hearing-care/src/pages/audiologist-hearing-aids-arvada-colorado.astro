---
import Base from "../layouts/Base.astro";
import { getPublishedTeamMembers, replaceTeamSections } from "../utils/teamMembers";
import pageHtml from "../content-shells/static/audiologist-hearing-aids-arvada-colorado.html?raw";
export const cacheHint = 3600;

const teamMembers = await getPublishedTeamMembers();
const hydratedPageHtml = replaceTeamSections(pageHtml, teamMembers);
---
<Base title="Arvada Audiologist & Hearing Aids | New Leaf Hearing Care" description="New Leaf Hearing Care provides expert hearing care and hearing aids in Arvada, CO.">
  <Fragment set:html={hydratedPageHtml} />
</Base>
