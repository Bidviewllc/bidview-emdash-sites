{
  "name": "gcm-homes",
  "main": "worker.js",
  "account_id": "239e9d015c7a3a39cdc2e9400312f553",
  "compatibility_date": "2026-03-29",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gcm-homes-db",
      "database_id": "614044b7-3e0c-41ee-ac78-7805cbab6d99"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Worker owns all routing; don't let the asset server rewrite/redirect
    // (its default auto-trailing-slash turns /index.html → / and loops).
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
