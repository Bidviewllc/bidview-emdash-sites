{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    { "path": "/api/sync", "schedule": "0 15 * * *" }
  ],
  "redirects": [
    { "source": "/listings", "destination": "/listings/", "permanent": true },
    { "source": "/buyers", "destination": "/buyers/", "permanent": true },
    { "source": "/sellers", "destination": "/sellers/", "permanent": true },
    { "source": "/community", "destination": "/community/", "permanent": true },
    { "source": "/concierge", "destination": "/concierge/", "permanent": true },
    { "source": "/about", "destination": "/about/", "permanent": true },
    { "source": "/contact", "destination": "/contact/", "permanent": true },
    { "source": "/neighborhood/:slug", "destination": "/neighborhood/:slug/", "permanent": true },
    { "source": "/homes/:city/:address", "destination": "/homes/:city/:address/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/listing-by-slug/:city/:address",
      "destination": "/api/listing-by-slug?slug=:city/:address"
    },

    { "source": "/homes/:city/:address/", "destination": "/listing" },

    { "source": "/buyers/", "destination": "/" },
    { "source": "/sellers/", "destination": "/" },
    { "source": "/community/", "destination": "/" },
    { "source": "/concierge/", "destination": "/" },
    { "source": "/about/", "destination": "/" },
    { "source": "/contact/", "destination": "/" },
    { "source": "/neighborhood/:slug/", "destination": "/" }
  ]
}
