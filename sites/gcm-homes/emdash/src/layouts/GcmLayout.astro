---
// Grant C. Meyer Homes — site layout (ports the prototype chrome into the emdash
// app). Uses the real nav/footer/logo/fonts + styles.css, and includes the
// EmDash head/body components so inline editing lights up when logged in.
import { getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";

interface Props {
	title: string;
	description?: string | null;
	canonical?: string | null;
	image?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}
const { title, description, canonical, image, content } = Astro.props;
await getSiteSettings();

const nav = [
	["Listings", "/listings/"],
	["Buyers", "/buyers/"],
	["Sellers", "/sellers/"],
	["The Community", "/community/"],
	["Concierge", "/concierge/"],
	["About", "/about/"],
];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title,
	pageTitle: title,
	description,
	canonical,
	image,
	content,
	siteName: "Grant C. Meyer Homes",
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500;1,8..60,600&family=Noto+Serif:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/styles.css" />
		<!-- Responsive overlay — must load AFTER styles.css. Desktop (>=1025px) untouched. -->
		<link rel="stylesheet" href="/responsive.css" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="nav">
			<div class="nav__inner">
				<a class="nav__logo" href="/"><img src="/assets/logo.png" alt="Grant C. Meyer Homes" /></a>
				<nav class="nav__links">
					{nav.map(([label, href]) => <a class="nav__link" href={href}>{label}</a>)}
				</nav>
				<a class="btn btn--orange nav__cta" href="/contact/">INQUIRE NOW</a>

				<!-- Hamburger — CSS shows it only at <=1024px -->
				<button class="nav__hamburger" id="navHamburger" aria-label="Open menu" aria-expanded="false" aria-controls="navDrawer">
					<span></span><span></span><span></span>
				</button>
			</div>
		</header>

		<!-- Mobile drawer — slides in from the right, hidden above 1024px.
		     MUST be a sibling of <header class="nav">, not a child of it: `.nav` has a
		     backdrop-filter, and a filtered ancestor becomes the containing block for
		     its position:fixed descendants. Nested, the drawer was trapped inside the
		     64px nav bar instead of filling the viewport. -->
		<div class="nav__drawer" id="navDrawer" aria-hidden="true">
			<div class="nav__drawer__scrim" data-drawer-close></div>
			<aside class="nav__drawer__panel" role="dialog" aria-modal="true" aria-label="Site menu">
				<div class="nav__drawer__head">
					<a class="nav__drawer__logo" href="/"><img src="/assets/logo-white.png" alt="Grant C. Meyer Homes" /></a>
					<button class="nav__drawer__close" aria-label="Close menu" data-drawer-close>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
						</svg>
					</button>
				</div>
				<nav class="nav__drawer__links">
					{nav.map(([label, href]) => (
						<a class="nav__drawer__link" href={href}>
							<span>{label}</span>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
							</svg>
						</a>
					))}
				</nav>
				<div class="nav__drawer__foot">
					<a class="btn btn--orange nav__drawer__cta" href="/contact/">INQUIRE NOW</a>
				</div>
			</aside>
		</div>

		<script is:inline>
			(function () {
				var burger = document.getElementById("navHamburger");
				var drawer = document.getElementById("navDrawer");
				if (!burger || !drawer) return;

				function setOpen(open) {
					burger.classList.toggle("is-open", open);
					drawer.classList.toggle("is-open", open);
					burger.setAttribute("aria-expanded", open ? "true" : "false");
					burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
					drawer.setAttribute("aria-hidden", open ? "false" : "true");
					// Lock page scroll behind the drawer
					document.body.style.overflow = open ? "hidden" : "";
				}

				burger.addEventListener("click", function () {
					setOpen(!drawer.classList.contains("is-open"));
				});

				drawer.querySelectorAll("[data-drawer-close]").forEach(function (el) {
					el.addEventListener("click", function () { setOpen(false); });
				});

				document.addEventListener("keydown", function (e) {
					if (e.key === "Escape" && drawer.classList.contains("is-open")) setOpen(false);
				});

				// If the window is resized up to desktop while open, reset state
				window.addEventListener("resize", function () {
					if (window.innerWidth > 1024 && drawer.classList.contains("is-open")) setOpen(false);
				});
			})();
		</script>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="footer__cols">
				<div class="footer__brand">
					<img src="/assets/logo-white.png" alt="Grant C. Meyer Homes" style="height:100px" />
					<p style="font-size:14px;line-height:1.6;color:rgba(255,255,255,0.7);margin-bottom:24px;max-width:280px">
						Three decades of expertise in Lake Tahoe luxury real estate. Curated representation, quiet sales, lasting relationships.
					</p>
				</div>
				<div>
					<h4 class="footer__h">Properties</h4>
					<div class="footer__links">
						<a href="/listings/">Search Listings</a>
						<a href="/buyers/">For Buyers</a>
						<a href="/sellers/">For Sellers</a>
					</div>
				</div>
				<div>
					<h4 class="footer__h">Tahoe</h4>
					<div class="footer__links">
						<a href="/community/">The Community</a>
						<a href="/concierge/">Concierge</a>
					</div>
				</div>
				<div>
					<h4 class="footer__h">About</h4>
					<div class="footer__links">
						<a href="/about/">About Grant</a>
						<a href="/contact/">Contact</a>
					</div>
				</div>
			</div>
			<div class="footer__bottom">
				<span style="font-size:12px;line-height:1.6;color:rgba(255,255,255,0.45);max-width:640px">
					Listing data via Trestle (Cotality), courtesy of Incline Village Realtors®. Information is deemed reliable but not guaranteed and should be independently verified.
				</span>
				<span>© 2026 Grant C. Meyer Homes.</span>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
