---
// The Market Insights archive body — used by /posts/, /posts/page/<n>/ and
// /category/<slug>/ so all three stay identical. Styles in /blog.css.
//
// Layout (approved design, 2026-09-23): navy hero → category filter + search
// → "Latest Articles" grid of .card--post → pagination → the shared
// ContactCta on the same beige as the grid, so the two read as one block.
import ContactCta from "./ContactCta.astro";
import PostCardC from "./PostCard.astro";
import type { Category, PostCard } from "../lib/posts";

interface Props {
	posts: PostCard[];
	total: number;
	page: number;
	perPage: number;
	categories: Category[];
	/** The category being shown, or null for "All". */
	activeCategory?: Category | null;
	/** The search term, when this is a search result. */
	q?: string | null;
	/** Path of page 1 of this listing; page n is `${basePath}page/n/`. */
	basePath: string;
}
const { posts, total, page, perPage, categories, activeCategory = null, q = null, basePath } = Astro.props;

const pageCount = Math.max(1, Math.ceil(total / perPage));
const pageHref = (n: number) => (n <= 1 ? basePath : `${basePath}page/${n}/`);
const first = total === 0 ? 0 : (page - 1) * perPage + 1;
const last = Math.min(total, page * perPage);

const heading = q ? `Results for “${q}”` : activeCategory ? activeCategory.label : "Latest Articles";
---

<section class="blog-hero">
	<span class="eyebrow">From Grant's Desk</span>
	<h1 class="blog-hero__h">Market Insights</h1>
	<p class="blog-hero__sub">Expert perspectives on the evolving landscape of Lake Tahoe luxury real estate, community lifestyle, and investment trends.</p>
</section>

<section class="blog-filter">
	<div class="blog-filter__inner">
		<nav class="blog-filter__pills" aria-label="Filter by category">
			<a class={`blog-pill${!activeCategory && !q ? " is-active" : ""}`} href="/posts/" aria-current={!activeCategory && !q ? "page" : undefined}>All</a>
			{categories.map((c) => (
				<a
					class={`blog-pill${activeCategory?.slug === c.slug ? " is-active" : ""}`}
					href={`/category/${c.slug}/`}
					aria-current={activeCategory?.slug === c.slug ? "page" : undefined}
				>{c.label}</a>
			))}
		</nav>
		<form class="blog-search" action="/posts/" method="get" role="search">
			<label class="blog-search__label" for="blog-search-q">Search articles</label>
			<svg class="blog-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
			<input class="blog-search__input" id="blog-search-q" type="search" name="q" placeholder="Search articles" value={q ?? ""} />
		</form>
	</div>
</section>

<section class="blog-list">
	<div class="container">
		<div class="blog-list__head">
			<h2 class="blog-list__h">{heading}</h2>
			{total > 0 && <span class="blog-list__count">Showing {first}–{last} of {total}</span>}
		</div>

		{posts.length === 0 ? (
			<p class="blog-list__empty">
				{q ? "No articles match that search yet." : "No articles here yet. Check back soon."}
				{" "}<a href="/posts/">See all articles</a>
			</p>
		) : (
			<div class="blog blog--archive">
				{posts.map((p) => <PostCardC post={p} />)}
			</div>
		)}

		{pageCount > 1 && (
			<nav class="blog-pages" aria-label="Pagination">
				{page > 1 && (
					<a class="blog-pages__step" href={pageHref(page - 1)}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>PREV
					</a>
				)}
				{Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
					<a class={`blog-pages__n${n === page ? " is-active" : ""}`} href={pageHref(n)} aria-current={n === page ? "page" : undefined}>{n}</a>
				))}
				{page < pageCount && (
					<a class="blog-pages__step" href={pageHref(page + 1)}>
						NEXT<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
					</a>
				)}
			</nav>
		)}
	</div>
</section>

<div class="blog-contact">
	<ContactCta id="blog-contact" bg="beige" />
</div>
