---
// Shared layout for the simple content pages (Concierge, and any other
// page_content entry). Reads a `page_content` entry by slug; every field is
// inline-editable and falls back to nothing (the page is seeded, so real
// content always shows).
//
// Styles are .content-* in styles.css. This markup used to carry the whole
// design inline, which is how its hero heading ended up the only weight-600
// heading on the site; the headings are on the shared tiers now.
import GcmLayout from "../layouts/GcmLayout.astro";
import ContactCta from "./ContactCta.astro";
import { getEmDashEntry } from "emdash";

const { slug } = Astro.props as { slug: string };
let entry: any = null;
try { entry = (await getEmDashEntry("page_content", slug))?.entry ?? null; } catch { entry = null; }
if (!entry) return Astro.redirect("/404");
const d = entry.data ?? {};
const e = entry.edit ?? {};
const cards = [1, 2, 3, 4].map((i) => ({ h: d[`card${i}_h`], p: d[`card${i}_p`], eh: e[`card${i}_h`], ep: e[`card${i}_p`] }))
	.filter((c) => c.h || c.p);
---

<GcmLayout title={`${d.headline ?? d.title} — Grant C. Meyer Homes`} description={d.lead} content={{ collection: "page_content", id: entry.data.id, slug }}>
	<section class="content-hero" data-screen-label={`Page ${slug}`}>
		<span class="eyebrow" {...(e.eyebrow ?? {})}>{d.eyebrow}</span>
		<h1 class="content-hero__h" {...(e.headline ?? {})}>{d.headline ?? d.title}</h1>
		<p class="content-hero__sub" {...(e.lead ?? {})}>{d.lead}</p>
	</section>

	<section class="section section--cream">
		<div class="container content-grid">
			{cards.map((c, i) => (
				<div class="content-card">
					<div class="eyebrow">{String(i + 1).padStart(2, "0")}</div>
					<h3 class="content-card__h" {...(c.eh ?? {})}>{c.h}</h3>
					<p class="content-card__p" {...(c.ep ?? {})}>{c.p}</p>
				</div>
			))}
		</div>
	</section>

	{/* Shared contact section — same component and same CMS entry as every other
	    page, so editing it once updates all of them. */}
	<ContactCta />
</GcmLayout>
