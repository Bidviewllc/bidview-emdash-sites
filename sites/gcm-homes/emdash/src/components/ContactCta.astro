---
// The "Your Tahoe Story Starts With One Conversation." section — ONE source, used
// on every page that needs it. Content comes from the `contact_cta` singleton
// (Contact CTA (site-wide) in the dashboard, entry "default"), so editing it there
// updates every page at once.
//
// Before this existed the section was duplicated: hardcoded on /contact/ (carrying
// the placeholder phone and email) and again on the home page. Anything that needs
// it now imports this component instead of copying the markup.
//
// NOT the same thing as the listing detail page's "Schedule a Private Showing"
// block — that one is property-specific and posts a listing-scoped enquiry.
import { getEmDashEntry } from "emdash";
import { imageUrl } from "../lib/media";
import InquiryFormScript from "./InquiryFormScript.astro";

interface Props {
	/** Override the shared heading on one page without breaking the single source. */
	heading?: string | null;
	/** Anchor id, so a page can link to #contact. Only set one per page. */
	id?: string;
	/** Set when this is the first section on a page: adds top room for the fixed nav. */
	first?: boolean;
	/**
	 * Which of the two light section tones this instance sits on. The site's
	 * non-blue sections alternate beige/cream down each page, and this is the last
	 * section on four different pages, so it cannot be pinned to one tone -- each
	 * page passes whichever one continues its own rhythm. Defaults to cream.
	 */
	bg?: "cream" | "beige";
}
const { heading: headingOverride = null, id = "contact", first = false, bg = "cream" } = Astro.props;

let cta: any = {};
try {
	const res = await getEmDashEntry("contact_cta", "default");
	cta = res?.entry?.data ?? {};
} catch {
	cta = {};
}

const heading = headingOverride ?? cta.heading ?? "Your Tahoe Story Starts With One Conversation.";
const formHeading = cta.form_heading ?? "Let's begin with a conversation.";
const submitLabel = cta.submit_label ?? "SEND INQUIRY";
const successMessage = cta.success_message ?? "Thanks — Grant will be in touch within 24 hours.";
const agentName = cta.agent_name ?? "Grant C. Meyer";
const agentRole = cta.agent_role ?? "Coldwell Banker Global Luxury Agent";
const agentPhoto = imageUrl(cta.agent_photo) ?? "/assets/grant.jpg";

// No fallbacks on these three on purpose. The design hardcodes (775) 555-0192 /
// grant@meyerhomes.com / 923 Tahoe Blvd, which are placeholders — a row stays
// hidden until its field holds a real value, so nothing invented can ship.
const rows = [
	["CALL DIRECTLY", (cta.phone ?? "").toString().trim()],
	["EMAIL GRANT", (cta.email ?? "").toString().trim()],
	["MAILING ADDRESS", (cta.address ?? "").toString().trim()],
].filter(([, v]) => v) as [string, string][];
---

<section id={id} class={`section section--${bg}`} data-screen-label="Contact" style={first ? "padding-top:140px" : undefined}>
	<div class="container">
		<div class="invite">
			<div class="invite__left">
				<h2 class="invite__h">{heading}</h2>
				{rows.length > 0 && (
					<div style="display:flex;flex-direction:column;gap:20px;margin-top:10px">
						{rows.map(([label, value]) => (
							<div class="invite__row">
								<div>
									<div class="invite__row__label">{label}</div>
									<div class="invite__row__v">{value}</div>
								</div>
							</div>
						))}
					</div>
				)}
				<div class="invite__agent">
					<img src={agentPhoto} alt={agentName} />
					<div>
						<div class="invite__agent__name">{agentName}</div>
						<div class="invite__agent__role">{agentRole}</div>
					</div>
				</div>
			</div>

			<form class="invite__form" data-inquiry-form action="/api/contact" method="POST">
				<h3 class="invite__form__h">{formHeading}</h3>
				<div class="form-row">
					<div class="field">
						<label class="field__label">FULL NAME</label>
						<input class="field__input" name="name" placeholder="John Doe" required />
					</div>
					<div class="field">
						<label class="field__label">EMAIL ADDRESS</label>
						<input class="field__input" type="email" name="email" placeholder="john@example.com" required />
					</div>
				</div>
				<div class="field">
					<label class="field__label">PHONE NUMBER</label>
					<input class="field__input" name="phone" placeholder="+1 (555) 000-0000" />
				</div>
				<div class="field">
					<label class="field__label">HOW CAN WE HELP?</label>
					<textarea class="field__input" name="message" placeholder="I'm interested in viewing current listings in Crystal Bay..." required></textarea>
				</div>
				{/* Honeypot — hidden from humans, bots fill it */}
				<input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
				{/* Which page the lead came from, so enquiries are traceable. */}
				<input type="hidden" name="source" value={Astro.url.pathname} />
				<div class="form-sent" data-inquiry-sent style="display:none">✓ {successMessage}</div>
				<div class="form-error" data-inquiry-error style="display:none;color:#c0392b;font-size:14px;margin-bottom:12px"></div>
				<button type="submit" class="btn--submit btn" data-inquiry-submit>{submitLabel}</button>
			</form>
		</div>
	</div>
</section>

{/* Submit handling — shared with the /sellers/ valuation form. */}
<InquiryFormScript />
