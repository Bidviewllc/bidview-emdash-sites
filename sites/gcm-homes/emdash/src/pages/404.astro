---
// Not-found page. Was the EmDash starter's unstyled 404 (Base layout, "Grant
// Meyer / Home / Posts / About" nav, empty blog categories). Now the site's own
// layout: the dark contact-style hero plus the places a lost visitor most
// likely wanted.
import GcmLayout from "../layouts/GcmLayout.astro";
---

<GcmLayout title="Page Not Found — Grant C. Meyer Homes" description="This page has moved or no longer exists.">
	<link rel="stylesheet" href="/contact.css" />

	<section class="section section--dark chero">
		<div class="container chero__inner">
			<span class="eyebrow">Page Not Found</span>
			<h1 class="h1 chero__h">This page has <em>moved on.</em></h1>
			<p class="section-lead chero__lead">
				The link may be old, or the home may have sold. Search what's on the market now, see what we've sold, or get in touch and we'll find what you were looking for.
			</p>
			<div class="nf__actions">
				<a class="btn btn--orange" href="/listings/">SEARCH LISTINGS</a>
				<a class="btn btn--ghost-light" href="/sold-by-grant/">RECENTLY SOLD</a>
				<a class="btn btn--ghost-light" href="/contact/">CONTACT US</a>
			</div>
		</div>
	</section>

	<style>
		.nf__actions {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 12px;
			margin-top: 32px;
		}
	</style>
</GcmLayout>
