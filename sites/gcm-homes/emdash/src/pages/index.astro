---
// Grant C. Meyer Homes — homepage, ported from the prototype into emdash.
// Editable text comes from the `homepage` singleton collection (entry id "home").
// Every field falls back to the approved copy, so the page renders correctly even
// before the collection is seeded; editing lights up once you're logged into admin.
import GcmLayout from "../layouts/GcmLayout.astro";
import { getEmDashEntry, getTermsForEntries } from "emdash";
import { env } from "cloudflare:workers";
import { firstImageUrl } from "../lib/media";
import { TESTIMONIALS } from "../lib/testimonials";
import ContactCta from "../components/ContactCta.astro";
import GrantIntro from "../components/GrantIntro.astro";

// Load the homepage entry; tolerate it not existing yet (renders from fallbacks).
let entry: any = null;
try {
	const res = await getEmDashEntry("homepage", "home");
	entry = res?.entry ?? null;
} catch { entry = null; }
const d = entry?.data ?? {};
const e = entry?.edit ?? {};

// Featured listings — live from the Trestle-synced D1 tables (read-only).
// Astro 6 exposes Cloudflare bindings via `cloudflare:workers`, not Astro.locals.
let featured: any[] = [];
try {
	const DB = (env as any)?.DB;
	if (DB) {
		const { results } = await DB.prepare(
			"SELECT id, slug, address, city, state, price, beds, baths, sqft, lot_acres, category, sub_type, type, waterfront, photos_count, photo FROM listings WHERE status='Active' AND photo IS NOT NULL ORDER BY price DESC LIMIT 3"
		).all();
		featured = results ?? [];
	}
} catch { featured = []; }
// ---- The Proof ---------------------------------------------------------------
// The design's template quotes, kept as-is for now: Liz is checking with Vince how
// real reviews get pulled in, so these are placeholders to be replaced, not claims.
// Shared with the About page's "In Their Words" grid via src/lib/testimonials.ts.

// ---- Micro-Markets slider ----------------------------------------------------
// One slide per neighbourhood flagged `featured` in the CMS, so Liz picks what
// appears here without touching code. The community page still lists all sixteen.
//
// Body copy is `overview` falling back to `blurb`, as agreed — with one guard. The
// seeded overview on 14 of the 15 areas is generic filler ("X is one of the fifteen
// areas that make up Incline Village and Crystal Bay, each with its own
// character…"), while every blurb is specific and written. Treating that filler as
// "no overview" is what makes the agreed rule produce the intended result; remove
// the test once the real overviews are written.
const SEED_FILLER = /is one of the fifteen areas that make up/i;

// `boolean` fields arrive from D1 as text, and which text depends on who wrote it
// (the admin checkbox vs a SQL update), so accept anything that isn't a clear no.
const isOn = (v: any) =>
	v != null && v !== "" && v !== 0 && v !== "0" && v !== false && v !== "false";

let micro: any[] = [];
try {
	const DB = (env as any)?.DB;
	if (DB) {
		const { results } = await DB.prepare(
			"SELECT slug, title, tag, overview, blurb, avg_price, trend, featured, map_image, featured_image FROM ec_neighborhoods WHERE status='published' ORDER BY title",
		).all();
		micro = (results ?? [])
			.filter((n: any) => isOn(n.featured))
			.map((n: any) => ({
				slug: n.slug,
				title: n.title,
				body: n.overview && !SEED_FILLER.test(n.overview) ? n.overview : (n.blurb || null),
				avgPrice: n.avg_price || null,
				trend: n.trend || null,
				// Her own map image wins; the shared Tahoe map is the backstop so a
				// slide is never a blank frame while the images are still being added.
				image: firstImageUrl(n.map_image, n.featured_image) ?? "/assets/micromap.png",
			}))
			// A slide with no copy at all is worse than one fewer slide.
			.filter((n: any) => n.body);
	}
} catch { micro = []; }

// ---- Market Insights ---------------------------------------------------------
// Only the three real photographs in public/assets are used here. Everything else
// there is 512px AI-generated filler — listing-interior-1.jpg is a stock headshot,
// -2 a dark corridor, tahoe-lifestyle.jpg is clip art — and listing-1056.jpg is a
// byte-identical copy of listing-hero-exterior.jpg. Used only when a post has no
// featured image of its own.
const POST_FALLBACK_IMAGES = [
	"/assets/gallery-1.jpg",
	"/assets/listing-hero-exterior.jpg",
	"/assets/listing-interior-3.jpg",
];
let posts: any[] = [];
try {
	const DB = (env as any)?.DB;
	if (DB) {
		const { results } = await DB.prepare(
			"SELECT id, slug, title, excerpt, featured_image, published_at FROM ec_posts WHERE status='published' ORDER BY published_at DESC LIMIT 3",
		).all();
		// Categories come from the Categories taxonomy on each post, not from a field
		// on the collection — one batched query for all three rather than one each.
		let catsById = new Map<string, any[]>();
		try {
			catsById = await getTermsForEntries(
				"posts",
				(results ?? []).map((p: any) => p.id),
				"category",
			);
		} catch { catsById = new Map(); }
		posts = (results ?? []).map((p: any, i: number) => ({
			slug: p.slug,
			title: p.title,
			excerpt: p.excerpt || "",
			// A post can sit in more than one category; show them all. Blank when the
			// post has none — the label is hidden rather than guessed at.
			category: (catsById.get(p.id) ?? []).map((t: any) => t.label).join(" · "),
			image: firstImageUrl(p.featured_image) ?? POST_FALLBACK_IMAGES[i % POST_FALLBACK_IMAGES.length],
			date: p.published_at
				? new Date(String(p.published_at).replace(" ", "T") + "Z")
					.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })
					.toUpperCase()
				: "",
		}));
	}
} catch { posts = []; }

// ---- Emotional Weight background ---------------------------------------------
// Defaults to the design's skier, self-hosted. Swappable from the CMS.
const emotionImage = firstImageUrl(d.emotion_image) ?? "/assets/emotion-lifestyle.jpg";

const money = (n: number) => (n ? "$" + Number(n).toLocaleString("en-US") : "—");
// The card's fact row, as pairs so each figure can be bolded the way the
// /listings/ cards do it. Falls back to lot size when there's no house on the lot.
const metaBits = (l: any) => {
	const bits: Array<[string, string]> = [];
	if (l.beds) bits.push([String(l.beds), "BD"]);
	if (l.baths) bits.push([String(l.baths), "BA"]);
	if (l.sqft) bits.push([Number(l.sqft).toLocaleString(), "SQFT"]);
	if (!bits.length && l.lot_acres) bits.push([String(l.lot_acres), "ACRES"]);
	return bits;
};
// The badge text. `category` is the readable MLS field the /listings/ cards use
// ("Single Family", "Multi-Family"); sub_type is the raw enum, so it only gets
// used as a fallback and needs its camelCase split apart.
const tagOf = (l: any) =>
	l.category || String(l.sub_type || l.type || "Property").replace(/([a-z])([A-Z])/g, "$1 $2");
---

<GcmLayout
	title="Grant C. Meyer Homes — Lake Tahoe Luxury Real Estate"
	description="Luxury real estate in Incline Village & Crystal Bay, Lake Tahoe — guided by a 35-year resident."
	content={entry ? { collection: "homepage", id: "home" } : undefined}
>
	{/* HERO */}
	<section class="hero" data-screen-label="01 Hero">
		<div class="hero__img"></div>
		<div class="hero__dusk"></div>
		<div class="hero__night"></div>
		<div class="hero__stars"></div>
		<div class="hero__veil"></div>
		<div class="hero__copy">
			<h1 class="hero__title" set:html={d.hero_headline ?? 'The View From Here <em>Changes Everything.</em>'} {...(e.hero_headline ?? {})}></h1>
			<p class="hero__sub" {...(e.hero_sub ?? {})}>
				{d.hero_sub ?? "Falling in love with Lake Tahoe is easy. Finding the right home in a market this unique… that's where it gets interesting."}
			</p>
			<div class="hero__cta">
				<a class="btn btn--orange" href="/listings/">{d.hero_cta_primary ?? "EXPLORE TAHOE HOMES"}</a>
				<a class="btn btn--ghost-light" href="/contact/">{d.hero_cta_secondary ?? "WHAT IS YOUR HOME WORTH"}</a>
			</div>
		</div>
	</section>

	{/* REALITY CHECK + STATS */}
	<section class="section section--dark" data-screen-label="02 Reality Check">
		<div class="container reality">
			<div>
				<h2 class="reality__h" {...(e.reality_heading ?? {})}>
					{d.reality_heading ?? "Incline Village Isn't Like Any Market You've Bought In Before."}
				</h2>
				<p class="reality__p" {...(e.reality_body ?? {})}>
					{d.reality_body ?? "Tahoe real estate operates on its own set of rules. The luxury segment here is defined by low turnover, high privacy, and a pace that catches outsiders off guard. Professionalism here isn't just about sales — it's about survival."}
				</p>
			</div>
			<div class="stats">
				<div class="stat">
					<div class="stat__num" {...(e.stat1_num ?? {})}>{d.stat1_num ?? "11+ Months"}</div>
					<div class="eyebrow" {...(e.stat1_label ?? {})}>{d.stat1_label ?? "AVERAGE DAYS ON MARKET"}</div>
					<div class="stat__desc" {...(e.stat1_desc ?? {})}>{d.stat1_desc ?? "Luxury homes often wait for the perfect buyer. Patience is as critical as the price tag."}</div>
				</div>
				<div class="stat">
					<div class="stat__num" {...(e.stat2_num ?? {})}>{d.stat2_num ?? "~50%"}</div>
					<div class="eyebrow" {...(e.stat2_label ?? {})}>{d.stat2_label ?? "CASH PURCHASES"}</div>
					<div class="stat__desc" {...(e.stat2_desc ?? {})}>{d.stat2_desc ?? "Competition is fierce. Half of all transactions are liquidity-driven, requiring rapid negotiation."}</div>
				</div>
				<div class="stat">
					<div class="stat__num" {...(e.stat3_num ?? {})}>{d.stat3_num ?? "20–40%"}</div>
					<div class="eyebrow" {...(e.stat3_label ?? {})}>{d.stat3_label ?? "ONLINE VALUATION INACCURACY"}</div>
					<div class="stat__desc" {...(e.stat3_desc ?? {})}>{d.stat3_desc ?? "Algorithm-based estimates fail to account for Tahoe's specific micro-locations and lot features."}</div>
				</div>
			</div>
		</div>
	</section>

	{/* 03 EMOTIONAL WEIGHT — the `bc` (bottom-card) variant, which is what the design
	     demo actually renders. The first build used the centred-card variant, which
	     drops a solid navy panel on top of the photo; this one leaves the photograph
	     fully visible and sets the copy in two columns over a bottom gradient. Every
	     rule below already ships in styles.css and responsive.css.

	     Background: the design's skier — the lifestyle shot, which is the point of the
	     section. It was being overridden here with a listing photo; now it's the same
	     photograph, served from our own origin instead of hotlinked, and swappable from
	     the CMS via the Emotion background image field. */}
	<section class="emotion emotion--bc" data-screen-label="03 Emotional Weight">
		<div class="emotion__bg" style={`background-image:url('${emotionImage}')`}></div>
		<div class="emotion__veil emotion__veil--bc"></div>
		<div class="emotion-bc__card">
			<div class="emotion-bc__left">
				<h2 class="emotion-bc__h" {...(e.emotion_h1 ?? {})}>
					{d.emotion_h1 ?? "You're Not Just Buying A Home."} <em>{d.emotion_h2 ?? "You're Choosing A Life."}</em>
				</h2>
			</div>
			<div class="emotion-bc__right">
				<p class="emotion-bc__p" {...(e.emotion_body ?? {})}>
					{d.emotion_body ?? "The skiing, the beaches, the trails, the community — people don't move to Incline Village for the square footage. They move here because something about this place got under their skin. The right home makes it real."}
				</p>
			</div>
		</div>
	</section>

	{/* THE GUIDE — Grant. Shared with every listing page; the copy lives on the
	    `grant_intro` singleton, so one edit covers both. The home entry's old
	    guide_eyebrow / guide_heading / guide_body / guide_cta fields are no
	    longer read here.
	    The design also has a logos strip after this. Not built: its headline is
	    still placeholder ("Nice Headline About Benefit of These Logos") and we
	    have neither the logo files nor permission to display them. */}
	<GrantIntro bg="beige" label="04 The Guide" />

	{/* 05 THE PROOF — testimonials are the design's template copy for now; Liz is
	     checking with Vince how real reviews get pulled in. */}
	<section class="section section--cream" data-screen-label="05 The Proof">
		<div class="container">
			<div class="section-title">
				<h2 {...(e.proof_heading ?? {})}>{d.proof_heading ?? "Hundreds of Clients. Thousands of Negotiations. One Market."}</h2>
				<p {...(e.proof_body ?? {})}>
					{d.proof_body ?? "From first-time Tahoe buyers to clients who've completed 23 transactions together, the proof is in the relationships, not the brochures."}
				</p>
			</div>
			<div class="testimonials">
				{TESTIMONIALS.map((t) => (
					<div class="testimonial">
						<div class="stars">{[0, 1, 2, 3, 4].map(() => <span>★</span>)}</div>
						<p class="testimonial__q">"{t.q}"</p>
						<div class="testimonial__attr">
							<div class="testimonial__name">{t.name}</div>
							<div class="eyebrow eyebrow--muted">{t.loc}</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* FEATURED LISTINGS — live from D1 */}
	<section class="section section--beige" data-screen-label="07 Featured Listings">
		<div class="container">
			<div class="section-title section-title--nolead">
				<span class="eyebrow" {...(e.featured_eyebrow ?? {})}>{d.featured_eyebrow ?? "CURATED LAKE TAHOE PROPERTIES"}</span>
				<h2 {...(e.featured_heading ?? {})}>{d.featured_heading ?? "Featured Listings"}</h2>
			</div>
			<div class="listings-grid">
				{featured.map((l) => (
					<a class="card" href={`/homes/${l.slug}/`}>
						<div class="card__media">
							<img class="card__img" src={l.photo} alt={l.address} loading="lazy" />
							<div class="card__badges">
								<div class="card__tag">{tagOf(l)}</div>
								{l.waterfront ? <div class="card__wf">Waterfront</div> : null}
							</div>
							{l.photos_count ? <div class="card__count">{l.photos_count} photos</div> : null}
						</div>
						<div class="card__body">
							<div class="card__price">{money(l.price)}</div>
							<div class="card__addr">{l.address || "Address on request"}</div>
							<div class="card__city">{[l.city, l.state].filter(Boolean).join(", ") || "Lake Tahoe"}</div>
							{metaBits(l).length > 0 && (
								<div class="card__meta">
									{metaBits(l).map(([n, unit]) => <span><b>{n}</b> {unit}</span>)}
								</div>
							)}
						</div>
					</a>
				))}
			</div>
			<div class="section-end-cta">
				<a class="btn btn--dark" href="/listings/">VIEW ALL LISTINGS<span class="cta-arrow" aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	{/* 08 MICRO-MARKETS — one slide per neighbourhood flagged `featured` in the CMS.
	     Deliberately NOT the design's click-the-map-to-jump behaviour: Liz asked for a
	     plain slider, one slide each, showing that neighbourhood's own map image.
	     The whole section is absent when nothing is flagged. */}
	{micro.length > 0 && (
		<section class="section section--dark section--clip" data-screen-label="08 Micro-Markets">
			<div class="micro__decor" aria-hidden="true">
				<img src="/assets/decoration-wave.svg" alt="" />
				<img src="/assets/decoration-wave.svg" alt="" />
			</div>
			<div class="container">
				<div class="section-title on-dark">
					<span class="eyebrow" {...(e.micro_eyebrow ?? {})}>{d.micro_eyebrow ?? "NEIGHBORHOOD INTELLIGENCE"}</span>
					<h2 {...(e.micro_heading ?? {})}>{d.micro_heading ?? "Explore Tahoe's Micro-Markets"}</h2>
				</div>

				{micro.map((n: any, i: number) => (
					<div class="micro" data-micro-slide={i} style={i === 0 ? "" : "display:none"}>
						<div class="micro__map">
							<div class="micro__map__img" style={`background-image:url('${n.image}')`}></div>
							<div class="eyebrow eyebrow--dim micro__map__caption">LAKE TAHOE · NEVADA SIDE</div>
						</div>
						<div class="micro__content">
							<h3 class="micro__h">{n.title}</h3>
							<p class="micro__p">{n.body}</p>
							<div class="micro__stats">
								{n.avgPrice && (
									<div>
										<div class="eyebrow micro__stat__label">AVERAGE PRICE</div>
										<div class="micro__stat__v">{n.avgPrice}</div>
									</div>
								)}
								{n.trend && (
									<div>
										<div class="eyebrow micro__stat__label">INVENTORY TREND</div>
										<div class="micro__stat__v">{n.trend}</div>
									</div>
								)}
							</div>
							<a class="reality__link micro__cta" href={`/neighborhood/${n.slug}/`}>LEARN MORE<span class="cta-arrow" aria-hidden="true">→</span></a>
						</div>
					</div>
				))}

				{micro.length > 1 && (
					<div class="micro__nav">
						<button class="btn btn--icon btn--ghost" id="microPrev" aria-label="Previous neighborhood">←</button>
						<div class="micro__dots">
							{micro.map((n: any, i: number) => (
								<button class="micro__dot" data-micro-dot={i} aria-label={n.title}></button>
							))}
						</div>
						<button class="btn btn--icon micro__next" id="microNext" aria-label="Next neighborhood">→</button>
					</div>
				)}
			</div>
		</section>
	)}

	{/* 09 MARKET INSIGHTS — hidden until posts exist. The category comes from the
	     post's Categories taxonomy in the CMS; the byline is still a fixed string
	     because the posts collection has no byline field. */}
	{posts.length > 0 && (
		<section class="section section--cream" data-screen-label="09 Market Insights">
			<div class="container">
				<div class="section-title">
					<h2 {...(e.insights_heading ?? {})}>{d.insights_heading ?? "Market Insights"}</h2>
					<p {...(e.insights_body ?? {})}>
						{d.insights_body ?? "Expert perspectives on the evolving landscape of Lake Tahoe luxury real estate, community lifestyle, and investment trends."}
					</p>
				</div>
				<div class="blog">
					{posts.map((p: any) => (
						/* The same .card as the listing cards, with the category in the same
						    .card__tag pill. The whole card is the link, so the "READ ARTICLE"
						    cue is a span — an <a> inside an <a> is invalid. */
						<a class="card card--post" href={`/posts/${p.slug}/`}>
							<div class="card__media">
								<img class="card__img" src={p.image} alt={p.title} loading="lazy" />
								{p.category && (
									<div class="card__badges">
										<div class="card__tag">{p.category}</div>
									</div>
								)}
							</div>
							<div class="card__body">
								<h3 class="blog-card__h">{p.title}</h3>
								<p class="blog-card__p">{p.excerpt}</p>
								<span class="blog-card__cta">READ ARTICLE<span class="cta-arrow" aria-hidden="true">→</span></span>
								<div class="blog-card__byline">
									<div class="blog-card__avatar"></div>
									<div>
										<div class="blog-card__byline__t">GRANT C. MEYER</div>
										<div class="blog-card__byline__d">{p.date}</div>
									</div>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	{/* CONTACT — the shared site-wide section. Same component and same CMS entry as
	    /contact/, /community/ and the four content pages, so it is edited in one
	    place. Liz's design renders it twice on the home page (mid-page and at the
	    end); built once at the end. */}
	<ContactCta bg="beige" />

	<script is:inline>
		/* Micro-markets slider. Plain show/hide rather than a transform track: the
		   slides are full grid rows and only one is ever needed on screen. */
		(function () {
			var slides = Array.prototype.slice.call(document.querySelectorAll("[data-micro-slide]"));
			var dots = Array.prototype.slice.call(document.querySelectorAll("[data-micro-dot]"));
			var prev = document.getElementById("microPrev");
			var next = document.getElementById("microNext");
			if (slides.length < 2 || !prev || !next) return;
			var at = 0;
			function show(n) {
				at = (n + slides.length) % slides.length;
				slides.forEach(function (el, k) { el.style.display = k === at ? "" : "none"; });
				dots.forEach(function (el, k) {
					el.style.width = k === at ? "22px" : "6px";
					el.style.background = k === at ? "#F7945B" : "rgba(255,255,255,0.3)";
					el.setAttribute("aria-current", k === at ? "true" : "false");
				});
			}
			prev.addEventListener("click", function () { show(at - 1); });
			next.addEventListener("click", function () { show(at + 1); });
			dots.forEach(function (el, k) { el.addEventListener("click", function () { show(k); }); });
			show(0);
		})();

	</script>
</GcmLayout>
