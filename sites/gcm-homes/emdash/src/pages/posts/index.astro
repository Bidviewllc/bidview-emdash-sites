---
// /posts/ — Market Insights archive, page 1. Also serves search results
// (/posts/?q=...): that is the one page that reads the query string, and
// src/worker.ts bypasses the edge cache whenever ?q= is present.
import GcmLayout from "../../layouts/GcmLayout.astro";
import BlogArchive from "../../components/BlogArchive.astro";
import { listPosts, listCategories, POSTS_PER_PAGE } from "../../lib/posts";

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100) || null;
const [{ posts, total }, categories] = await Promise.all([listPosts({ page: 1, q }), listCategories()]);
---

<GcmLayout
	title={q ? `Search: ${q} — Market Insights | Grant C. Meyer Homes` : "Market Insights — Grant C. Meyer Homes"}
	description="Grant C. Meyer on the Lake Tahoe luxury real estate market: Incline Village and Crystal Bay market analysis, buying and selling advice, and local news."
	canonical={`${Astro.url.origin}/posts/`}
>
	<link rel="stylesheet" href="/blog.css" />
	<BlogArchive posts={posts} total={total} page={1} perPage={POSTS_PER_PAGE} categories={categories} q={q} basePath="/posts/" />
</GcmLayout>
