---
// /sold/ — every sold home in the archive, Grant's and every other agent's,
// one card per home, newest close first (Liz, 2026-11-09). The site links to
// /sold-by-grant/ first; this page is where its "View all sold homes" goes.
//
// What the archive holds (so the copy below doesn't over-promise): every sale
// Grant was on a side of back to 2011, other agents' sales of $5M and up, and
// any listing that sold while the sync was watching the feed. Smaller sales by
// other agents from before the site went live are not in it.
//
// Paged 24 to a page by public/js/sold-pager.js (#all=N in the address).
import GcmLayout from "../layouts/GcmLayout.astro";
import ContactCta from "../components/ContactCta.astro";
import SoldCard from "../components/SoldCard.astro";
import { allSoldHomes } from "../lib/listings";

const homes = await allSoldHomes();

const seo = {
	title: "Sold Homes on Lake Tahoe's North Shore — Grant C. Meyer Homes",
	description:
		"Closed home sales in Incline Village and Crystal Bay, Lake Tahoe, from the MLS: the sold price and closing date for each, newest first.",
};
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>';
---

<GcmLayout title={seo.title} description={seo.description}>
	<link rel="stylesheet" href="/contact.css" />
	<link rel="stylesheet" href="/sold.css" />

	<section class="section section--dark chero" data-screen-label="01 Hero">
		<div class="container chero__inner">
			<span class="eyebrow">Sold on the North Shore</span>
			<h1 class="h1 chero__h">What homes here <em>really sell for.</em></h1>
			<p class="section-lead chero__lead">
				Closed sales in Incline Village and Crystal Bay from the MLS, newest first, with the price each home sold for and when.
			</p>
			<div class="sold-hero__cta">
				<a class="btn btn--ghost-light" href="/sold-by-grant/">SEE THE HOMES GRANT SOLD<span class="cta-arrow" aria-hidden="true" set:html={arrow}></span></a>
			</div>
		</div>
	</section>

	<section class="section section--cream" data-screen-label="02 All Sold">
		<div class="container sold-section">
			<div class="section-title section-title--nolead">
				<span class="eyebrow">Sold Homes</span>
				<h2>Sold homes, newest first</h2>
			</div>
			{homes.length === 0 ? (
				<p class="sold-empty">Recent sales are being added.</p>
			) : (
				<div class="sold-grid" id="sold-all" data-paged="all" data-per="24">
					{homes.map((l: any) => <SoldCard l={l} />)}
				</div>
			)}
		</div>
	</section>

	<ContactCta id="sold-contact" bg="beige" />

	<script is:inline src="/js/sold-pager.js" defer></script>
</GcmLayout>
