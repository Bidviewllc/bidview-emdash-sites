---
// Contact / Inquiry page — target of every "INQUIRE NOW" and "Ask Grant" CTA.
// The section itself is the shared ContactCta component, so this page, the home
// page, /community/ and the four content pages all render one source from one CMS
// entry ("Contact CTA (site-wide)"). Submissions POST to /api/contact, which saves
// to D1 and emails via Resend.
//
// The phone, email and mailing address used to be hardcoded here as the design's
// placeholders. They now come from the CMS and each row stays hidden until filled.
import GcmLayout from "../layouts/GcmLayout.astro";
import ContactCta from "../components/ContactCta.astro";
---

<GcmLayout
	title="Contact — Grant C. Meyer Homes"
	description="Start with a conversation, not a transaction. Reach Grant C. Meyer directly about Lake Tahoe luxury real estate in Incline Village & Crystal Bay."
>
	<ContactCta first />
</GcmLayout>
