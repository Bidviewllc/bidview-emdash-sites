---
// Contact / Inquiry page — target of every "INQUIRE NOW" and "Ask Grant" CTA.
// Ported from the prototype's ContactSection. NOTE: submission is currently
// front-end only (shows a confirmation) — wiring it to a real backend (D1 save +
// Resend email, like the onePHG/Ontario sites) is a tracked open item and needs
// a verified sender for Grant's domain before it can send.
import GcmLayout from "../layouts/GcmLayout.astro";
---

<GcmLayout
	title="Contact — Grant C. Meyer Homes"
	description="Start with a conversation, not a transaction. Reach Grant C. Meyer directly about Lake Tahoe luxury real estate in Incline Village & Crystal Bay."
>
	<section class="section section--cream" style="padding-top:140px" data-screen-label="Contact">
		<div class="container">
			<div class="invite">
				<div class="invite__left">
					<h2 class="invite__h">Your Tahoe Story Starts With One Conversation.</h2>
					<div style="display:flex;flex-direction:column;gap:20px;margin-top:10px">
						<div class="invite__row">
							<div>
								<div class="invite__row__label">CALL DIRECTLY</div>
								<div class="invite__row__v">(775) 555-0192</div>
							</div>
						</div>
						<div class="invite__row">
							<div>
								<div class="invite__row__label">EMAIL GRANT</div>
								<div class="invite__row__v">grant@meyerhomes.com</div>
							</div>
						</div>
						<div class="invite__row">
							<div>
								<div class="invite__row__label">MAILING ADDRESS</div>
								<div class="invite__row__v">923 Tahoe Blvd, Incline Village, NV</div>
							</div>
						</div>
					</div>
					<div class="invite__agent">
						<img src="/assets/grant.jpg" alt="Grant C. Meyer" />
						<div>
							<div class="invite__agent__name">Grant C. Meyer</div>
							<div class="invite__agent__role">Coldwell Banker Global Luxury Agent</div>
						</div>
					</div>
				</div>

				<form class="invite__form" id="inquiry-form" action="/api/contact" method="POST">
					<h3 class="invite__form__h">Let's begin with a conversation, not a transaction.</h3>
					<div class="form-row">
						<div class="field">
							<label class="field__label">FULL NAME</label>
							<input class="field__input" name="name" placeholder="John Doe" required />
						</div>
						<div class="field">
							<label class="field__label">EMAIL ADDRESS</label>
							<input class="field__input" type="email" name="email" placeholder="john@example.com" required />
						</div>
					</div>
					<div class="field">
						<label class="field__label">PHONE NUMBER</label>
						<input class="field__input" name="phone" placeholder="+1 (555) 000-0000" />
					</div>
					<div class="field">
						<label class="field__label">HOW CAN WE HELP?</label>
						<textarea class="field__input" name="message" placeholder="I'm interested in viewing current listings in Crystal Bay..." required></textarea>
					</div>
					{/* Honeypot — hidden from humans, bots fill it */}
					<input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true" />
					<div class="form-sent" id="inquiry-sent" style="display:none">✓ Thanks — Grant will be in touch within 24 hours.</div>
					<div class="form-error" id="inquiry-error" style="display:none;color:#c0392b;font-size:14px;margin-bottom:12px"></div>
					<button type="submit" class="btn--submit btn" id="inquiry-submit">SEND INQUIRY</button>
				</form>
			</div>
		</div>
	</section>

	<script is:inline>
		// Real submit — POSTs the lead to /api/contact (saves to D1 + emails via
		// Resend). Stays on-page (AJAX) and shows the confirmation on success.
		var f = document.getElementById("inquiry-form");
		if (f) f.addEventListener("submit", async function (e) {
			e.preventDefault();
			if (!f.checkValidity()) { f.reportValidity(); return; }
			var btn = document.getElementById("inquiry-submit");
			var sent = document.getElementById("inquiry-sent");
			var err = document.getElementById("inquiry-error");
			err.style.display = "none";
			btn.disabled = true; btn.textContent = "SENDING…";
			try {
				var payload = {};
				new FormData(f).forEach(function (v, k) { payload[k] = v; });
				var r = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json", "Accept": "application/json" },
					body: JSON.stringify(payload),
				});
				var data = await r.json();
				if (!r.ok || !data.ok) throw new Error(data.error || "Something went wrong. Please try again or call directly.");
				btn.style.display = "none";
				sent.style.display = "block";
				f.reset();
				setTimeout(function () { sent.style.display = "none"; btn.style.display = ""; btn.disabled = false; btn.textContent = "SEND INQUIRY"; }, 6000);
			} catch (ex) {
				err.textContent = ex.message;
				err.style.display = "block";
				btn.disabled = false; btn.textContent = "SEND INQUIRY";
			}
		});
	</script>
</GcmLayout>
