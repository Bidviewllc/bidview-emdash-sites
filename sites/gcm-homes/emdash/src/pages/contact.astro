---
// Contact page — ported from the Claude Design project's contact.html
// (js/contact.jsx + js/contact-sections.jsx), which composes:
//
//   01 Hero   .chero   — dark statement hero, centred (design's ContactHero)
//   02 Info   .cinfo   — office / hours / service area (design's ContactInfo)
//   03 Form   <ContactCta />  — the design's own ContactSection, already the
//                              site-wide component here
//
// The design's tweaks default to heroAlign "center", info strip shown and
// positioned "above" the form, so that is what is built. The alternates (left
// hero, info below) were tweak-panel options, not part of the chosen design.
//
// The form section is NOT re-implemented: the design's ContactSection is the
// same `.invite` block that already ships as ContactCta.astro, driven by the
// site-wide "Contact CTA" CMS entry, so the home page, /community/ and the
// content pages all stay in step with this page.
//
// Two CMS entries feed this page, split by what the text actually is:
//
//   contact_page          — page copy: hero, SEO, the three column labels
//   contact_cta           — the site-wide contact facts: phone, email, mailing
//                           address, office note, hours, service area
//
// The facts live in contact_cta because they are not specific to this page:
// the form block below reads the same entry, so does /listings/'s property
// sheet footer, and so does every other page carrying the contact section.
// Change the phone or the address once, there, and all of them follow.
//
// Every field falls back to the approved design copy below, so the page renders
// correctly before the collection is seeded and editing lights up once logged in.
import GcmLayout from "../layouts/GcmLayout.astro";
import ContactCta from "../components/ContactCta.astro";
import { getEmDashEntry } from "emdash";
import { realAddress } from "../lib/contact-details";

let entry: any = null;
try {
	const res = await getEmDashEntry("contact_page", "contact");
	entry = res?.entry ?? null;
} catch {
	entry = null;
}
const d = entry?.data ?? {};
const e = entry?.edit ?? {};

// The office address, hours and service area are contact facts, not page copy,
// so they come from the site-wide "Contact details" entry — the same one the
// form block beside them and the printable property sheet read. Editing it in
// one place updates every one of them. This page holds only the column labels.
let cta: any = {};
try {
	const res = await getEmDashEntry("contact_cta", "default");
	cta = res?.entry?.data ?? {};
} catch {
	cta = {};
}

// Each multi-line field is one text value split on newlines, so a column can
// carry two lines or four without a schema change. The first line takes the
// darker ink (.cinfo__line--lead).
const lines = (v: unknown, fallback: string[]): string[] => {
	const s = (v ?? "").toString().trim();
	if (!s) return fallback;
	return s.split(/\n+/).map((l) => l.trim()).filter(Boolean);
};

// realAddress() returns null for a placeholder as well as for a blank, so a
// stand-in in the CMS falls back to the approved copy rather than publishing
// itself — and rather than disagreeing with the form block, which hides its
// address row on exactly the same test.
const officeLines = lines(realAddress(cta.address), [
	"923 Tahoe Boulevard",
	"Incline Village, NV 89451",
]);
const officeNote = (cta.office_note ?? "By appointment, always welcome").toString().trim();

const INFO = [
	{
		key: "office",
		icon: "pin",
		label: d.info1_label ?? "The Office",
		lines: officeNote ? [...officeLines, officeNote] : officeLines,
	},
	{
		key: "hours",
		icon: "phone",
		label: d.info2_label ?? "Hours & Response",
		lines: lines(cta.hours, [
			"Mon – Sat · 8am – 7pm PT",
			"Replies within 24 hours",
			"After-hours by request",
		]),
	},
	{
		key: "area",
		icon: "mail",
		label: d.info3_label ?? "Service Area",
		lines: lines(cta.service_area, [
			"Incline Village · Crystal Bay",
			"Glenbrook · Zephyr Cove",
			"& the greater North Shore",
		]),
	},
];

// The design's Icon.Pin / Icon.Phone / Icon.Mail, inlined. Same geometry and
// stroke weight as the icons in ContactCta's contact rows.
const ICONS: Record<string, string> = {
	pin: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
	phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
	mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
};

const seo = {
	title: d.seo_title ?? "Contact — Grant C. Meyer Homes",
	description:
		d.seo_description ??
		"Every Tahoe story begins with one conversation. Reach Grant C. Meyer directly about Lake Tahoe luxury real estate in Incline Village & Crystal Bay.",
};
---

<GcmLayout title={seo.title} description={seo.description}>
	<link rel="stylesheet" href="/contact.css" />

	{/* 01 HERO — the design's ContactHero, centred variant. */}
	<section class="section section--dark chero" data-screen-label="01 Hero">
		<div class="container chero__inner">
			<span class="eyebrow" {...(e.hero_eyebrow ?? {})}>{d.hero_eyebrow ?? "Get in Touch"}</span>
			<h1
				class="h1 chero__h"
				set:html={d.hero_headline ?? "Every Tahoe story begins with <em>one conversation.</em>"}
				{...(e.hero_headline ?? {})}
			></h1>
			<p class="section-lead chero__lead" {...(e.hero_sub ?? {})}>
				{d.hero_sub ??
					"Whether you're considering a move to the North Shore, weighing the sale of a treasured property, or simply have a question about the market — Grant reads every note personally and replies within a day."}
			</p>
		</div>
	</section>

	{/* 02 INFO — office / hours / service area, directly above the form. */}
	<section class="section section--cream cinfo" data-screen-label="02 Info">
		<div class="container">
			<div class="cinfo__grid">
				{INFO.map((col) => (
					<div class="cinfo__col">
						<div class="cinfo__head">
							<span class="cinfo__icon" aria-hidden="true">
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={ICONS[col.icon]}
								></svg>
							</span>
							<div class="cinfo__label">{col.label}</div>
						</div>
						<div class="cinfo__lines">
							{col.lines.map((l, i) => (
								<div class={`cinfo__line${i === 0 ? " cinfo__line--lead" : ""}`}>{l}</div>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* 03 FORM — the shared section. `first` is deliberately NOT set: the hero
	    is the first section now, so the extra top padding that used to clear the
	    nav on this page would only add a gap under the info strip. Cream keeps
	    it continuous with that strip, which ends with no bottom padding. */}
	<ContactCta bg="cream" />
</GcmLayout>
