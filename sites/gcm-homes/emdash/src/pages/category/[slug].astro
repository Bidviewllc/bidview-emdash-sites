---
// /category/<slug>/ — Market Insights archive filtered to one category.
// Same page as /posts/, with that category's filter button active.
import GcmLayout from "../../layouts/GcmLayout.astro";
import BlogArchive from "../../components/BlogArchive.astro";
import { listPosts, listCategories, POSTS_PER_PAGE } from "../../lib/posts";

const slug = String(Astro.params.slug ?? "");
const categories = await listCategories();
const activeCategory = categories.find((c) => c.slug === slug) ?? null;
if (!activeCategory) return Astro.redirect("/posts/");

const { posts, total } = await listPosts({ page: 1, categorySlug: slug });
---

<GcmLayout
	title={`${activeCategory.label} — Market Insights | Grant C. Meyer Homes`}
	description={`${activeCategory.label} from Grant C. Meyer: Lake Tahoe luxury real estate in Incline Village and Crystal Bay.`}
	canonical={`${Astro.url.origin}/category/${slug}/`}
>
	<link rel="stylesheet" href="/blog.css" />
	<BlogArchive
		posts={posts}
		total={total}
		page={1}
		perPage={POSTS_PER_PAGE}
		categories={categories}
		activeCategory={activeCategory}
		basePath={`/category/${slug}/`}
	/>
</GcmLayout>
