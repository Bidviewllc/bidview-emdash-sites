			}
			@media (max-width: 767px) {
				.site-announcement { padding: 10px 20px; }
				.site-announcement p { font-size: 14px; }
			}
			/* Client-built Table of Contents list (see inline TOC script above) */
			.astro-toc__body ul.astro-toc__list { list-style: disc; margin: 0; padding-left: 1.25em; }
			.astro-toc__body ul.astro-toc__list ul.astro-toc__list { padding-left: 1.25em; margin: 4px 0; }
			.astro-toc__body .astro-toc__list-item { margin: 6px 0; }
			.astro-toc__body .astro-toc__list-item-text { color: inherit; text-decoration: none; cursor: pointer; }
			.astro-toc__body .astro-toc__list-item-text:hover { text-decoration: underline; }
