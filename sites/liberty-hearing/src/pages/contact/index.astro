---
import Base from "../../layouts/Base.astro";
---

<Base
	title={'Contact | Liberty Hearing Center'}
	description={'Request an appointment or visit Liberty Hearing Center at 2405 Texas Ave South #307, College Station, TX.'}
	active="contact"
	footer="inner"
>
<section style="background:var(--surface-blue)">
<div style="max-width:1280px;margin:0 auto;padding:56px clamp(18px,4vw,32px) clamp(44px,8vw,76px)">
<nav style="display:inline-flex;align-items:center;gap:9px;padding:9px 20px;border-radius:999px;background:var(--white);font-size:13px;font-weight:700;box-shadow:0 2px 10px rgba(var(--navy-rgb),.06)">
<a href="/" style="transition:.3s" style-hover="color:var(--gold)">Home</a><span style="color:var(--text-muted)">/</span>
<span style="color:var(--text-muted)">Contact</span>
</nav>
<div data-stack="2" style="margin-top:34px;display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:60px;align-items:end">
<div>
<span style="display:block;margin-bottom:18px;color:var(--brand-red);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Contact Liberty Hearing Center</span>
<h1 style="margin:0 0 22px;color:var(--navy);font-size:clamp(38px,4.2vw,64px);font-weight:800;line-height:1.04;letter-spacing:-.045em;text-wrap:balance">Start a conversation about better hearing.</h1>
<p style="margin:0;max-width:620px;font-size:19px;line-height:1.7;text-wrap:pretty">Send an appointment request or reach our College Station clinic directly. A real person answers the phone during clinic hours, and we return every message the same business day.</p>
</div>
<div style="display:flex;flex-direction:column;gap:12px">
<a href="tel:9794507996" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px;border-radius:16px;background:var(--white);box-shadow:0 4px 18px rgba(var(--navy-rgb),.07);transition:.3s" style-hover="transform:translateY(-2px);box-shadow:0 14px 34px rgba(var(--navy-rgb),.12)"><span><span style="display:block;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Call the clinic</span><strong style="display:block;margin-top:5px;font-size:21px;font-weight:800;letter-spacing:-.02em">979-450-7996</strong></span><span style="color:var(--brand-red);font-size:20px;font-weight:800">→</span></a>
<a href="#request" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px;border-radius:16px;background:var(--brand-red);color:var(--white);box-shadow:0 4px 18px rgba(var(--brand-red-rgb),.22);transition:.3s" style-hover="background:var(--navy);transform:translateY(-2px);box-shadow:0 14px 34px rgba(var(--navy-rgb),.2)"><span><span style="display:block;color:rgba(var(--white-rgb),.72);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Online scheduling</span><strong style="display:block;margin-top:5px;font-size:19px;font-weight:800;letter-spacing:-.02em">Book Your Appointment</strong></span><span style="font-size:20px;font-weight:800">→</span></a>
</div>
</div>
</div>
</section>
<section id="request" style="background:var(--white);scroll-margin-top:150px">
<div data-stack="2" style="max-width:1280px;margin:0 auto;padding:clamp(49px,8vw,84px) clamp(18px,4vw,32px);display:grid;grid-template-columns:420px minmax(0,1fr);gap:64px;align-items:start">
<aside style="padding:38px 38px 42px;border-radius:20px;background:var(--navy);color:var(--border-strong)">
<span style="display:block;margin-bottom:14px;color:var(--gold-light);font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">College Station clinic</span>
<h2 style="margin:0 0 26px;color:var(--white);font-size:30px;font-weight:800;line-height:1.1;letter-spacing:-.035em">Visit or call us.</h2>
<div style="display:flex;flex-direction:column;gap:24px">
<div>
<strong style="display:block;margin-bottom:6px;color:var(--gold-light);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Address</strong>
<p style="margin:0;color:var(--white);font-size:17px;font-weight:700;line-height:1.55">2405 Texas Ave South #307<br>College Station, TX 77840</p>
<a href="https://maps.google.com/?cid=353508880098481867" target="_blank" rel="noopener" style="display:inline-block;margin-top:8px;color:var(--gold-light);font-size:14px;font-weight:700;border-bottom:1px solid rgba(var(--gold-light-rgb),.5)">Get directions</a>
</div>
<div>
<strong style="display:block;margin-bottom:6px;color:var(--gold-light);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Phone</strong>
<a href="tel:9794507996" style="color:var(--white);font-size:17px;font-weight:700;transition:.3s" style-hover="color:var(--gold-light)">979-450-7996</a>
</div>
<div>
<strong style="display:block;margin-bottom:6px;color:var(--gold-light);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Fax</strong>
<span style="color:var(--white);font-size:17px;font-weight:700">979-426-8260</span>
</div>
<div>
<strong style="display:block;margin-bottom:10px;color:var(--gold-light);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Clinic hours</strong>
<div style="display:flex;flex-direction:column">
<div style="display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-top:1px solid rgba(var(--white-rgb),.16);font-size:15px"><span>Monday</span><span style="color:var(--white);font-weight:700">7:00 am – 6:00 pm</span></div>
<div style="display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-top:1px solid rgba(var(--white-rgb),.16);font-size:15px"><span>Tuesday – Thursday</span><span style="color:var(--white);font-weight:700">8:30 am – 4:30 pm</span></div>
<div style="display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-top:1px solid rgba(var(--white-rgb),.16);font-size:15px"><span>Friday</span><span style="color:var(--white);font-weight:700">Closed</span></div>
<div style="display:flex;justify-content:space-between;gap:18px;padding:9px 0;border-top:1px solid rgba(var(--white-rgb),.16);border-bottom:1px solid rgba(var(--white-rgb),.16);font-size:15px"><span>Saturday – Sunday</span><span style="color:var(--white);font-weight:700">Closed</span></div>
</div>
<p style="margin:12px 0 0;font-size:14px;line-height:1.6">*Office is closed briefly for lunch on Mondays from 11:30 am – 1:30 pm and Tuesday – Thursday from 12:00 pm – 12:30 pm.</p>
<p style="margin:12px 0 0;font-size:14px;line-height:1.6">Same-week appointments are usually available, and we hold time each day for urgent hearing aid repairs.</p>
</div>
</div>
</aside>
<div>
<span style="display:block;margin-bottom:16px;color:var(--brand-red);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Request an appointment</span>
<h2 style="margin:0 0 12px;color:var(--navy);font-size:clamp(28px,2.5vw,40px);font-weight:800;line-height:1.08;letter-spacing:-.04em;text-wrap:balance">Tell us how we can help.</h2>
<p style="margin:0 0 34px;max-width:620px;font-size:18px;line-height:1.7;text-wrap:pretty">Share a few details and our team will follow up with the next best step — no obligation, no pressure.</p>
<form id="request-form" action="/api/contact" method="POST" data-stack="2" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px">
<label style="grid-column:1/3;display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">Full name</span><input type="text" name="name" placeholder="Jane Doe" required autocomplete="name" style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white)"></label>
<label style="display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">Email address</span><input type="email" name="email" placeholder="jane@example.com" required autocomplete="email" style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white)"></label>
<label style="display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">Phone number</span><input type="tel" name="phone" placeholder="(979) 450-7996" autocomplete="tel" style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white)"></label>
<label style="display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">Reason for visit</span><select name="reason" style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white)"><option>Hearing evaluation</option><option>Hearing aid consultation</option><option>Hearing aid repair or cleaning</option><option>VA C&amp;P evaluation</option><option>Something else</option></select></label>
<label style="display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">Preferred time of day</span><select name="time" style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white)"><option>Morning</option><option>Early afternoon</option><option>Late afternoon</option><option>No preference</option></select></label>
<label style="grid-column:1/3;display:flex;flex-direction:column;gap:8px"><span style="font-size:14px;font-weight:700">How can we help?</span><textarea name="message" rows="5" required placeholder="Tell us a little about what you're noticing, or which appointment you'd like." style="padding:14px 16px;border:1px solid var(--border);border-radius:12px;background:var(--white);resize:vertical"></textarea></label>
<div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
<label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
</div>
<div class="cf-turnstile" data-theme="light" style="grid-column:1/-1"></div>
<div style="grid-column:1/3;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
<button type="submit" style="display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:12px 30px;border:1px solid transparent;border-radius:999px;background:var(--brand-red);color:var(--white);font-size:15px;font-weight:750;cursor:pointer;transition:.3s" style-hover="background:var(--navy);transform:translateY(-2px)">Send Request</button>
<span style="color:var(--text-muted);font-size:14px;max-width:380px;line-height:1.55" id="form-status">We reply the same business day. For urgent repairs, please call the clinic.</span>
</div>
</form>
</div>
</div>
</section>
<section id="map" style="background:var(--surface)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(49px,8vw,84px) clamp(18px,4vw,32px)">
<div data-stack="2" style="display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:0;border-radius:20px;overflow:hidden;box-shadow:0 18px 45px rgba(var(--navy-rgb),.11);background:var(--white)">
<div style="min-height:clamp(231px,50vw,420px);background:var(--border)">
<iframe title="Map to Liberty Hearing Center" src="https://maps.google.com/maps?cid=353508880098481867&amp;z=16&amp;output=embed" style="display:block;width:100%;height:100%;min-height:clamp(231px,50vw,420px);border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>
<div style="padding:40px 38px;display:flex;flex-direction:column;gap:22px">
<div style="display:flex;flex-direction:column;gap:10px">
<h2 style="margin:0;color:var(--navy);font-size:26px;font-weight:800;line-height:1.15;letter-spacing:-.03em">Finding us</h2>
<p style="margin:0;color:var(--navy);font-size:16px;font-weight:650;line-height:1.65;text-wrap:pretty">Our office is on the 3rd floor of the PNC Bank building.</p>
</div>
<div><strong style="display:block;margin-bottom:5px;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Parking</strong><p style="margin:0;font-size:15px;line-height:1.7;text-wrap:pretty">Park in the free surface lot that sits directly in front of the building on the side with the USDA and the American flag. Accessible spaces are closest to the entrance.</p></div>
<div><strong style="display:block;margin-bottom:5px;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Directions to Suite 307</strong><p style="margin:0;font-size:15px;line-height:1.7;text-wrap:pretty">Enter through the main lobby and take the elevator to the third floor. Exit the elevator and turn right; our office is the 3rd door on the right.</p></div>
<div><strong style="display:block;margin-bottom:5px;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase">Bringing someone along</strong><p style="margin:0;font-size:15px;line-height:1.7;text-wrap:pretty">A spouse, adult child, or friend is always welcome in the appointment. A second set of ears helps.</p></div>
<a href="https://maps.google.com/?cid=353508880098481867" target="_blank" rel="noopener" style="margin-top:auto;display:inline-flex;align-self:flex-start;min-height:48px;align-items:center;justify-content:center;padding:12px 24px;border:1px solid var(--brand-red);border-radius:999px;color:var(--brand-red);font-size:14px;font-weight:750;transition:.3s" style-hover="background:var(--navy);border-color:var(--navy);color:var(--white);transform:translateY(-2px)">Open in Google Maps</a>
</div>
</div>
<div data-stack="2" style="margin-top:22px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px">
<figure style="margin:0;overflow:hidden;border-radius:18px;box-shadow:0 18px 45px rgba(var(--navy-rgb),.11);transition:.3s" style-hover="transform:translateY(-6px)">
<img src="/assets/building-from-road.webp" alt="The building that houses Liberty Hearing Center, seen from Texas Avenue South" style="display: block; width: 100%; height: 360px; object-fit: cover; object-position: center 55%" loading="lazy" decoding="async">
</figure>
<figure style="margin:0;overflow:hidden;border-radius:18px;box-shadow:0 18px 45px rgba(var(--navy-rgb),.11);transition:.3s" style-hover="transform:translateY(-6px)">
<img src="/assets/entrance.webp" alt="The main entrance patients walk into at 2405 Texas Avenue South" style="display: block; width: 100%; height: 360px; object-fit: cover; object-position: center 60%" loading="lazy" decoding="async">
</figure>
</div>
</div>
</section>
<section id="expect" style="background:var(--white)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(49px,8vw,84px) clamp(18px,4vw,32px)">
<div style="margin-bottom:40px;padding-bottom:22px;border-bottom:1px solid var(--border);display:flex;align-items:flex-end;justify-content:space-between;gap:30px;flex-wrap:wrap">
<h2 style="margin:0;color:var(--navy);font-size:clamp(28px,2.5vw,40px);font-weight:800;line-height:1.08;letter-spacing:-.04em">Before you come in</h2>
<span style="color:var(--text-muted);font-size:14px">Answers to what patients ask most</span>
</div>
<div data-stack="3" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
<article style="display:flex;flex-direction:column;gap:12px;padding:32px clamp(18px,4vw,32px) 36px;border:1px solid var(--border);border-top:4px solid var(--brand-red);border-radius:16px;transition:.3s" style-hover="box-shadow:0 20px 50px rgba(var(--navy-rgb),.11)">
<h3 style="margin:0;color:var(--navy);font-size:21px;font-weight:750;line-height:1.2;letter-spacing:-.025em">How long is a first visit?</h3>
<p style="margin:0;font-size:15px;line-height:1.75;text-wrap:pretty">Plan on about an hour. That covers your hearing history, a full evaluation, and time to talk through the results without rushing.</p>
</article>
<article style="display:flex;flex-direction:column;gap:12px;padding:32px clamp(18px,4vw,32px) 36px;border:1px solid var(--border);border-top:4px solid var(--gold);border-radius:16px;transition:.3s" style-hover="box-shadow:0 20px 50px rgba(var(--navy-rgb),.11)">
<h3 style="margin:0;color:var(--navy);font-size:21px;font-weight:750;line-height:1.2;letter-spacing:-.025em">What should I bring?</h3>
<p style="margin:0;font-size:15px;line-height:1.75;text-wrap:pretty">Your insurance card, a list of current medications, and any hearing aids you already own — even the ones sitting in a drawer.</p>
</article>
<article style="display:flex;flex-direction:column;gap:12px;padding:32px clamp(18px,4vw,32px) 36px;border:1px solid var(--border);border-top:4px solid var(--navy);border-radius:16px;transition:.3s" style-hover="box-shadow:0 20px 50px rgba(var(--navy-rgb),.11)">
<h3 style="margin:0;color:var(--navy);font-size:21px;font-weight:750;line-height:1.2;letter-spacing:-.025em">Do you file insurance?</h3>
<p style="margin:0;font-size:15px;line-height:1.75;text-wrap:pretty">We work with most major plans and VA authorizations, and we'll verify your benefits before your appointment so there are no surprises.</p>
</article>
</div>
</div>
</section>
<section style="background:var(--surface-blue)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(49px,8vw,84px) clamp(18px,4vw,32px);display:flex;flex-direction:column;align-items:center;text-align:center">
<span style="display:block;margin-bottom:16px;color:var(--brand-red);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Prefer to talk it through?</span>
<h2 style="margin:0 0 20px;max-width:820px;color:var(--navy);font-size:clamp(30px,3vw,46px);font-weight:800;line-height:1.06;letter-spacing:-.04em;text-wrap:balance">Call us and we'll find a time that works.</h2>
<p style="margin:0 0 30px;max-width:660px;font-size:18px;line-height:1.75;text-wrap:pretty">One short call is often all it takes to know where to start. We're happy to answer questions before you commit to anything.</p>
<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center">
<a href="tel:9794507996" style="display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:12px 28px;border:1px solid transparent;border-radius:999px;background:var(--brand-red);color:var(--white);font-size:15px;font-weight:750;transition:.3s" style-hover="background:var(--navy);transform:translateY(-2px)">Call 979-450-7996</a>
<a href="#request" style="display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:12px 28px;border:1px solid var(--brand-red);border-radius:999px;background:var(--white);color:var(--brand-red);font-size:15px;font-weight:750;transition:.3s" style-hover="border-color:var(--navy);background:var(--navy);color:var(--white);transform:translateY(-2px)">Request an Appointment</a>
</div>
</div>
</section>
</Base>
