---
// Prerendered to STATIC HTML on purpose (2026-09-10). This page has no
// per-request data — everything on it is hardcoded. Static output is served
// straight from Cloudflare's edge via the ASSETS binding WITHOUT invoking the
// worker, which is what removes the 20s cold start (see CLAUDE.md).
// If this page is ever wired to the CMS, delete this line so it returns to SSR.
export const prerender = true;
import Base from "../../layouts/Base.astro";
---

<Base
	title={'Resources | Liberty Hearing Center'}
	description={'Plain-language articles on hearing loss, hearing aids, insurance, and hearing care from our audiologists.'}
	active="resources"
	footer="resources"
>
<section style="background:var(--surface-blue)">
<div style="max-width:1280px;margin:0 auto;padding:56px clamp(18px,4vw,32px) clamp(44px,8vw,76px)">
<nav style="display:inline-flex;align-items:center;gap:9px;padding:9px 20px;border-radius:999px;background:var(--white);font-size:13px;font-weight:700;box-shadow:0 2px 10px rgba(var(--navy-rgb),.06)">
<a href="/" style="transition:.3s" style-hover="color:var(--gold)">Home</a><span style="color:var(--text-muted)">/</span>
<span style="color:var(--text-muted)">Resources</span>
</nav>
<div style="margin-top:34px">
<div>
<span style="display:block;margin-bottom:18px;color:var(--brand-red);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Hearing resources</span>
<h1 style="margin:0 0 22px;color:var(--navy);font-size:clamp(38px,4.2vw,64px);font-weight:800;line-height:1.04;letter-spacing:-.045em;text-wrap:balance">Straight answers about your hearing.</h1>
<p style="margin:0;max-width:620px;font-size:19px;line-height:1.7;text-wrap:pretty">Plain-language articles from Dr. Duhon and Dr. Hall on hearing loss, hearing aids, insurance, and what to expect at every stage of care.</p>
</div>
</div>
</div>
</section>
<section id="archive" style="background:var(--white)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(44px,7vw,80px) clamp(18px,4vw,32px)">
<h2 style="margin:0 0 8px;color:var(--navy);font-size:clamp(26px,3.2vw,34px);font-weight:800;letter-spacing:-.03em">Articles</h2>
<p style="margin:0 0 34px;max-width:60ch;color:var(--text-body);font-size:17px;line-height:1.7;text-wrap:pretty">Practical guidance on hearing health from our audiologists. More coming soon.</p>
<div data-stack="2" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px">
<a href="/hearing-aids-for-tinnitus/" style="display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:18px;background:var(--white);transition:.3s" style-hover="transform:translateY(-3px);box-shadow:0 20px 45px rgba(var(--navy-rgb),.12)">
<div style="aspect-ratio:16/10;overflow:hidden;background:var(--surface-alt)"><img src="/assets/hearing-aids.webp" alt="An audiologist discussing hearing aid options with two patients at Liberty Hearing Center" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;object-position:center"></div>
<div style="display:flex;flex-direction:column;gap:10px;padding:26px 28px 30px">
<h3 style="margin:0;color:var(--navy);font-size:22px;font-weight:750;line-height:1.25;letter-spacing:-.025em;text-wrap:pretty">Hearing Aids for Tinnitus: Quiet the Ringing, Not the Room</h3>
<p style="margin:0;color:var(--text-body);font-size:15px;line-height:1.7;text-wrap:pretty">Struggling with tinnitus? Liberty Hearing Center in College Station, TX fits hearing aids for tinnitus relief. Book your consultation today.</p>
<span style="margin-top:4px;display:inline-flex;align-items:center;gap:7px;color:var(--brand-red);font-size:15px;font-weight:750">Read article <span aria-hidden="true">&rarr;</span></span>
</div>
</a>
<a href="/best-way-to-clean-ears/" style="display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--border);border-radius:18px;background:var(--white);transition:.3s" style-hover="transform:translateY(-3px);box-shadow:0 20px 45px rgba(var(--navy-rgb),.12)">
<div style="aspect-ratio:16/10;overflow:hidden;background:var(--surface-alt)"><img src="/assets/hearing-test.webp" alt="A patient wearing audiometric headphones during a hearing test at Liberty Hearing Center" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;object-position:center"></div>
<div style="display:flex;flex-direction:column;gap:10px;padding:26px 28px 30px">
<h3 style="margin:0;color:var(--navy);font-size:22px;font-weight:750;line-height:1.25;letter-spacing:-.025em;text-wrap:pretty">Best Way to Clean Ears: What Actually Works</h3>
<p style="margin:0;color:var(--text-body);font-size:15px;line-height:1.7;text-wrap:pretty">Cotton swabs push wax deeper. Learn the best way to clean ears safely, and when it's time to see an audiologist. Liberty Hearing Center, TX.</p>
<span style="margin-top:4px;display:inline-flex;align-items:center;gap:7px;color:var(--brand-red);font-size:15px;font-weight:750">Read article <span aria-hidden="true">&rarr;</span></span>
</div>
</a>
</div>
</div>
</section>
<section style="background:var(--surface-blue)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(49px,8vw,84px) clamp(18px,4vw,32px);display:flex;flex-direction:column;align-items:center;text-align:center">
<span style="display:block;margin-bottom:16px;color:var(--brand-red);font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Have a question we haven't covered?</span>
<h2 style="margin:0 0 20px;max-width:820px;color:var(--navy);font-size:clamp(30px,3vw,46px);font-weight:800;line-height:1.06;letter-spacing:-.04em;text-wrap:balance">Ask us directly — we answer every message.</h2>
<p style="margin:0 0 30px;max-width:660px;font-size:18px;line-height:1.75;text-wrap:pretty">Reading only goes so far. A short conversation with an audiologist will tell you more about your hearing than any article can.</p>
<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center">
<a href="/contact/" style="display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:12px 28px;border:1px solid transparent;border-radius:999px;background:var(--brand-red);color:var(--white);font-size:15px;font-weight:750;transition:.3s" style-hover="background:var(--navy);transform:translateY(-2px)">Book Your Appointment</a>
<a href="tel:9794507996" style="display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:12px 28px;border:1px solid var(--brand-red);border-radius:999px;background:var(--white);color:var(--brand-red);font-size:15px;font-weight:750;transition:.3s" style-hover="border-color:var(--navy);background:var(--navy);color:var(--white);transform:translateY(-2px)">Call 979-450-7996</a>
</div>
</div>
</section>
</Base>
