<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
<a href="/book-appointment/" style="display:inline-flex;min-height:50px;align-items:center;justify-content:center;padding:12px 24px;border:1px solid transparent;border-radius:999px;background:var(--brand-red);color:var(--white);font-size:14px;font-weight:750;transition:.3s" style-hover="background:var(--white);color:var(--navy-deep);transform:translateY(-2px)">Book Your Appointment</a>
<a href="#services" style="display:inline-flex;min-height:50px;align-items:center;justify-content:center;padding:12px 24px;border:1px solid rgba(var(--white-rgb),.45);border-radius:999px;background:transparent;color:var(--white);font-size:14px;font-weight:750;transition:.3s" style-hover="border-color:var(--white);background:var(--white);color:var(--navy-deep);transform:translateY(-2px)">Explore Audiology Services</a>
</div>
</div>
</div>
</div>
