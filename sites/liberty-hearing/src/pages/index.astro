<section id="faq" style="background:var(--white)">
<div data-stack="2" style="max-width:1280px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(18px,4vw,32px);display:grid;grid-template-columns:.62fr 1.38fr;gap:70px;align-items:start">
