---
// Prerendered to STATIC HTML on purpose (2026-09-10). This page has no
// per-request data — everything on it is hardcoded. Static output is served
// straight from Cloudflare's edge via the ASSETS binding WITHOUT invoking the
// worker, which is what removes the 20s cold start (see CLAUDE.md).
// If this page is ever wired to the CMS, delete this line so it returns to SSR.
export const prerender = true;
import Base from "../layouts/Base.astro";

/**
 * The blog section is Lorem ipsum placeholder copy with empty "Article image"
 * boxes — no real posts exist yet. Hidden 2026-09-08 on Vince's instruction.
 *
 * This is a build-time flag, NOT display:none, deliberately: display:none would
 * still ship the Lorem ipsum in the HTML where crawlers can read it. Flip to
 * true once there are real articles.
 */
const SHOW_BLOG = false;

/**
 * The three testimonials are Lorem ipsum with invented names ("Lorem I.",
 * "Dolor S.", "Amet C."). Asked to replace them from Google Business Profile
 * on 2026-09-08 — but the GBP (cid 353508880098481867) has ZERO reviews, and
 * libertyhearingcentertx.com is a 3KB placeholder with none either. There is no
 * real source, and inventing patient testimonials for a medical practice is not
 * an option. Hidden until Erika/the client supplies real ones.
 */
const SHOW_TESTIMONIALS = false;
---

<Base
	title={'Liberty Hearing Center | Audiologists & Hearing Aids in College Station, TX'}
	description={'Locally owned audiology practice in College Station, TX. Hearing evaluations, hearing aids, pediatric testing, and VA C&P exams.'}
	active="home"
	footer="home"
>
<section data-hero-photo="1" style="position:relative;overflow:hidden;background:var(--navy-deep)">
<img data-hero-img="1" src="/assets/hero-team.webp" alt="The Liberty Hearing Center team" style="position: absolute; top: 0; right: 0; width: 70%; height: 100%; object-fit: cover; object-position: right center">
<div data-hero-scrim="dark" style="position:relative;background:linear-gradient(90deg,var(--navy-deep) 0%,var(--navy-deep) 33%,rgba(var(--navy-deep-rgb),.82) 44%,rgba(var(--navy-deep-rgb),.28) 55%,rgba(var(--navy-deep-rgb),0) 64%)">
<div style="max-width:1280px;margin:0 auto;padding:clamp(48px,8vw,96px) clamp(18px,4vw,32px);min-height:clamp(420px,44vw,600px);display:flex;flex-direction:column;justify-content:center">
