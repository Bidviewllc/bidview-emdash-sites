<section id="standards-band" style="background:var(--navy);color:var(--white)">
<div data-stack="2" style="max-width:1280px;margin:0 auto;padding:clamp(26px,5vw,44px) clamp(18px,4vw,32px);display:grid;grid-template-columns:.62fr 1.38fr;gap:clamp(24px,4vw,56px);align-items:center">
<span style="display:block;color:var(--white);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase">Trusted Standards of Care</span>
<!-- NOT data-stack: with three logos that rule collapses to 2 columns at <=1080px
     and orphans NHCA bottom-left against a dead gap. A wrapping flex row with
     space-around keeps them spread on desktop and centres any wrapped row.
     Logo heights are deliberately unequal (64/58/55) for OPTICAL balance: NHCA is huge caps, AAA is three small stacked lines. Equal heights read badly. ASHA ships grey (luminance .67) not white, hence the brightness filter. -->
<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-around;gap:clamp(24px,4vw,40px)">
<img src="/assets/aaa-logo-white.webp" alt="American Academy of Audiology" loading="lazy" width="600" height="199" style="display:block;width:auto;max-width:100%;object-fit:contain;height:64px">
