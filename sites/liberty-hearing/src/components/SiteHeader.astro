---
/**
 * Site header — shared across all pages.
 *
 * The markup is identical on every page in the design build; only the current
 * nav item is highlighted. That highlight is driven by `active` + a CSS rule
 * (see global.css) rather than by patching inline styles per page.
 *
 * Contains both the desktop mega-menu grid ([data-hdrgrid]) and the mobile
 * bar ([data-mobilebar]); global.css swaps between them at 1050px.
 */
interface Props {
  /** Which top-level nav item to highlight. */
  active?: "home" | "about" | "services" | "aids" | "resources" | "contact";
}
const { active } = Astro.props;
