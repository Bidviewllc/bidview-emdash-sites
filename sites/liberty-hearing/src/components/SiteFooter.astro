---
/**
 * Site footer.
 *
 * The design build ships SEVEN different footers across the 11 pages — they
 * differ in tagline, column order, column headings and links. Vince asked for
 * exact parity with the Vercel demo, so each variant is reproduced verbatim
 * here rather than unified.
 *
 * NOTE: this deliberately preserves the design's dead href="#" links
 * (5 on inner/services, 7 on aids). Do not 'fix' them without asking — they
 * are intentional parity with the demo. See CLAUDE.md.
 *
 * Variant -> pages:
 *   home      home
 *   inner     about, hearing-evaluations, contact
 *   services  services
 *   aids      phonak-hearing-aids
 *   pricing   pricing
 *   resources resources
 *   staff     dr-carly-hall, dr-chris-duhon, rocio-zarandona
 */
interface Props {
	variant?: "home" | "inner" | "services" | "aids" | "pricing" | "resources" | "staff";
}
const { variant = "inner" } = Astro.props;
