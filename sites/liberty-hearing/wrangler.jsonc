{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "liberty-hearing",
	"account_id": "239e9d015c7a3a39cdc2e9400312f553",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "liberty-hearing-db",
			"database_id": "c6fbfd7c-5c0f-42fc-9ff2-00dccd78892a",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "liberty-hearing-media",
		},
	],
	// Shared SESSION namespace, same as every other Bidview emdash site
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "028dfa4da881449cb1fcfb8ae46b6e2e",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Every minute — KEEP-WARM, not housekeeping (Vince's call 2026-09-10).
	// `/api/contact` is the only user-facing route that still runs this Worker,
	// and on a cold isolate that POST took ~5s. src/worker.ts runs emdash's real
	// housekeeping ONLY at :00; the other 59 ticks return immediately and exist
	// purely to keep an isolate alive. Note this reverses the earlier "dialled
	// back to hourly" decision, which predates the form being the only live
	// worker route. Only warms ONE location — see the comment in worker.ts.
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": { "enabled": true },
	// Smart Placement REMOVED 2026-09-10 (Vince's call). It runs the worker near
	// backend services rather than near the visitor, so a cold start is paid at a
	// remote location. This site makes almost no D1 calls and its pages are now
	// prerendered static, so placement was pure added latency. See CLAUDE.md.
	"workers_dev": true,
}
