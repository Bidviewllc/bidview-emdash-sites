{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Hearing Solutions of North Carolina: a copy of the Entheos audiology
	// template, reskinned to the HSNC design. Bidview account.
	//
	// EmDash passkeys belong to one hostname: run the admin setup wizard on
	// https://hearing-solutions-nc.cameron-239.workers.dev and log in there.
	// Version preview URLs show the site but can't log in to the admin.
	//
	// D1, R2 and KV created 2026-10-19 on the Bidview account.
	"name": "hearing-solutions-nc",
	"account_id": "239e9d015c7a3a39cdc2e9400312f553",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hearing-solutions-nc-db",
			"database_id": "deca6516-706c-4a38-a128-d8b75e6cf038"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "hearing-solutions-nc-media"
		}
	],
	// Astro sessions (EmDash keeps the signed-in admin here).
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3ae5356d3333474b81b80a9aea2c31a6"
		}
	],
	// Hourly EmDash housekeeping (scheduled publishing, cleanup).
	"triggers": {
		"crons": ["0 * * * *"]
	},
	// Workers AI: the spam check on form submissions (src/pages/api/form.ts).
	"ai": { "binding": "AI" },
	// The hostname admin passkeys belong to.
	"vars": {
		"EMDASH_SITE_URL": "https://hearing-solutions-nc.cameron-239.workers.dev"
	},
	"observability": { "enabled": true }
}
