{
  "name": "Audiology Template · Design 1 (Nested panels)",
  "practiceColors": {
    "note": "Three colours per practice. Everything else is derived. Text-on-colour values are computed (see colorLogic).",
    "roles": {
      "primary": "Buttons, links (as primaryInk), eyebrow squares, Primary hero and CTA panels",
      "accent": "Tints (hover, icon circles, tags), underlines, stars",
      "light": "Light background bands and no-photo Light hero"
    },
    "presets": {
      "Teal / Amber": { "primary": "#0F5E6B", "accent": "#E0A33B", "light": "#F6F1EA" },
      "Navy / Coral": { "primary": "#1E3A5F", "accent": "#E8735A", "light": "#EEF3F8" },
      "Forest / Gold": { "primary": "#2F5D3A", "accent": "#C9A227", "light": "#F7F4EC" }
    },
    "derived": {
      "onPrimary": "white or ink, whichever has higher contrast on primary",
      "onAccent": "white or ink on accent",
      "onLight": "white or ink on light",
      "primaryInk": "primary darkened in 8% steps until it reaches 4.5:1 on white (used for link text)",
      "primaryHover": "color-mix(primary 80%, black)",
      "accentTint": "color-mix(accent 24%, white)",
      "accentTint2": "color-mix(accent 40%, white)"
    }
  },
  "neutrals": {
    "ink": "#1B1F23",
    "mute": "#555B62",
    "line": "#DCDCD8",
    "panel": "#EFEFED",
    "panel2": "#E6E6E3",
    "white": "#FFFFFF",
    "inputBorder": "#C8C8C3",
    "placeholder": "#6E747A",
    "error": "#B42318"
  },
  "fonts": {
    "heading": "Plus Jakarta Sans (500, 600)",
    "body": "Atkinson Hyperlegible Next (400, 600, 700)",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
  },
  "type": {
    "h1": { "desktop": "500 52px/1.1 heading", "xl": "64px", "mobile": "34px (xl 38px)" },
    "h2": { "desktop": "500 40px/1.15 heading", "mobile": "30px" },
    "h3": { "desktop": "500 26px/1.25 heading", "mobile": "23px" },
    "h4": { "desktop": "600 21px/1.3 heading" },
    "lead": { "desktop": "20px/1.55 body, mute", "mobile": "18px" },
    "body": "18px/1.6 body (desktop AND mobile; never smaller)",
    "small": "16px/1.5 (dates, captions only; never below 15px)",
    "eyebrow": "700 15px body, uppercase, +0.14em, 8px Primary square before",
    "nav": "700 17px body (the one exception to 18px)",
    "button": "700 18px body"
  },
  "spacing": { "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128], "panelPad": "16px desktop, 12px mobile", "sectionBand": "112px desktop, 56px mobile", "insetBand": "104px desktop, 48px mobile", "container": "1200px max, 16px side gutter on mobile" },
  "radii": { "panel": "28px (24px mobile)", "card": "16px", "small": "12px", "pill": "999px", "nestedRule": "inner radius = outer radius minus the gap between them" },
  "controls": { "button": "min-height 52px, padding 0 26px, pill", "buttonSmall": "min-height 48px", "input": "min-height 56px, 2px border, radius 14px", "tapTarget": "48px minimum everywhere", "focus": "3px outline, ink, 2-3px offset" },
  "breakpoints": { "mobileDesign": "390px", "suggested": "mobile layout up to ~1024px (tablet not designed yet)" }
