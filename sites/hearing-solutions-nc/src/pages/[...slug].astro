---
// Anything without a page of its own: patient resources kept at their live-site
// address (src/lib/resource-paths.ts, e.g. /hearing-services/ear-wax-removal) get the
// resource page; everything else gets the 404 page.
import NotFound from "../components/NotFound.astro";
import ResourcePage from "../components/ResourcePage.astro";
import { resourceAt } from "../lib/resource-paths";

const keptSlug = resourceAt(`/${Astro.params.slug ?? ""}`);
const kept = keptSlug ? Astro.locals.site.resources.find((x) => x.slug === keptSlug && x.page) : undefined;
---
{kept ? <ResourcePage r={kept} /> : <NotFound />}
