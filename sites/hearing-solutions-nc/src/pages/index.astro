---
// Home (design/hsnc/Main.dc.html). Photo hero → navy stats strip → "Is keeping
// up wearing you out?" (intro, photo + green card, navy panel, services teaser,
// photo grid) → What to expect → reviews → investment + FAQ → location →
// "Connection is our mission". Text, lists and photos: Pages → Home page
// (src/data/hsnc/home.ts has the design's wording).
// Not on this design (template Home): trust bar, about teaser, team, brands,
// latest posts.
import HsFaq from "../components/hs/HsFaq.astro";
import HsLocation from "../components/hs/HsLocation.astro";
import HsReviews from "../components/hs/HsReviews.astro";
import Base from "../layouts/Base.astro";
import { hs } from "../lib/hs";
import { routes, telHref } from "../lib/routes";

const { text, html, htmlParas, list, photo, hero, inline, s } = hs(Astro, "home");
const h = s.href;
const tel = telHref(s.phone);
const callLabel = `Call us: ${s.phone}`;
const bg = hero();
const stats = list("home_stats");
const faq = list("home_faq");
const half = Math.ceil(faq.length / 2);
const steps = list("home_steps");
const stepPhotos = [photo("home_step_1"), photo("home_step_2"), photo("home_step_3")];
const mosaic = [1, 2, 3, 4, 5, 6].map((n) => photo(`home_mosaic_${n}`));
const problemParas = htmlParas("home_problem_text");
const img = (p: ReturnType<typeof photo>, style: string) => (p ? { src: p.src, alt: p.alt, style } : undefined);
const tile = [
	{ a: "height:240px;object-position:40% 30%", b: "height:auto;aspect-ratio:1/1;object-position:50% 50%" },
	{ a: "height:auto;aspect-ratio:1/1;object-position:50% 30%", b: "height:260px;object-position:50% 50%" },
	{ a: "height:240px;object-position:50% 30%", b: "height:auto;aspect-ratio:1/1;object-position:35% 50%" },
];
/** Stat icons, in order (design): calendar, star, hourglass. */
const STAT_ICONS = [
	{ vb: "0 0 1000 1000", size: 38, d: "M 250 124.489 L 250 166 229.461 166 C 204.325 166, 192.024 167.260, 181.271 170.935 C 153.027 180.588, 130.526 207.103, 126.055 236 C 125.188 241.601, 124.971 320.236, 125.197 546.500 L 125.500 849.500 128.726 859 C 133.377 872.698, 138.055 880.039, 149.500 891.604 C 159.849 902.061, 166.580 906.694, 178.136 911.318 C 191.739 916.759, 195.824 917, 274.631 917 L 347 917 347 875 L 347 833 278 833 L 209 833 209 625 L 209 417 499.994 417 L 790.989 417 791.244 500.250 L 791.500 583.500 833.250 583.761 L 875 584.022 875 412.599 C 875 226.854, 875.216 234.544, 869.574 219.586 C 863.829 204.356, 848.670 186.646, 833.832 177.831 C 818.280 168.591, 804.416 166, 770.539 166 L 750 166 750 124.489 L 750 82.978 708.250 83.239 L 666.500 83.500 666.239 124.750 L 665.978 166 500 166 L 334.022 166 333.761 124.750 L 333.500 83.500 291.750 83.239 L 250 82.978 250 124.489 M 209 291.500 L 209 333 500 333 L 791 333 791 291.500 L 791 250 500 250 L 209 250 209 291.500 M 445 679.097 C 419.425 688.403, 393.438 697.863, 387.250 700.118 L 376 704.218 376 726.109 C 376 738.149, 376.362 748, 376.805 748 C 377.248 748, 391.986 742.832, 409.555 736.516 C 427.125 730.200, 441.837 725.025, 442.250 725.016 C 442.663 725.007, 443 770.900, 443 827 L 443 929 469.004 929 L 495.007 929 494.754 795.764 C 494.530 678.202, 494.324 662.507, 493 662.352 C 492.175 662.255, 470.575 669.790, 445 679.097 M 612.882 662.244 C 612.661 662.723, 597.293 797.499, 597.436 797.706 C 597.514 797.819, 606.657 800.109, 617.753 802.794 L 637.928 807.677 642.684 803.746 C 652.474 795.657, 662.977 792.499, 677.500 793.280 C 704.173 794.713, 718.034 811.463, 717.983 842.197 C 717.951 861.206, 713.468 874.629, 704.380 882.935 C 696.218 890.396, 684.678 893.366, 672.606 891.114 C 656.058 888.027, 645.391 877.731, 641.643 861.227 L 640.342 855.500 615.421 855.500 L 590.500 855.500 590.825 860.500 C 592.085 879.918, 602.930 899.789, 619.227 912.540 C 651.092 937.473, 702.866 939.501, 735.360 917.089 C 751.541 905.929, 763.217 886.438, 767.569 863.326 C 770.052 850.137, 769.132 825.980, 765.637 812.628 C 757.987 783.399, 741.468 765.571, 714.473 757.407 C 706.415 754.970, 703.868 754.684, 689.500 754.597 C 672.355 754.493, 666.861 755.549, 653.277 761.556 L 647.787 763.984 648.307 761.742 C 648.593 760.509, 650.082 747.466, 651.616 732.759 L 654.406 706.017 707.453 705.759 L 760.500 705.500 760.500 684 L 760.500 662.500 686.750 662.244 C 646.188 662.103, 612.947 662.103, 612.882 662.244 M 879 744 L 879 780 845.500 780 L 812 780 812 803.500 L 812 827 845.500 827 L 879 827 879 864.500 L 879 902 903.500 902 L 928 902 928 864.500 L 928 827 961.500 827 L 995 827 995 803.500 L 995 780 961.500 780 L 928 780 928 744 L 928 708 903.500 708 L 879 708 879 744", evenodd: true },
	{ vb: "0 -960 960 960", size: 36, d: "m354-287 126-76 126 77-33-144 111-96-146-13-58-136-58 135-146 13 111 97-33 143ZM233-120l65-281L80-590l288-25 112-265 112 265 288 25-218 189 65 281-247-149-247 149Zm247-350Z" },
	{ vb: "0 -960 960 960", size: 36, d: "M320-160h320v-120q0-66-47-113t-113-47q-66 0-113 47t-47 113v120Zm273-407q47-47 47-113v-120H320v120q0 66 47 113t113 47q66 0 113-47ZM160-80v-80h80v-120q0-61 28.5-114.5T348-480q-51-32-79.5-85.5T240-680v-120h-80v-80h640v80h-80v120q0 61-28.5 114.5T612-480q51 32 79.5 85.5T720-280v120h80v80H160Z" },
];
const problemPhoto = photo("home_problem_photo");
const investPhoto = photo("home_invest_photo");
const closingPhoto = photo("home_closing_photo");
---
<Base title={`${s.name} | Audiologists in ${Astro.locals.site.practice.city}`} description={text("intro")} pageName="Home">
	<div class="hs">
		<section class="hs-home-hero" style={bg ? `--hero-img:url('${bg.src}')` : undefined}>
			<div class="hs-wrap" style="padding-top:150px;padding-bottom:170px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px;color:#fff">
				<h1 class="hs-eyebrow" style="color:#fff">{text("heading")}</h1>
				<p class="hs-serif hs-display" style="margin:0;line-height:1.1;color:#fff" set:html={html("home_display")} />
				{htmlParas("intro").map((p) => <p style="margin:0;font-size:20px" set:html={p} />)}
				<a class="hs-btn hs-btn-w" href={tel} style="margin-top:16px">{callLabel}</a>
			</div>
		</section>

		<section class="on-dark hs-navy">
			<div class="hs-wrap" style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;padding-top:32px;padding-bottom:32px">
				{
					stats.slice(0, 3).map((st, i) => (
						<>
							{i > 0 && <span class="hs-stat-div" aria-hidden="true" />}
							<div class="hs-stat">
								<span class="hs-stat-ic" aria-hidden="true">
									<svg width={STAT_ICONS[i].size} height={STAT_ICONS[i].size} viewBox={STAT_ICONS[i].vb} fill="#134C1F" aria-hidden="true"><path fill-rule={STAT_ICONS[i].evenodd ? "evenodd" : undefined} d={STAT_ICONS[i].d} /></svg>
								</span>
								<span style="line-height:1.3"><b style="font-size:20px;font-weight:500">{st.n}</b><br /><span style="font-size:15px">{st.t}</span></span>
							</div>
						</>
					))
				}
			</div>
		</section>

		<section class="hs-wrap" style="padding-top:96px;padding-bottom:56px;display:flex;flex-direction:column;gap:56px">
			<div style="max-width:640px;margin:0 auto;text-align:center">
				<h2 class="hs-h2-sm" style="margin:0 0 20px;font-weight:500">{text("home_problem_heading")}</h2>
				{problemParas.map((p, i) => <p style={i < problemParas.length - 1 ? "margin:0 0 20px" : "margin:0"} set:html={p} />)}
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:24px">
				{problemPhoto && <img class="hs-img" src={problemPhoto.src} alt={problemPhoto.alt} style="flex:1 1 380px;min-width:0;height:414px;align-self:center;object-position:50% 40%" />}
				<div class="hs-card" style="flex:1 1 380px;padding:40px;display:flex;flex-direction:column;justify-content:center;gap:16px">
					<p set:html={html("home_card_intro")} />
					<ul style="margin:0;padding-left:24px;display:flex;flex-direction:column;gap:4px">{list("home_card_list").map((x) => <li set:html={inline(x.t)} />)}</ul>
					{htmlParas("home_card_text").map((p) => <p set:html={p} />)}
					<p style="padding-left:18px;border-left:3px solid var(--hs-lime);font-size:20px;font-weight:500;line-height:1.4" set:html={html("home_card_callout")} />
				</div>
			</div>
			<div class="on-dark hs-navy" style="border-radius:14px;padding:56px 32px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
				<h2 class="hs-serif" style="margin:0;line-height:1.15" set:html={html("home_panel_heading")} />
				{htmlParas("home_panel_text").map((p) => <p style="margin:0;max-width:620px;text-align:center" set:html={p} />)}
				<div class="hs-btns" style="justify-content:center;margin-top:8px"><a class="hs-btn hs-btn-w" href={tel}>{callLabel}</a><a class="hs-btn hs-btn-ow" href={h(routes.about)}>Meet your team</a></div>
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:24px;align-items:stretch">
				<div style="flex:1 1 220px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;text-align:center">
					<p set:html={html("home_services_text")} />
					<a class="hs-btn hs-btn-o" href={h(routes.services)}>View all services</a>
				</div>
				{
					list("home_services_cards").map((c) => (
						<a href={h(c.href || routes.services)} class="hs-card hs-svc-card">
							<span style="font-size:19px;font-weight:500">{c.t}</span>
							<span class="hs-eyebrow" style="font-size:15px;letter-spacing:.1em">Read more</span>
						</a>
					))
				}
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:24px">
				{
					tile.map((t, i) => {
						const a = img(mosaic[i * 2], t.a);
						const b = img(mosaic[i * 2 + 1], t.b);
						return (
							<div style="flex:1 1 280px;display:flex;flex-direction:column;gap:24px">
								{a && <img class="hs-img" src={a.src} alt={a.alt} style={a.style} loading="lazy" />}
								{b && <img class="hs-img" src={b.src} alt={b.alt} style={b.style} loading="lazy" />}
							</div>
						);
					})
				}
			</div>
		</section>

		<section class="hs-mint hs-sec">
			<div class="hs-wrap" style="display:flex;flex-direction:column;gap:40px">
				<div style="text-align:center"><h2 class="hs-serif" style="margin:0 0 12px;line-height:1.15">{text("home_expect_heading")}</h2><p>{text("home_expect_intro")}</p></div>
				<ol style="list-style:none;margin:0 auto;padding:0;max-width:760px;display:flex;flex-direction:column;gap:24px">
					{
						steps.map((st, i) => (
							<li class="on-dark hs-navy" style="border-radius:10px;padding:28px;display:flex;flex-wrap:wrap;gap:24px;align-items:center">
								{stepPhotos[i] && <img src={stepPhotos[i]!.src} alt={stepPhotos[i]!.alt} style="width:150px;height:150px;border-radius:50%;object-fit:cover;flex:none;display:block" loading="lazy" />}
								<div style="flex:1 1 300px"><h3 style="margin:0 0 8px;font-weight:600">{st.t}</h3><p set:html={inline(st.d)} /></div>
							</li>
						))
					}
				</ol>
				<div class="hs-card" style="width:100%;max-width:760px;margin:0 auto;padding:32px 28px;border-radius:10px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px">
					{htmlParas("home_expect_cta").map((p) => <p style="max-width:560px;text-align:left" set:html={p} />)}
					<div class="hs-btns" style="justify-content:center"><a class="hs-btn" href={tel}>{callLabel}</a><a class="hs-btn hs-btn-o" href={h(routes.resources)}>New patient information</a></div>
				</div>
			</div>
		</section>

		<HsReviews heading={text("home_reviews_heading")} />

		<section class="hs-wrap" style="padding-top:96px;padding-bottom:96px;display:flex;flex-direction:column;gap:56px">
			<div style="display:flex;flex-wrap:wrap;gap:40px;align-items:center">
				<div style="flex:1 1 280px;display:flex;flex-direction:column;gap:16px">
					<h2 class="hs-serif" style="margin:0;line-height:1.1">{text("home_invest_heading")}</h2>
					{htmlParas("home_invest_text").map((p) => <p set:html={p} />)}
					<a href={h(`${routes.resources}#investment`)} class="hs-eyebrow" style="font-size:15px;letter-spacing:.1em;text-decoration:none">{text("home_invest_link")}</a>
				</div>
				{investPhoto && <img class="hs-img" src={investPhoto.src} alt={investPhoto.alt} style="flex:2 1 460px;min-width:0;height:480px;object-position:50% 30%" loading="lazy" />}
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:24px;align-items:stretch">
				<div class="hs-card" style="flex:1 1 380px;padding:32px">
					<h2 style="margin:0 0 12px;font-size:20px;line-height:1.3;font-weight:500;font-family:var(--hs-sans)">{text("home_faq_heading")}</h2>
					<HsFaq items={faq.slice(0, half)} />
				</div>
				<div class="hs-card" style="flex:1 1 380px;padding:32px"><HsFaq items={faq.slice(half)} /></div>
			</div>
			<div class="on-dark hs-qbar">
				<h2 class="hs-serif" style="margin:0;font-size:32px;line-height:1.2">{text("home_qbar_heading")}</h2>
				<div class="hs-btns" style="gap:12px"><a class="hs-btn hs-btn-ow" href={h(`${routes.contact}#message`)}>Ask another question</a><a class="hs-btn hs-btn-w" href={tel}>{callLabel}</a></div>
			</div>
		</section>

		<HsLocation heading={text("home_location_heading")} />

		<div class="on-dark hs-navy">
			<section class="hs-wrap" style="padding-top:88px;padding-bottom:88px;display:flex;flex-wrap:wrap;gap:40px;align-items:center">
				{closingPhoto && <img class="hs-img" src={closingPhoto.src} alt={closingPhoto.alt} style="flex:1 1 440px;min-width:0;height:520px;object-position:50% 38%" loading="lazy" />}
				<div style="flex:1 1 320px;display:flex;flex-direction:column;gap:16px;align-items:flex-start">
					<h2 class="hs-serif" style="margin:0;line-height:1.1" set:html={html("home_closing_heading")} />
					{htmlParas("home_closing_text").map((p) => <p set:html={p} />)}
					<a class="hs-btn hs-btn-w" href={tel} style="margin-top:8px">{callLabel}</a>
				</div>
			</section>
		</div>
	</div>
</Base>
