---
// Blog post (template Page 13, HSNC reskin; no HSNC board). Light green header
// (category label, serif H1, byline; the featured image on the right when the
// post has one) → article with a mid-article call box, then the author box →
// sticky sidebar with the call card and recent articles → related articles →
// the shared closing band. Dropped from the template: breadcrumbs, image
// placeholders, the sample author text, Book buttons (the phone instead).
import "../../styles/hsnc-reskin.css";
import HsCtaBand from "../../components/hs/HsCtaBand.astro";
import HsIcon from "../../components/hs/HsIcon.astro";
import PostCard from "../../components/PostCard.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import Base from "../../layouts/Base.astro";
import { ptHas, ptParts } from "../../lib/portable-text";
import { getSettings } from "../../lib/settings";
import { routes, telHref } from "../../lib/routes";

const { articleBody, featured, posts, providers } = Astro.locals.site;

const post = [featured, ...posts].find((p) => p.slug === Astro.params.slug);
if (!post) return Astro.rewrite("/404");

const tweaks: Tweak[] = [
	{ key: "image", label: "Featured image", type: "bool", default: true },
	{ key: "authorlink", label: "Author profile linked", type: "bool", default: true },
];
const s = getSettings(Astro);
const h = s.href;
const tel = telHref(s.phone);
const image = s.bool("image", true) ? post.image : undefined;
const authorLinked = s.bool("authorlink", true);
/** The team member who wrote it, when the byline matches one. */
const author = providers.find((p) => p.name === post.author);
const authorHref = author && authorLinked && author.hasPage ? h(routes.provider(author.slug)) : undefined;
const recent = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const related = posts.filter((p) => p.slug !== post.slug && p.catSlug === post.catSlug).concat(posts.filter((p) => p.catSlug !== post.catSlug)).slice(0, 3);
const midCta = `<aside class="mid-cta" aria-label="Call us"><span class="mc-ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></span><div class="stack g12"><p class="mc-t">Not sure where your hearing stands? Book a hearing evaluation.</p><a class="hs-btn hs-btn-w" href="${tel}" style="align-self: flex-start">Call us: ${s.phone}</a></div></aside>`;
/** The article from EmDash (call box before the third H2, or halfway); the sample body until there is one. */
const body = (() => {
	if (!ptHas(post.content)) return articleBody.map((b) => (b === "MIDCTA" ? midCta : b)).join("\n");
	const { parts } = ptParts(post.content);
	const h2s = parts.map((p, i) => (p.h2 ? i : -1)).filter((i) => i > 0);
	const at = h2s.length >= 3 ? h2s[2] : Math.ceil(parts.length / 2);
	return s.fill([...parts.slice(0, at).map((p) => p.html), midCta, ...parts.slice(at).map((p) => p.html)].join("\n"));
})();
---
<Base title={`${post.title} | ${s.name}`} description={post.summary} pageName="Blog post" current="blog" tweaks={tweaks}>
	<div class="hs">
		<article>
			<header class="hs-mint rs-hero">
				<div class="hs-wrap hs-hsplit">
					<div class="hs-htxt rs-htxt">
						<a class="hs-eyebrow" href={h(routes.category(post.catSlug))} style="color:var(--hs-green);text-decoration:none;min-height:44px;display:inline-flex;align-items:center">{post.cat}</a>
						<h1 class="hs-serif rs-h1" style="font-size:clamp(34px,4.2vw,48px)">{post.title}</h1>
						<div class="rs-byline">
							{author?.headshot && <img src={author.headshot} alt="" />}
							<div style="display:flex;flex-direction:column;gap:2px">
								<span>By {authorHref ? <a href={authorHref}>{post.author}</a> : <b>{post.author}</b>}</span>
								<span class="by-meta"><time datetime={post.iso}>{post.date}</time></span>
							</div>
						</div>
					</div>
					{image && <div class="hs-hpic"><img class="rs-post-img" src={image} alt="" /></div>}
				</div>
			</header>

			<div class="hs-wrap rs-sec">
				<div class="rs-side">
					<div class="rs-stack" style="gap:64px">
						<div class="rt" set:html={body} />
						{
							author && (
								<div class="rs-author">
									{author.headshot && <img src={author.headshot} alt="" />}
									<div class="rs-htxt" style="gap:8px">
										<p class="hs-eyebrow">About the author</p>
										<h2 class="hs-h3-sm" style="font-weight:600">{author.name}</h2>
										<p class="muted">{author.title}</p>
										{authorHref && <a class="rs-more" href={authorHref}>View {author.short}’s profile <HsIcon name="arrow" size={18} /></a>}
									</div>
								</div>
							)
						}
					</div>
					<aside class="hs-aside" aria-label="Call us and recent articles">
						<div class="hs-callbox">
							<h2 class="hs-serif">Book a hearing evaluation</h2>
							<p>Call us and we’ll find a time that works for you.</p>
							<a class="hs-btn hs-btn-w" href={tel}>Call us: {s.phone}</a>
						</div>
						{
							recent.length > 0 && (
								<div class="rs-scard" style="gap:8px">
									<h2 style="margin-bottom:6px">Recent articles</h2>
									{recent.map((p) => (
										<a class="mini-post" href={h(routes.post(p.slug))}>
											{p.image ? <img src={p.image} alt="" style="width:72px;height:72px;object-fit:cover" loading="lazy" /> : <div class="hs-ph" style="width:72px;height:72px;border-radius:8px;background:#fff" />}
											<div style="display:flex;flex-direction:column;gap:2px"><span class="date">{p.date}</span><b>{p.title}</b></div>
										</a>
									))}
								</div>
							)
						}
					</aside>
				</div>
			</div>
		</article>

		{
			related.length > 0 && (
				<section class="hs-mint">
					<div class="hs-wrap rs-sec rs-stack">
						<div class="rs-shead">
							<div class="rs-head"><p class="hs-eyebrow">Keep reading</p><h2 class="hs-serif">Related articles</h2></div>
							<a class="rs-more" href={h(routes.blog)}>All articles <HsIcon name="arrow" size={18} /></a>
						</div>
						<div class="grid g-3 posts-grid" style="gap: 32px">{related.map((p) => <PostCard p={p} />)}</div>
					</div>
				</section>
			)
		}
		<HsCtaBand />
	</div>
</Base>
