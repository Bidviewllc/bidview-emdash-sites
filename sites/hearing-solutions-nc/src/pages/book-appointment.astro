---
// Book appointment. No HSNC board; built from the HSNC parts in the Contact
// board's look. Split hero → navy "call us" bar (HSNC books by phone) →
// appointment request form beside the office card. Text: Pages → Book
// appointment (src/data/hsnc/book.ts). Form fields: Plugins → Forms →
// Appointment request.
// Liz, 2026-10-19: request form only (template Version B), full width. Not on
// this page (template Book appointment): breadcrumbs, the scheduler embed
// (Version A), the right-sidebar layout and the "Where to find us" band.
import "../styles/hsnc-contact.css";
import ContactOffice from "../components/hs/ContactOffice.astro";
import HsPageHero from "../components/hs/HsPageHero.astro";
import SiteForm from "../components/SiteForm.astro";
import Base from "../layouts/Base.astro";
import { hs } from "../lib/hs";
import { telHref } from "../lib/routes";

const { text, html, htmlParas, photo, s } = hs(Astro, "book-appointment");
const o = s.offices[0];
const description = `Request an appointment at ${s.name}, or call ${s.phone}. ${o.street}, ${o.city}.`;
---
<Base title={`Book an appointment | ${s.name}`} description={description} pageName="Book appointment">
	<div class="hs">
		<HsPageHero label={text("book_label")} display={html("book_display")} photo={photo("book_hero_photo")} ratio="4/3" pos="50% 40%" />

		<section class="hs-wrap hs-c-main">
			<div class="hs-qbar">
				<h2 class="hs-h2-sm" style="color:#fff;font-weight:500">{text("book_phone_heading")}</h2>
				<a class="hs-btn hs-btn-w" href={telHref(s.phone)}>Call {s.phone}</a>
			</div>

			<div class="hs-c-row">
				<form class="hs-c-form" aria-labelledby="b-h" novalidate data-form method="post" action="/api/form">
					<h2 id="b-h" class="hs-h2-sm">{text("book_form_title")}</h2>
					{htmlParas("book_form_lead").map((p) => <p style="margin:0 0 8px" set:html={p} />)}
					<SiteForm slug="appointment-request" id="b" blockButton />
				</form>
				<ContactOffice class="hs-c-row-office" />
			</div>
		</section>
	</div>
</Base>
