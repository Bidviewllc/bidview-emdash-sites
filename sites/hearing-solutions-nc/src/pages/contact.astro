---
// Contact (design/hsnc/Contact.dc.html). Split hero with the office photo →
// three action cards (call, investment, question) → office card with the map
// below it, beside the message form (#message). Text: Pages → Contact
// (src/data/hsnc/contact.ts has the design's wording). Form fields: Plugins →
// Forms → Contact.
// Not on this design (template Contact): breadcrumbs and intro, the "Talk to us"
// side card, the offices band, the closing CTA band.
import "../styles/hsnc-contact.css";
import ContactOffice from "../components/hs/ContactOffice.astro";
import HsPageHero from "../components/hs/HsPageHero.astro";
import SiteForm from "../components/SiteForm.astro";
import Base from "../layouts/Base.astro";
import { hs } from "../lib/hs";
import { routes, telHref } from "../lib/routes";

const { text, html, htmlParas, hero, s } = hs(Astro, "contact");
const h = s.href;
const o = s.offices[0];
/** Card icons (design, Material Symbols): calendar check, money, person asking. */
const ICONS = [
	"M438-226 296-368l58-58 84 84 168-168 58 58-226 226ZM200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z",
	"M444-200h70v-50q50-9 86-39t36-89q0-42-24-77t-96-61q-60-20-83-35t-23-41q0-26 18.5-41t53.5-15q32 0 50 15.5t26 38.5l64-26q-11-35-40.5-61T516-710v-50h-70v50q-50 11-78 44t-28 74q0 47 27.5 76t86.5 50q63 23 87.5 41t24.5 47q0 33-23.5 48.5T486-314q-33 0-58.5-20.5T390-396l-66 26q14 48 43.5 77.5T444-252v52Zm36 120q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z",
	"M80-40v-80h800v80H80Zm80-120v-240q-33-54-51-114.5T91-638q0-61 15.5-120T143-874q8-21 26-33.5t40-12.5q31 0 53 21t18 50l-11 91q-6 48 8.5 91t43.5 75.5q29 32.5 70 52t89 19.5q60 0 120.5 12.5T706-472q45 23 69.5 58.5T800-326v166H160Zm80-80h480v-86q0-24-12-42.5T674-398q-41-20-95-31t-99-11q-66 0-122.5-27t-96-72.5Q222-585 202-644.5T190-768q-10 30-14.5 64t-4.5 66q0 58 20.5 111.5T240-422v182Zm127-367q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47Zm169.5-56.5Q560-687 560-720t-23.5-56.5Q513-800 480-800t-56.5 23.5Q400-753 400-720t23.5 56.5Q447-640 480-640t56.5-23.5ZM320-160v-37q0-67 46.5-115T480-360h160v80H480q-34 0-57 24.5T400-197v37h-80Zm160-80Zm0-480Z",
];
const cards = [
	{ n: 1, dark: true, href: telHref(s.phone), btn: `Call ${s.phone}`, cls: "hs-btn hs-btn-w" },
	{ n: 2, dark: false, href: `${h(routes.resources)}#investment`, btn: text("contact_card2_button"), cls: "hs-btn hs-btn-o" },
	{ n: 3, dark: false, href: "#message", btn: text("contact_card3_button"), cls: "hs-btn hs-btn-o" },
];
const description = `Call ${s.phone} or send us a message. ${o.street}, ${o.city}.`;
---
<Base title={`Contact us | ${s.name}`} description={description} pageName="Contact" current="contact">
	<div class="hs">
		<HsPageHero label={text("contact_label")} display={html("contact_display")} photo={hero()} ratio="4/3" pos="50% 100%" />

		<section class="hs-wrap hs-c-main">
			<div class="hs-c-cards">
				{
					cards.map((c, i) => (
						<div class:list={["hs-c-card", { "on-dark": c.dark }]}>
							<span class="hs-c-ic" aria-hidden="true">
								<svg width="44" height="44" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d={ICONS[i]} /></svg>
							</span>
							<h2 class="hs-h2-sm" style="font-weight:500">{text(`contact_card${c.n}_heading`)}</h2>
							{htmlParas(`contact_card${c.n}_text`).map((p) => <p set:html={p} />)}
							<a class={c.cls} href={c.href} style="margin-top:8px">{c.btn}</a>
						</div>
					))
				}
			</div>

			<div class="hs-c-row">
				<ContactOffice class="hs-c-row-office" />
				<form id="message" class="hs-c-form" aria-label="Send us a message" novalidate data-form method="post" action="/api/form">
					{htmlParas("contact_form_intro").map((p) => <p style="margin:0 0 8px" set:html={p} />)}
					<SiteForm slug="contact" id="c" blockButton />
				</form>
			</div>
		</section>
	</div>
</Base>
