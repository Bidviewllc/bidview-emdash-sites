---
// Patient resource page: /patient-resources/<slug> for resources with "Give this its
// own page" on. The page itself is src/components/ResourcePage.astro. A resource that
// keeps its live-site address (src/lib/resource-paths.ts) is drawn there instead, and
// this address redirects to it (src/data/hsnc/redirects.ts).
import ResourcePage from "../../components/ResourcePage.astro";

const { resources } = Astro.locals.site;
const r = resources.find((x) => x.slug === Astro.params.slug);
if (!r || !r.page) return Astro.rewrite("/404");
---
<ResourcePage r={r} />
