---
// Reviews (template Page 11, HSNC reskin; no HSNC board). Light green hero with
// the rating and "Leave us a review on Google" → location filter (two offices
// only) → masonry of review cards (the HSNC review card) → "Show more" → the
// shared closing band. Dropped from the template: breadcrumbs.
import "../styles/hsnc-reskin.css";
import HsCtaBand from "../components/hs/HsCtaBand.astro";
import HsIcon from "../components/hs/HsIcon.astro";
import Base from "../layouts/Base.astro";
import type { Tweak } from "../components/ReviewControls.astro";
import { getSettings } from "../lib/settings";

const { practice, reviewsPage: all, reviewLink } = Astro.locals.site;

const tweaks: Tweak[] = [
	{ key: "reviewbtn", label: "“Leave us a review” button", type: "choice", default: "primary", options: [["primary", "Primary colour"], ["outline", "White with outline"]] },
];
const s = getSettings(Astro);
const tx = s.text;
const reviewBtn = s.choice("reviewbtn", ["primary", "outline"], "primary");
const two = s.officeCount === 2;
const filters = ["All", ...s.offices.map((o) => o.shortName)];
---
<Base title={`Patient reviews | ${s.name}`} description={`Rated ${practice.rating.score} out of 5 from ${practice.rating.count} Google reviews.`} pageName="Reviews" tweaks={tweaks}>
	<div class="hs">
		<div class="hs-mint rs-hero">
			<section class="hs-wrap hs-hsplit rs-short">
				<div class="hs-htxt rs-htxt">
					<p class="hs-eyebrow">Reviews</p>
					<h1 class="hs-serif rs-h1">{tx("heading")}</h1>
					<div class="rs-rv-row">
						<div class="hs-stars" role="img" aria-label={`${practice.rating.score} out of 5 stars`}>{[1, 2, 3, 4, 5].map(() => <HsIcon name="star" size={24} />)}</div>
						<span><b>{practice.rating.score} out of 5</b> from {practice.rating.count} Google reviews</span>
					</div>
					<a class:list={["hs-btn", { "hs-btn-o": reviewBtn === "outline" }]} href={reviewLink ?? "#"} target={reviewLink ? "_blank" : undefined} rel={reviewLink ? "noopener" : undefined} style="margin-top:8px;gap:8px">Leave us a review on Google <HsIcon name="arrowUp" size={18} /></a>
				</div>
			</section>
		</div>

		<section class="hs-wrap rs-sec rs-stack" style="gap:32px" data-reviews>
			{
				two && (
					<div class="rs-shead" style="align-items:center">
						<div class="rs-seg" role="group" aria-label="Filter reviews by location">
							{filters.map((f, i) => (
								<button class:list={{ on: i === 0 }} type="button" aria-pressed={i === 0 ? "true" : "false"} data-filter={f}>{f}</button>
							))}
						</div>
						<span class="muted" aria-live="polite" data-count>Showing {all.length} of {practice.rating.count}</span>
					</div>
				)
			}
			<div class="rs-rv-masonry">
				{
					all.map((r) => (
						<figure class="hs-rcard" data-loc={r.loc} style="background:var(--hs-mint)">
							<div style="display:flex;justify-content:space-between;align-items:flex-start">
								<span class="hs-qmark" aria-hidden="true" style="background:#fff"><HsIcon name="quote" size={26} /></span>
								<div class="hs-stars" role="img" aria-label={`${r.rating ?? 5} out of 5 stars`}>{Array.from({ length: r.rating ?? 5 }, () => <HsIcon name="star" size={22} />)}</div>
							</div>
							<blockquote class="hs-rtext">{r.text}</blockquote>
							<figcaption class="hs-rmeta"><b>{r.name}</b><span>{r.date}</span>{two && r.loc && <span>{r.loc}</span>}</figcaption>
						</figure>
					))
				}
			</div>
			<div style="display: flex; flex-direction: column; align-items: center; gap: 12px">
				<button class="hs-btn hs-btn-o" type="button" data-more>Show more reviews</button>
				<p class="muted" style="font-size:16px" aria-live="polite" data-more-note hidden>On the live site this loads the next 12 reviews.</p>
			</div>
		</section>
		<HsCtaBand />
	</div>
</Base>

<script>
	// Location filter: shows only that office's reviews.
	document.querySelectorAll<HTMLElement>("[data-reviews]").forEach((box) => {
		const cards = [...box.querySelectorAll<HTMLElement>("[data-loc]")];
		const count = box.querySelector<HTMLElement>("[data-count]");
		const total = count?.textContent?.split(" of ")[1] ?? "";
		box.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const f = btn.dataset.filter!;
				box.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((b) => {
					b.classList.toggle("on", b === btn);
					b.setAttribute("aria-pressed", String(b === btn));
				});
				let n = 0;
				cards.forEach((c) => {
					c.hidden = f !== "All" && c.dataset.loc !== f;
					if (!c.hidden) n++;
				});
				if (count) count.textContent = `Showing ${n} of ${total}`;
			});
		});
		box.querySelector("[data-more]")?.addEventListener("click", () => {
			box.querySelector<HTMLElement>("[data-more-note]")!.hidden = false;
		});
	});
</script>
