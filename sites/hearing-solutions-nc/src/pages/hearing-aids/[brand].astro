---
// Brand page (template Page 5, HSNC reskin; no HSNC board). Same layout for
// every brand. Light green hero with the brand logo (the brand's photo on the
// right when it has one) → current models → accessories → older models → FAQ
// → care at the practice → the shared closing band. Dropped from the template:
// breadcrumbs, the Book button (the phone instead), photo placeholders.
import "../../styles/hsnc-reskin.css";
import HsCtaBand from "../../components/hs/HsCtaBand.astro";
import HsFaq from "../../components/hs/HsFaq.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";
import { routes, telHref } from "../../lib/routes";

const { brandDetails, brandFaqs, brands, practice } = Astro.locals.site;

const brand = brands.find((b) => b.slug === Astro.params.brand);
if (!brand || !brand.hasPage) return Astro.rewrite("/404");
const detail = brandDetails[brand.slug] ?? { lines: [], accessories: [], older: [] };

const tweaks: Tweak[] = [];
const s = getSettings(Astro);
const h = s.href;
const tel = telHref(s.phone);
const title = `${brand.name} Hearing Aids in ${practice.city}`;
const intro = s.fill(brand.intro ?? "").split(/\n\s*\n/).filter((p) => p.trim());
const faq = brandFaqs[brand.slug] ?? [];
const office = practice.photos.office;
const productSvg = `<path d="M60 14c11 0 18 9 18 20v24c0 9-7 16-16 16s-16-7-16-16V32c0-10 5-18 14-18z" fill="currentColor" fill-opacity=".14" stroke="currentColor" stroke-width="2.5"></path><path d="M50 66C36 72 28 80 28 88" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path><circle cx="28" cy="88" r="5" fill="currentColor" fill-opacity=".4"></circle>`;
---
<Base title={`${title} | ${s.name}`} description={brand.summary} pageName="Brand page" current="hearing-aids" tweaks={tweaks} heroDefault="photo">
	<div class="hs">
		<div class="hs-mint rs-hero">
			<section class="hs-wrap hs-hsplit">
				<div class="hs-htxt rs-htxt">
					<p class="hs-eyebrow"><a href={h(routes.hearingAids)} style="color:inherit;text-decoration:none">Hearing aids</a></p>
					<img class="rs-logo" src={brand.logo} alt={`${brand.name} logo`} />
					<h1 class="hs-serif rs-h1">{title}</h1>
					{intro.map((p) => <p class="rs-lead">{p}</p>)}
					<div class="hs-btns" style="margin-top:8px"><a class="hs-btn" href={tel}>Call us: {s.phone}</a></div>
				</div>
				{brand.heroImage && <div class="hs-hpic"><img class="rs-hero-img" src={brand.heroImage.src} alt={brand.heroImage.alt} /></div>}
			</section>
		</div>

		{
			detail.lines.length > 0 && (
				<section class="hs-wrap rs-sec rs-stack">
					<div class="rs-head">
						<p class="hs-eyebrow">Current models</p>
						<h2 class="hs-serif">Current {brand.name} hearing aid models</h2>
						{brand.modelsIntro && <p>{s.fill(brand.modelsIntro)}</p>}
					</div>
					{detail.lines.map((ln) => (
						<div class="rs-stack" style="gap:20px">
							<h3 class="hs-h3-sm" style="font-weight:600">{ln.t}</h3>
							<div class="panel grid">
								{ln.models.map((m) => (
									<article class="card model hz">
										<div class="pimg">
											<svg viewBox="0 0 100 100" width="40%" aria-hidden="true" set:html={productSvg} />
										</div>
										<div class="stack g12 mtext">
											<h4 class="h3">{m.n}</h4>
											<p class="muted" style="font-size: 18px">{m.d}</p>
											{m.f && m.f.length > 0 && (
												<div class="stack g8">
													<span class="hs-eyebrow" style="color:var(--hs-green);font-size:14px">Key features</span>
													<ul class="checks-list">{m.f.map((f) => <li>{f}</li>)}</ul>
												</div>
											)}
										</div>
									</article>
								))}
							</div>
						</div>
					))}
				</section>
			)
		}

		{
			detail.accessories.length > 0 && (
				<section class="hs-mint">
					<div class="hs-wrap rs-sec rs-two">
						<div class="rs-head">
							<p class="hs-eyebrow">Accessories</p>
							<h2 class="hs-serif">{brand.name} accessories and assistive technology</h2>
							{brand.accessoriesIntro && <p>{s.fill(brand.accessoriesIntro)}</p>}
						</div>
						<div class="card" style="padding: 32px; border-radius: 14px">
							<ul class="checks-list acc-items">{detail.accessories.map((a) => <li>{a}</li>)}</ul>
						</div>
					</div>
				</section>
			)
		}

		{
			detail.older.length > 0 && (
				<section class="hs-wrap rs-sec" style="display:flex;flex-direction:column;gap:24px">
					<div class="rs-head">
						<p class="hs-eyebrow">Older models</p>
						<h2 class="hs-serif">Older {brand.name} models we support</h2>
						{brand.olderIntro && <p>{s.fill(brand.olderIntro)}</p>}
					</div>
					<ul class="chips">{detail.older.map((o) => <li>{o}</li>)}</ul>
				</section>
			)
		}

		{
			faq.length > 0 && (
				<section class="hs-wrap rs-sec pt0" style="max-width:900px;display:flex;flex-direction:column;gap:32px">
					<div class="rs-head center">
						<p class="hs-eyebrow">FAQ</p>
						<h2 class="hs-serif">Frequently asked questions about {brand.name} hearing aids</h2>
					</div>
					<div><HsFaq items={faq} /></div>
				</section>
			)
		}

		<section class="hs-mint">
			<div class:list={["hs-wrap rs-sec", { "rs-two": !!office }]}>
				<div class="rs-head">
					<p class="hs-eyebrow">Care at {practice.shortName}</p>
					<h2 class="hs-serif">{brand.name} hearing aid care at {s.name}</h2>
					{brand.careText && <p>{s.fill(brand.careText)}</p>}
					<div class="hs-btns" style="margin-top:12px"><a class="hs-btn" href={tel}>Call us: {s.phone}</a></div>
				</div>
				{office && <img class="hs-img" src={office.src} alt={office.alt} style="aspect-ratio:3/2" loading="lazy" />}
			</div>
		</section>
		<HsCtaBand />
	</div>
</Base>
