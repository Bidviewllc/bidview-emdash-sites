---
// /hearing-aids: the live site's Hearing Aid Overview page, kept at its address
// (Liz, 2026-11-05). It is the "hearing-aid-overview" patient resource drawn with the
// resource page (src/components/ResourcePage.astro); /patient-resources/hearing-aid-overview
// redirects here. The brands page is /products, as on the live site.
import ResourcePage from "../../components/ResourcePage.astro";

const { resources } = Astro.locals.site;
const r = resources.find((x) => x.slug === "hearing-aid-overview");
if (!r || !r.page) return Astro.rewrite("/404");
---
<ResourcePage r={r} />
