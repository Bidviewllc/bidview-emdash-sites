---
// Hearing aids hub (template Page 4, HSNC reskin; no HSNC board). Light green
// hero → brand cards → styles (optional) → OTC vs prescription (optional) →
// the shared closing band. Dropped from the template: breadcrumbs, the Book
// button (the phone instead), the photo placeholder.
import "../../styles/hsnc-reskin.css";
import HsCtaBand from "../../components/hs/HsCtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import StyleIllustration from "../../components/StyleIllustration.astro";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";
import { routes } from "../../lib/routes";

const { brands, hearingAidStyles } = Astro.locals.site;

const tweaks: Tweak[] = [
	{ key: "brandlinks", label: "Brand “Learn more”", type: "choice", default: "mixed", options: [["mixed", "Mixed (pages that exist)"], ["all", "All cards"], ["none", "None"]] },
	{ key: "styles", label: "Hearing aid styles", type: "bool", default: true },
	{ key: "otc", label: "OTC vs. prescription", type: "bool", default: true },
];
const s = getSettings(Astro);
const tx = s.text;
const brandLinks = s.choice("brandlinks", ["mixed", "all", "none"], "mixed");
const showStyles = s.bool("styles", false);
const showOtc = s.bool("otc", false);
---
<Base title={`${tx("heading")} | ${s.name}`} description={tx("description")} pageName="Hearing aids hub" current="hearing-aids" tweaks={tweaks} heroDefault="photo">
	<PageHero label="Hearing aids" title={tx("heading")} lead={tx("intro")} />

	<div class="hs">
		<section class="hs-wrap rs-sec rs-stack">
			<div class="rs-head"><p class="hs-eyebrow">Brands</p><h2 class="hs-serif">{tx("ha_brands_heading")}</h2></div>
			<div class="panel grid g-4 brand-grid">
				{
					brands.filter((b) => !b.hideFromHub).map((b) => {
						const linked = brandLinks === "all" ? true : brandLinks === "none" ? false : b.hasPage;
						return (
							<article class="card brand-card" style="padding: 28px">
								<div class="blogo-slot"><img src={b.logo} alt={`${b.name} logo`} style={`max-height: ${b.logoHeight}`} /></div>
								<h3 class="h3">{b.name}</h3>
								<p class="muted" style="font-size: 18px">{b.summary}</p>
								{linked && (
									<div class="actions">
										<a class="hs-btn hs-btn-o" href={s.href(routes.brand(b.slug))}>Learn more<span class="sr"> about {b.name} hearing aids</span></a>
									</div>
								)}
							</article>
						);
					})
				}
			</div>
		</section>

		{
			showStyles && (
				<section class="hs-mint">
					<div class="hs-wrap rs-sec rs-stack">
						<div class="rs-head"><p class="hs-eyebrow">Styles</p><h2 class="hs-serif">{tx("ha_styles_heading")}</h2></div>
						<div class="grid g-4" style="gap:24px">
							{hearingAidStyles.map((st) => (
								<article class="card" style="padding: 16px 16px 28px">
									<StyleIllustration k={st.k} alt={st.alt} />
									<div class="stack g8" style="padding: 0 12px">
										<h3 class="h4">{st.t}</h3>
										<p class="muted" style="font-size: 18px">{st.d}</p>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			showOtc && (
				<section class="hs-wrap rs-sec rs-stack">
					<div class="rs-head"><p class="hs-eyebrow">Compare</p><h2 class="hs-serif">{tx("ha_compare_heading")}</h2></div>
					<div class="panel grid g-2">
						<article class="card cmp-card">
							<span class="cmp-tag" style="background: var(--hs-mint); color: var(--hs-green)">Over-the-counter</span>
							<h3 class="h3">{tx("ha_otc_heading")}</h3>
							<p>{tx("ha_otc_text")}</p>
						</article>
						<article class="card cmp-card">
							<span class="cmp-tag" style="background: var(--hs-lime-lt); color: var(--hs-green)">Prescription</span>
							<h3 class="h3">{tx("ha_rx_heading")}</h3>
							<p>{tx("ha_rx_text")}</p>
						</article>
					</div>
				</section>
			)
		}
		<HsCtaBand />
	</div>
</Base>
