---
// Services hub (design/hsnc/Services.dc.html). Split hero → sidebar ("On this
// page" jump links + call box) beside one block per service → reviews (light)
// → closing call band. Page text: Pages → Services page (src/data/hsnc/services.ts
// has the design's wording). Each service's block: its Services record
// (heading, text, fold-out rows, note, second button); the slug is its anchor.
// A service set to "Hide from hub" has no block and no jump link.
// Not on this design (template hub): breadcrumbs, service card grid, "Your first
// visit" steps, "Read more reviews" link.
import HsCtaBand from "../../components/hs/HsCtaBand.astro";
import HsPageHero from "../../components/hs/HsPageHero.astro";
import HsReviews from "../../components/hs/HsReviews.astro";
import ServicesBlock from "../../components/hs/ServicesBlock.astro";
import ServicesSidebar from "../../components/hs/ServicesSidebar.astro";
import Base from "../../layouts/Base.astro";
import { hs } from "../../lib/hs";
import "../../styles/hsnc-services.css";

const { text, html, htmlParas, paras, hero, s } = hs(Astro, "services");
const services = Astro.locals.site.services.filter((x) => !x.hideFromHub);
const links = services.map((x) => ({ href: `#${x.slug}`, label: x.name }));
const description = paras("services_intro").join(" ").replace(/\*/g, "");
---
<Base title={`Services | ${s.name}`} description={description} pageName="Services hub" current="services">
	<div class="hs">
		<HsPageHero label={text("services_label")} display={html("services_display")} paras={htmlParas("services_intro")} photo={hero()} ratio="4/3" pos="50% 15%" />

		<section class="hs-wrap hs-svc-wrap">
			<ServicesSidebar links={links} heading={html("services_call_heading")} text={html("services_call_text")} />
			<div class="hs-svc-main">
				{services.map((x) => <ServicesBlock service={x} />)}
			</div>
		</section>

		<HsReviews tone="light" heading={text("services_reviews_heading")} />
		<HsCtaBand />
	</div>
</Base>
