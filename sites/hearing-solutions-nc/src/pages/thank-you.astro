---
// Thank you (template Page 17, HSNC reskin; no HSNC board). Shown after a form
// is sent. Light green band: check mark, serif H1, callback line with a
// tappable phone number, "Back to home" and "New patient information".
// ?guide=<resource slug>: sent from a download form (src/data/hsnc/gated-downloads.ts),
// so the band hands out the resource's PDF instead of the callback line.
import "../styles/hsnc-reskin.css";
import Base from "../layouts/Base.astro";
import { GATED_DOWNLOADS } from "../data/hsnc/gated-downloads";
import { getSettings } from "../lib/settings";
import { routes, telHref } from "../lib/routes";

const s = getSettings(Astro);
const guideSlug = Astro.url.searchParams.get("guide") ?? "";
const guide = GATED_DOWNLOADS[guideSlug] ? Astro.locals.site.resources.find((x) => x.slug === guideSlug && x.formsPdf) : undefined;
---
<Base title={`Thank you | ${s.name}`} description="We got your message." pageName="Thank you">
	<div class="hs">
		<section class="hs-mint rs-hero" aria-labelledby="ty-h">
			<div class="hs-wrap" style="padding-top:96px;padding-bottom:112px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
				<span class="rs-mark" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
				{
					guide ? (
						<>
							<h1 class="hs-serif rs-h1" id="ty-h">Thank you, your guide is ready</h1>
							<p class="rs-lead">Download your copy of the {guide.t} below. If you have questions after reading it, call us at <a href={telHref(s.phone)} style="font-weight:600;white-space:nowrap">{s.phone}</a>.</p>
							<div class="hs-btns" style="justify-content:center;gap:12px;margin-top:8px">
								<a class="hs-btn" href={guide.formsPdf} download>Download the guide</a>
								<a class="hs-btn hs-btn-o" href={s.href(routes.home)}>Back to home</a>
							</div>
						</>
					) : (
						<>
							<h1 class="hs-serif rs-h1" id="ty-h">Thank you, we got your message</h1>
							<p class="rs-lead">Our team reads messages every day we’re open, and we’ll make sure you get a response before the day’s over. If you need us sooner, call <a href={telHref(s.phone)} style="font-weight:600;white-space:nowrap">{s.phone}</a>.</p>
							<div class="hs-btns" style="justify-content:center;gap:12px;margin-top:8px">
								<a class="hs-btn" href={s.href(routes.home)}>Back to home</a>
								<a class="hs-btn hs-btn-o" href={s.href(routes.resources)}>New patient information</a>
							</div>
						</>
					)
				}
			</div>
		</section>
	</div>
</Base>
