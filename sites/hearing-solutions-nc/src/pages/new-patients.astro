---
// New Patients (design/hsnc/NewPatients.dc.html), the template's Patient
// Resources page record ("patient-resources") served at /new-patients.
// Split hero → sidebar ("On this page" + call box) beside: what brings you here,
// welcome video placeholder, five step cards → Your Investment → reviews →
// Other Services → FAQ. Text, lists and photos: Pages → New patients
// (src/data/hsnc/new-patients.ts has the design's wording).
// Not on this design (template Patient Resources): resource cards / accordion /
// tag groups, "From our blog", outside organizations, the booking band, breadcrumbs.
import HsFaq from "../components/hs/HsFaq.astro";
import HsPageHero from "../components/hs/HsPageHero.astro";
import HsReviews from "../components/hs/HsReviews.astro";
import NpAcc from "../components/hs/NpAcc.astro";
import NpStep from "../components/hs/NpStep.astro";
import Base from "../layouts/Base.astro";
import { hs } from "../lib/hs";
import { routes, telHref } from "../lib/routes";
import "../styles/hsnc-np.css";

const { text, html, htmlParas, list, photo, hero, s } = hs(Astro, "patient-resources");
const h = s.href;
const tel = telHref(s.phone);
const investPhoto = photo("np_invest_photo");
const otherPhoto = photo("np_other_photo");
const anchor = (href: string) => (href.startsWith("#") ? href : h(href));
---
<Base title={`New patients | ${s.name}`} description={text("np_intro")} pageName="New patients" current="resources">
	<div class="hs">
		<HsPageHero label={text("np_label")} display={html("np_display")} paras={htmlParas("np_intro")} photo={hero()} ratio="4/3" />

		<section class="hs-wrap hs-np-sbwrap">
			<aside class="hs-np-sb" aria-label={text("np_toc_label")}>
				<nav class="hs-np-nav">
					<p class="hs-eyebrow" style="color:var(--hs-green);margin:0 0 8px">{text("np_toc_label")}</p>
					<ul>{list("np_toc").map((l) => <li><a class="hs-np-jl" href={anchor(l.href)}>{l.t}</a></li>)}</ul>
				</nav>
				<div class="on-dark hs-np-cta">
					<h2 class="hs-serif">{text("np_side_heading")}</h2>
					{htmlParas("np_side_text").map((p) => <p style="font-size:16px" set:html={p} />)}
					<a class="hs-btn hs-btn-w" href={tel} style="width:100%">Call {s.phone}</a>
				</div>
			</aside>
			<div class="hs-np-main">
				<div style="display:flex;flex-direction:column;gap:16px">
					<h2 class="hs-h2-sm" style="font-weight:500">{text("np_choice_heading")}</h2>
					<div style="display:flex;flex-wrap:wrap;gap:12px">{list("np_choices").map((c) => <a class="hs-btn hs-btn-o" href={anchor(c.href)}>{c.t}</a>)}</div>
				</div>
				<div id="steps" class="hs-np-steps">
					<div class="hs-ph hs-np-video" role="img" aria-label="Welcome video placeholder">
						<span aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5l12 7-12 7z" /></svg></span>
					</div>
					{list("np_steps").map((st) => <NpStep step={st} />)}
				</div>
			</div>
		</section>

		<section id="investment" class="hs-wrap hs-np-invest">
			<div class="hs-np-photo" style="flex:1 1 320px">{investPhoto && <img src={investPhoto.src} alt={investPhoto.alt} loading="lazy" />}</div>
			<div class="on-dark hs-np-invbox">
				<p class="hs-eyebrow" style="letter-spacing:.08em">{text("np_invest_tag")}</p>
				<h2 class="hs-serif" style="line-height:1.15">{text("np_invest_heading")}</h2>
				{htmlParas("np_invest_text").map((p) => <p style="margin:0 0 12px" set:html={p} />)}
				<div>{list("np_invest").map((r) => <NpAcc title={r.t} text={r.d} dark />)}</div>
			</div>
		</section>

		<HsReviews heading={text("np_reviews_heading")} />

		<section id="other-services" class="hs-mint hs-np-other">
			<div class="hs-wrap hs-np-pair">
				<div style="display:flex;flex-direction:column;gap:12px;padding:8px 16px">
					<h2 class="hs-serif" style="line-height:1.15">{text("np_other_heading")}</h2>
					{htmlParas("np_other_text").map((p) => <p style="margin:0 0 12px" set:html={p} />)}
					<div>{list("np_other").map((r) => <NpAcc title={r.t} text={r.d} />)}</div>
				</div>
				<div class="hs-np-photo hs-np-photo-o">{otherPhoto && <img src={otherPhoto.src} alt={otherPhoto.alt} loading="lazy" />}</div>
			</div>
		</section>

		<div class="hs-navy">
			<section id="faq" class="hs-wrap hs-np-faqsec">
				<div class="hs-np-faqcard">
					<h2 class="hs-serif">{text("np_faq_heading")}</h2>
					<div><HsFaq items={list("np_faq").map((f) => ({ q: f.q, a: f.a }))} /></div>
					<div class="hs-btns" style="justify-content:center;gap:12px;margin-top:20px">
						<a class="hs-btn" href={tel}>Call us: {s.phone}</a>
						<a class="hs-btn hs-btn-o" href={h(`${routes.contact}#message`)}>Ask another question</a>
					</div>
				</div>
			</section>
		</div>
	</div>
</Base>
