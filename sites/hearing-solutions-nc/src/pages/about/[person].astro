---
// Team profile (template Page 7, HSNC reskin; no HSNC board). Light green hero
// with the 4:5 headshot → bio (lorem ipsum until one is added) → intro video (only with
// a video link) → services → location (as Home) → the shared closing band.
// Dropped from the template: breadcrumbs, the sample video
// player, the Book button (the phone instead).
import "../../styles/hsnc-reskin.css";
import HsCtaBand from "../../components/hs/HsCtaBand.astro";
import HsLocation from "../../components/hs/HsLocation.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import Base from "../../layouts/Base.astro";
import { ptHas, ptToHtml } from "../../lib/portable-text";
import { getSettings } from "../../lib/settings";
import { routes, telHref } from "../../lib/routes";

const { practice, providers, services } = Astro.locals.site;

const person = providers.find((p) => p.slug === Astro.params.person);
if (!person || !person.hasPage) return Astro.rewrite("/404");

const tweaks: Tweak[] = [{ key: "video", label: "Intro video", type: "bool", default: true }];
const s = getSettings(Astro);
const h = s.href;
/** Bio from EmDash; nothing shows until there is one. */
/** Placeholder until the bios come over from the current site (Liz, 2026-10-19: lorem ipsum where the bio goes). */
const BIO_PLACEHOLDER = [
	"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
	"Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
	"Curabitur pretium tincidunt lacus. Nulla gravida orci a odio. Nullam varius, turpis et commodo pharetra, est eros bibendum elit, nec luctus magna felis sollicitudin mauris. Integer in mauris eu nibh euismod gravida.",
].map((t) => `<p>${t}</p>`).join("");
const bio = ptHas(person.bioRich) ? s.fill(ptToHtml(person.bioRich).html) : person.bio?.trim() ? `<p>${person.bio.replace(/</g, "&lt;")}</p>` : BIO_PLACEHOLDER;
/** YouTube or Vimeo link as an embed address. */
const embed = (() => {
	const u = person.videoUrl ?? "";
	const yt = u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/);
	if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
	const vm = u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
	return vm ? `https://player.vimeo.com/video/${vm[1]}` : undefined;
})();
const showVideo = s.bool("video", true) && !!embed;
const svc = services.filter((x) => x.onHome !== false && !x.hideFromHub);
---
<Base title={`${person.name}, ${person.title} | ${s.name}`} description={`${person.name} is ${person.title.toLowerCase()} at ${s.name}.`} pageName="Provider profile" current="about" tweaks={tweaks}>
	<div class="hs">
		<div class="hs-mint rs-hero rs-prof">
			<section class="hs-wrap hs-hsplit">
				<div class="hs-htxt rs-htxt">
					<p class="hs-eyebrow">Our team</p>
					<h1 class="hs-serif rs-h1">{person.name}</h1>
					<p class="rs-prof-title">{person.title}</p>
					<div class="hs-btns" style="margin-top:8px">
						<a class="hs-btn" href={telHref(s.phone)}>Call us: {s.phone}</a>
						<a class="hs-btn hs-btn-o" href={h(routes.about)}>Meet the whole team</a>
					</div>
				</div>
				{person.headshot && <div class="hs-hpic"><img class="rs-prof-img" src={person.headshot} alt={`${person.name}, ${person.title}`} /></div>}
			</section>
		</div>

		{
			bio && (
				<section class="hs-wrap rs-sec" aria-label={`About ${person.short}`}>
					<div class="rt" style="max-width: none" set:html={bio} />
				</section>
			)
		}

		{
			showVideo && (
				<section class:list={["hs-wrap rs-sec", { pt0: !!bio }]}>
					<div class="rs-stack" style="max-width: 1040px">
						<h2 class="hs-serif">Meet {person.short}</h2>
						<div class="vplayer"><iframe src={embed} title={`Meet ${person.short}`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0" /></div>
					</div>
				</section>
			)
		}

		{
			svc.length > 0 && (
				<section class="hs-wrap rs-sec rs-stack">
					<div class="rs-head">
						<p class="hs-eyebrow">Services</p>
						<h2 class="hs-serif">Hearing care services in {practice.city}</h2>
					</div>
					<div style="display:flex;flex-wrap:wrap;gap:24px">
						{svc.map((x) => (
							<a href={h(x.hasPage ? routes.service(x.slug) : routes.services)} class="hs-card hs-svc-card">
								<span style="font-size:19px;font-weight:500;text-align:center;padding:0 16px">{x.name}</span>
								<span class="hs-eyebrow" style="font-size:15px;letter-spacing:.1em">Read more</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		<HsLocation />
		<HsCtaBand />
	</div>
</Base>
