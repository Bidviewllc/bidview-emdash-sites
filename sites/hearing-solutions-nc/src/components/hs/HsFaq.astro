---
// FAQ rows (Home, New Patients boards): details/summary with a plus that turns
// to a cross when open. Answers: blank lines start paragraphs; *italic*,
// **bold** and [links](/path) work (inline() in src/lib/hs.ts).
interface Props {
	items: { q: string; a?: string }[];
}
const { items } = Astro.props;
import HsIcon from "./HsIcon.astro";
import { inline } from "../../lib/hs";
---
{
	items.map((f) => (
		<details class="hs-faq">
			<summary>{f.q}<HsIcon name="plus" size={16} /></summary>
			{(f.a || "[Answer to come]").split(/\n\s*\n/).map((p) => <p set:html={inline(p.trim())} />)}
		</details>
	))
}
