---
// The template's CTA band, HSNC reskin: draws the shared HSNC closing band
// (src/components/hs/HsCtaBand.astro) with the Shared sections wording, so
// every page ends the same way. The old props are kept so older callers still
// build; `heading` and `text` are not used (they held template sample text).
import HsCtaBand from "./hs/HsCtaBand.astro";

interface Props {
	id?: string;
	heading?: string;
	text?: string;
	bookLabel?: string;
	photoLabel?: string;
	callFirst?: boolean;
}
---
<div class="hs"><HsCtaBand /></div>
