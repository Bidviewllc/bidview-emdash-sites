---
// The template's reviews band, HSNC reskin: draws the shared HSNC reviews band
// (src/components/hs/HsReviews.astro). Old props kept so older callers build.
import type { Review } from "../data/types";
import HsReviews from "./hs/HsReviews.astro";

interface Props {
	reviews?: Review[];
	link?: boolean;
	heading?: string;
	class?: string;
	tone?: "navy" | "light";
}
const { reviews, heading, tone } = Astro.props;
---
<HsReviews reviews={reviews} heading={heading} tone={tone} />
