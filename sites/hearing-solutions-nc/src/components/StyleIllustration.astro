---
// Simple line drawings of where each hearing aid style sits. The device is drawn
// in Primary; the ear stays neutral. Copied from the HearingAidsHub board.
interface Props {
	k: "ric" | "bte" | "ite" | "cic";
	alt: string;
}
const { k, alt } = Astro.props;
const ear = `<path d="M78 14c-26 0-44 19-44 44 0 15 7 24 13 31 5 6 7 12 7 18 0 8 6 12 13 12 9 0 14-6 16-13 2-7 6-11 12-17 8-8 15-17 15-31 0-25-15-44-32-44z" fill="#fff" stroke="currentColor" stroke-opacity=".45" stroke-width="3"></path><path d="M64 46c6-10 24-11 30 2 4 9-1 16-7 20" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="3" stroke-linecap="round"></path>`;
const device = {
	ric: `<rect x="110" y="18" width="16" height="36" rx="8" style="fill: var(--p)"></rect><path d="M118 20C119 4 72 2 72 34c0 14 3 24 6 32" fill="none" style="stroke: var(--p)" stroke-width="2.5" stroke-linecap="round"></path><circle cx="78" cy="68" r="5.5" style="fill: var(--p)"></circle>`,
	bte: `<rect x="110" y="12" width="24" height="56" rx="12" style="fill: var(--p)"></rect><path d="M120 14C116-2 66 0 70 32c2 14 5 24 8 32" fill="none" style="stroke: var(--p)" stroke-width="5" stroke-linecap="round"></path><circle cx="78" cy="68" r="8" style="fill: var(--p)"></circle>`,
	ite: `<ellipse cx="80" cy="70" rx="17" ry="14" style="fill: var(--p)"></ellipse>`,
	cic: `<circle cx="78" cy="68" r="6.5" style="fill: var(--p)"></circle><path d="M78 74v8" style="stroke: var(--p)" stroke-width="2" stroke-linecap="round"></path>`,
}[k];
---
<div class="style-ill" role="img" aria-label={alt}>
	<svg viewBox="0 0 160 120" width="70%" aria-hidden="true" set:html={ear + device} />
</div>
