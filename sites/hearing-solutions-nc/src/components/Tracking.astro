---
// Tracking and custom code from the Admin-only "Marketing & tracking" page,
// in three places (head, start of body, end of body). Nothing is written unless
// the page is on the practice's live domain, so previews and test copies never
// send analytics. Events (phone taps, form sends) are in Base.astro's script.
import { active, onLiveDomain, type Marketing } from "../lib/marketing";

interface Props {
	mk: Marketing;
	place: "head" | "body-start" | "body-end";
}
const { mk, place } = Astro.props;
const live = onLiveDomain(mk, Astro.url.host);
const id = (k: string, re: RegExp) => (re.test(active(mk, k)) ? active(mk, k) : "");
const gtm = id("gtm", /^GTM-[A-Z0-9]+$/i);
const gtagIds = [id("ga4", /^G-[A-Z0-9]+$/i), id("gads", /^AW-\d+$/i)].filter(Boolean);
const clarity = id("clarity", /^[a-z0-9]+$/i);
const gtagInit = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());${gtagIds.map((g) => `gtag('config',${JSON.stringify(g)});`).join("")}`;
const gtmInit = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtm)});`;
const clarityInit = `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",${JSON.stringify(clarity)});`;
---
{
	live && place === "head" && (
		<>
			{gtm && <script is:inline set:html={gtmInit} />}
			{gtagIds.length > 0 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`} />}
			{gtagIds.length > 0 && <script is:inline set:html={gtagInit} />}
			{clarity && <script is:inline set:html={clarityInit} />}
			{active(mk, "code_head") && <Fragment set:html={active(mk, "code_head")} />}
		</>
	)
}
{
	live && place === "body-start" && (
		<>
			{gtm && (
				<noscript>
					<iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager" />
				</noscript>
			)}
			{active(mk, "code_body_start") && <Fragment set:html={active(mk, "code_body_start")} />}
		</>
	)
}
{
	live && place === "body-end" && (
		<>
			{active(mk, "call_tracking") && <Fragment set:html={active(mk, "call_tracking")} />}
			{active(mk, "code_body_end") && <Fragment set:html={active(mk, "code_body_end")} />}
		</>
	)
}
