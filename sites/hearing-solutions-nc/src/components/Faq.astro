---
// FAQ rows, HSNC reskin: draws the HSNC details/summary rows
// (src/components/hs/HsFaq.astro). Old props kept so older callers build.
import HsFaq from "./hs/HsFaq.astro";

interface Props {
	items: { q: string; a: string }[];
	id?: string;
	firstOpen?: boolean;
}
const { items } = Astro.props;
---
<div class="hs"><HsFaq items={items} /></div>
