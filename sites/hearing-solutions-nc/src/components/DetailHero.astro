---
// The hero of the record pages (service pages, patient resource pages), HSNC
// reskin: light green band, small capitals label (the section), serif H1,
// intro, optional slot, the Call button, and the record's photo on the right
// when it has one. No breadcrumbs (`crumbs` and `current` are kept for older
// callers; the last crumb is the default label).
import "../styles/hsnc-reskin.css";
import type { Photo } from "../data/site";
import { telHref } from "../lib/routes";
import { getSettings, type HeroKey } from "../lib/settings";

interface Props {
	crumbs?: [string, string][];
	current?: string;
	title: string;
	/** Small capitals line above the H1; defaults to the last crumb. */
	label?: string;
	intro?: string;
	bookLabel?: string;
	hero: HeroKey;
	image?: Photo;
	photoLabel?: string;
}
const { crumbs = [], title, intro, hero, image } = Astro.props;
const s = getSettings(Astro);
const label = Astro.props.label ?? crumbs[crumbs.length - 1]?.[0];
const photo = image && (hero === "photo" || hero === "example") ? image : undefined;
const hasSlot = Astro.slots.has("default");
---
<div class="hs hs-mint rs-hero">
	<section class="hs-wrap hs-hsplit">
		<div class="hs-htxt rs-htxt">
			{label && <p class="hs-eyebrow">{label}</p>}
			<h1 class="hs-serif rs-h1">{title}</h1>
			{intro && <p class="rs-lead">{intro}</p>}
			{hasSlot && <slot />}
			<div class="hs-btns" style="margin-top:8px"><a class="hs-btn" href={telHref(s.phone)}>Call us: {s.phone}</a></div>
		</div>
		{photo && <div class="hs-hpic"><img src={photo.src} alt={photo.alt} class="rs-hero-img" /></div>}
	</section>
</div>
