---
// Interior page hero, HSNC reskin: the light green band of the designed pages
// (as src/components/hs/HsPageHero.astro). A small capitals label, the serif
// H1, the lead, an optional slot, the Call button, and the page's hero photo
// on the right when it has one. No breadcrumbs (the `crumbs` prop is kept for
// older callers and only supplies the default label). "short" is the
// utility-page version: no photo, less height.
import "../styles/hsnc-reskin.css";
import type { Photo } from "../data/site";
import type { HeroKey } from "../lib/settings";
import { getSettings } from "../lib/settings";
import { telHref } from "../lib/routes";

interface Props {
	/** Kept for older callers; breadcrumbs are not drawn. The last crumb is the default label. */
	crumbs?: { label: string; href?: string }[];
	title: string;
	/** The small capitals line above the H1. */
	label?: string;
	lead?: string;
	/** Omit `book` (false) to hide the Call button. Booking buttons are the phone on this site. */
	book?: { label: string; href?: string } | false;
	showCall?: boolean;
	heroDefault?: HeroKey;
	photoLabel?: string;
	photoTone?: string;
	photoBottom?: number;
	short?: boolean;
	/** Hero photo of a record page (office, service...); fixed pages use their Pages record's. */
	image?: Photo;
}
const { crumbs = [], title, lead, book = { label: "Call" }, showCall = true, heroDefault = "photo", short = false, image: ownImage } = Astro.props;
const s = getSettings(Astro);
const image = short ? undefined : (ownImage ?? s.pageHeroImage);
const hero = short ? "light" : s.heroFor(heroDefault, image);
const photo = image && (hero === "photo" || hero === "example") ? image : undefined;
const last = crumbs[crumbs.length - 1]?.label;
const label = Astro.props.label ?? (last && last.toLowerCase() !== title.toLowerCase() ? last : crumbs.length > 2 ? crumbs[crumbs.length - 2].label : undefined);
const hasSlot = Astro.slots.has("default");
const call = book !== false && showCall;
---
<div class="hs hs-mint rs-hero">
	<section class:list={["hs-wrap hs-hsplit", { "rs-short": short }]}>
		<div class="hs-htxt rs-htxt">
			{label && <p class="hs-eyebrow">{label}</p>}
			<h1 class:list={["hs-serif rs-h1", { sm: short }]}>{title}</h1>
			{lead && <p class="rs-lead">{lead}</p>}
			{hasSlot && <slot />}
			{call && <div class="hs-btns" style="margin-top:8px"><a class="hs-btn" href={telHref(s.phone)}>Call us: {s.phone}</a></div>}
		</div>
		{photo && <div class="hs-hpic"><img src={photo.src} alt={photo.alt} class="rs-hero-img" /></div>}
	</section>
</div>
