---
// Blog archive body (template Page 12, HSNC reskin; no HSNC board). Shared by
// /blog and /blog/category/<cat>. Light green hero → category chips (real
// links) → featured post (All only) → grid or list → pager → the shared
// closing band. Dropped from the template: breadcrumbs, placeholder image boxes
// where a post has no image.
import "../styles/hsnc-reskin.css";
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/settings";
import HsCtaBand from "./hs/HsCtaBand.astro";
import Icon from "./Icon.astro";
import PageHero from "./PageHero.astro";
import PostCard from "./PostCard.astro";
import type { Tweak } from "./ReviewControls.astro";
import { routes } from "../lib/routes";
import type { Post } from "../data/types";

const { categories, featured, posts } = Astro.locals.site;

interface Props {
	cat?: { name: string; slug: string };
}
const { cat } = Astro.props;
const tweaks: Tweak[] = [
	{ key: "layout", label: "Layout", type: "choice", default: "grid", options: [["grid", "Grid · 16:9"], ["square", "Grid · square"], ["list", "List"]] },
];
const s = getSettings(Astro);
const tx = s.text;
const h = s.href;
const layout = s.choice("layout", ["grid", "square", "list"], "grid");
const shown: Post[] = cat ? posts.filter((p) => p.catSlug === cat.slug) : posts;
const title = cat ? `${cat.name} articles` : tx("heading");
---
<Base title={`${title} | ${s.name}`} description={tx("description")} pageName={cat ? "Blog category" : "Blog archive"} current="blog" tweaks={tweaks}>
	<PageHero label="Blog" title={title} lead={tx("intro")} short book={false} />

	<div class="hs">
		<section class="hs-wrap" style="padding-top:48px">
			<nav class="chip-row" aria-label="Blog categories">
				<a class:list={["cat-chip", { on: !cat }]} href={h(routes.blog)} aria-current={!cat ? "page" : undefined}>All</a>
				{categories.map((c) => (
					<a class:list={["cat-chip", { on: cat?.slug === c.slug }]} href={h(routes.category(c.slug))} aria-current={cat?.slug === c.slug ? "page" : undefined}>{c.name}</a>
				))}
			</nav>
		</section>

		{
			!cat && featured && (
				<section class="hs-wrap" style="padding-top:48px">
					<article class="feat bl-feat">
						{featured.image ? (
							<a href={h(routes.post(featured.slug))} class="post" tabindex="-1" aria-hidden="true"><div class="img"><img class="hs-img" src={featured.image} alt="" style="aspect-ratio: 16/9" /></div></a>
						) : (
							<div class="hs-ph" style="aspect-ratio: 16/9" aria-hidden="true" />
						)}
						<div class="rs-htxt">
							<div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center"><span class="tag">{featured.cat}</span><span class="muted" style="font-size:16px">{featured.date}</span></div>
							<h2 class="hs-serif">{featured.title}</h2>
							<p>{featured.summary}</p>
							<span><b>{featured.author}</b></span>
							<a class="hs-btn" href={h(routes.post(featured.slug))} style="margin-top:8px">Read article<span class="sr"> {featured.title}</span></a>
						</div>
					</article>
				</section>
			)
		}

		<section class="hs-wrap rs-sec rs-stack" style="padding-top:64px">
			{
				layout !== "list" ? (
					<div class="grid g-3 posts-grid" style="gap: 48px 32px">
						{shown.map((p) => <PostCard p={p} square={layout === "square"} />)}
					</div>
				) : (
					<div class="bl-list">
						{shown.map((p) => (
							<article class="feat bl-row">
								{p.image ? (
									<a href={h(routes.post(p.slug))} class="post" tabindex="-1" aria-hidden="true"><div class="img"><img class="hs-img" src={p.image} alt="" style="aspect-ratio: 16/9" loading="lazy" /></div></a>
								) : (
									<div class="hs-ph" style="aspect-ratio: 16/9" aria-hidden="true" />
								)}
								<div class="rs-htxt" style="gap:12px">
									<div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center"><span class="tag">{p.cat}</span><span class="muted" style="font-size:16px">{p.date}</span></div>
									<h2 class="hs-h3-sm" style="font-weight:600">{p.title}</h2>
									<p class="muted">{p.summary}</p>
									<a class="hs-btn" href={h(routes.post(p.slug))} style="margin-top:6px">Read article<span class="sr"> {p.title}</span></a>
								</div>
							</article>
						))}
					</div>
				)
			}
			{
				!cat && (
					<nav class="pager" aria-label="Blog pages">
						<a class="pg on" href={h(routes.blog)} aria-current="page">1</a>
						<a class="pg" href={h(routes.blog)}>2</a>
						<a class="pg" href={h(routes.blog)}>3</a>
						<a class="pg next" href={h(routes.blog)}>Next <Icon name="arrowR" /></a>
					</nav>
				)
			}
		</section>
		<HsCtaBand />
	</div>
</Base>
