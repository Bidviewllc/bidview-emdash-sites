---
// 404 (template Page 16, HSNC reskin; no HSNC board). Light green band: large
// "404", serif H1, a line of text, search box (optional), Call and "Go to the
// home page" → "Popular pages" (4 cards). Dropped from the template: the
// sample paragraph, the Book button (the phone instead).
import "../styles/hsnc-reskin.css";
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/settings";
import type { Tweak } from "./ReviewControls.astro";
import { routes, telHref } from "../lib/routes";

const tweaks: Tweak[] = [{ key: "search", label: "Search box", type: "bool", default: true }];
const s = getSettings(Astro);
const h = s.href;
const showSearch = s.bool("search", true);
const popular = [
	{ t: "Services", d: "Hearing tests, fittings, tinnitus care and more", href: routes.services },
	{ t: "Hearing Aids", d: "Styles, brands and what fits your life", href: routes.hearingAids },
	{ t: "Contact", d: s.officeCount === 2 ? "Phone, email and both office locations" : "Phone, email and our office location", href: routes.contact },
	{ t: "Book Appointment", d: "Pick a time online or request a call", href: routes.book },
];
Astro.response.status = 404;
---
<Base title={`Page not found | ${s.name}`} description="We can't find that page." pageName="404" tweaks={tweaks}>
	<div class="hs">
		<div class="hs-mint rs-hero">
			<section class="hs-wrap hs-hsplit">
				<div class="hs-htxt rs-htxt" style="max-width:760px">
					<span class="rs-code" aria-hidden="true">404</span>
					<h1 class="hs-serif rs-h1">We can’t find that page</h1>
					<p class="rs-lead">It may have moved. Search the site, or call us at <a href={telHref(s.phone)} style="font-weight:600">{s.phone}</a>.</p>
					{
						showSearch && (
							<form class="rs-search" role="search" aria-label="Search the site" action="/search">
								<label class="sr" for="nf-q">Search the site</label>
								<input id="nf-q" type="search" name="q" placeholder="Search for a service, topic or page" />
								<button class="hs-btn" type="submit">Search</button>
							</form>
						)
					}
					<div class="hs-btns" style="gap:12px;margin-top:8px">
						<a class="hs-btn" href={telHref(s.phone)}>Call us: {s.phone}</a>
						<a class="hs-btn hs-btn-o" href={h(routes.home)}>Go to the home page</a>
					</div>
				</div>
			</section>
		</div>
		<section class="hs-wrap rs-sec rs-stack">
			<h2 class="hs-serif">Popular pages</h2>
			<ul class="rs-links">
				{
					popular.map((x) => (
						<li>
							<a class="rs-link" href={h(x.href)}>
								<b>{x.t}</b>
								<span>{x.d}</span>
								<span class="hs-eyebrow" aria-hidden="true">Read more</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Base>
