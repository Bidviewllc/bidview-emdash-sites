---
import Interior from "../layouts/Interior.astro";
import CtaStrip from "../components/CtaStrip.astro";
import { getAudiologist, otherAudiologists } from "../data/team";
import { marked } from "marked";

interface Props { slug: string }
const { slug } = Astro.props;

const person = getAudiologist(slug)!;
const others = otherAudiologists(slug);

marked.setOptions({ gfm: true, breaks: false });
const bioHtml = await marked.parse(person.bio);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `https://ontariohearing.com/${person.slug}/#person`,
  name: person.name,
  jobTitle: person.role,
  honorificSuffix: person.credentials,
  image: `https://ontario-hearing.cameron-239.workers.dev${person.photo}`,
  url: `https://ontariohearing.com/${person.slug}/`,
  worksFor: { "@id": "https://ontariohearing.com/#organization" },
};
---
<Interior
  title={person.metaTitle}
  description={person.metaDescription}
  pageTitle={person.name}
  breadcrumbLabel={person.name}
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "About Us", href: "/about-us/" }]}
  canonical={`https://ontariohearing.com/${person.slug}/`}
  ogImage={`https://ontario-hearing.cameron-239.workers.dev${person.photo}`}
  ogType="profile"
  schemaJsonLd={personSchema}
>
  <section>
    <div class="person-page">
      <div class="person-page__photo">
        <img src={person.photo} alt={`${person.name}, ${person.credentials}`} loading="eager" />
      </div>
      <div class="person-page__body">
        <p class="eyebrow eyebrow--green">{person.role}</p>
        <h2 class="display">{person.name}, {person.credentials}</h2>
        <div class="person-page__bio" set:html={bioHtml}></div>
        <a href="/contact-us/" class="btn btn--navy">
          <span>Schedule An Appointment</span><span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section--cream">
      <div class="section__head">
        <p class="eyebrow eyebrow--green">More of the team</p>
        <h2 class="display">Meet the rest of our audiologists.</h2>
      </div>
      <div class="cards-3 other-team">
        {others.map((m) => (
          <a class="ot-card" href={`/${m.slug}/`}>
            <div class="ot-card__photo"><img src={m.photo} alt={m.name} loading="lazy" /></div>
            <div class="ot-card__body">
              <p class="ot-card__role">{m.role}</p>
              <h3 class="ot-card__name">{m.name}, {m.credentials}</h3>
              <span class="ot-card__link">View profile →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <CtaStrip />
</Interior>

<style>
  .person-page { display: grid; grid-template-columns: 420px minmax(0, 1fr); gap: 64px; padding: 56px 0 80px; align-items: start; }
  .person-page__photo img { width: 100%; height: auto; border-radius: 8px; aspect-ratio: 4 / 5; object-fit: cover; }
  .person-page__body h2 { margin: 8px 0 24px; }
  .person-page__bio :global(p) { font-size: 18px; line-height: 1.7; color: var(--body); margin: 0 0 16px; }
  .person-page__bio :global(h4) { font-family: var(--font-sans); font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--green); margin: 32px 0 12px; }
  .person-page__bio :global(ul) { margin: 0 0 24px; padding-left: 20px; }
  .person-page__bio :global(li) { font-size: 17px; line-height: 1.6; margin-bottom: 6px; color: var(--body); }
  .person-page__bio :global(strong) { font-weight: 700; }
  .person-page__bio :global(em) { font-style: italic; }

  .other-team { gap: 32px; margin-top: 48px; max-width: 760px; margin-left: auto; margin-right: auto; grid-template-columns: repeat(2, 1fr); }
  .ot-card { display: flex; flex-direction: column; background: #fff; border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .ot-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.08); }
  .ot-card__photo { aspect-ratio: 4 / 5; overflow: hidden; }
  .ot-card__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ot-card__body { padding: 24px; }
  .ot-card__role { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--green); margin: 0 0 8px; }
  .ot-card__name { font-family: var(--font-serif); font-size: 24px; line-height: 1.2; color: var(--ink, #0A2540); margin: 0 0 14px; font-weight: 400; }
  .ot-card__link { font-size: 15px; font-weight: 600; color: var(--green); }

  @media (max-width: 1024px) { .person-page { grid-template-columns: 1fr; gap: 32px; } .person-page__photo { max-width: 420px; } }
  @media (max-width: 640px) { .other-team { grid-template-columns: 1fr; } }
</style>
