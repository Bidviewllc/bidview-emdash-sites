---
import TopBar from "../components/TopBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileStickyBar from "../components/MobileStickyBar.astro";

export const cacheHint = 3600;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  currentPage?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  schemaJsonLd?: any | any[];
  noindex?: boolean;
}

const SITE = "https://ontariohearing.com";
const SITE_NAME = "Ontario Hearing Center";
const DEFAULT_OG_IMAGE = "https://ontario-hearing.cameron-239.workers.dev/assets/og-image.webp";

const {
  title = "Ontario Hearing Center — Audiologists & Hearing Aids in Rochester, NY",
  description = "Doctoral-level audiologists providing trusted hearing health care in Brighton, NY for nearly seventy years.",
  canonical,
  currentPage = "",
  ogImage = DEFAULT_OG_IMAGE,
  ogType = "website",
  schemaJsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical || SITE + Astro.url.pathname;

// Build the sitewide JSON-LD graph (Organization, LocalBusiness, WebSite)
const sitewideSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "MedicalBusiness", "LocalBusiness"],
      "@id": `${SITE}/#organization`,
      "name": SITE_NAME,
      "alternateName": "Ontario Hearing Center",
      "url": SITE,
      "logo": {
        "@type": "ImageObject",
        "@id": `${SITE}/#logo`,
        "url": `${SITE}/assets/logo-header.webp`,
        "contentUrl": `${SITE}/assets/logo-header.webp`,
        "caption": SITE_NAME,
        "inLanguage": "en-US",
      },
      "image": { "@id": `${SITE}/#logo` },
      "telephone": "+1-585-442-4180",
      "email": "info@ontariohearing.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2210 Monroe Avenue",
        "addressLocality": "Rochester",
        "addressRegion": "NY",
        "postalCode": "14618",
        "addressCountry": "US",
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.122282,
        "longitude": -77.559438,
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"],
          "opens": "09:00", "closes": "17:00",
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Friday",
          "opens": "09:00", "closes": "16:00",
        },
      ],
      "hasMap": "https://www.google.com/maps?cid=9213821493223506062",
      "areaServed": [
        { "@type": "City", "name": "Rochester" },
        { "@type": "City", "name": "Brighton" },
        { "@type": "City", "name": "Pittsford" },
        { "@type": "City", "name": "Fairport" },
        { "@type": "City", "name": "Greece" },
      ],
      "founder": "Ontario Hearing Center",
      "foundingDate": "1956",
      "slogan": "Your guide to better hearing.",
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": SITE_NAME,
      "publisher": { "@id": `${SITE}/#organization` },
      "inLanguage": "en-US",
    },
  ],
};

const allSchemas = Array.isArray(schemaJsonLd) ? schemaJsonLd : (schemaJsonLd ? [schemaJsonLd] : []);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Google Analytics 4 (property: ontariohearing.com / 397242492) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HJ0Q9GC12X" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HJ0Q9GC12X');
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />

  <!-- Open Graph -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />

  <link rel="stylesheet" href="/global.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Source+Sans+3:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />

  <!-- JSON-LD: sitewide (Organization + WebSite) -->
  <script type="application/ld+json" set:html={JSON.stringify(sitewideSchema)} />

  <!-- JSON-LD: per-page (BreadcrumbList, WebPage, Article, Person, FAQPage, etc.) -->
  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
<div class="page">
  <TopBar />
  <SiteHeader currentPage={currentPage} />
  <main>
    <slot />
  </main>
  <SiteFooter />
</div>
<MobileStickyBar />
<!-- GA4 custom events: phone clicks + appointment-schedule intent.
     (page_view, session_start, scroll, outbound click, form_start/form_submit
     come from GA4 Enhanced Measurement automatically.) -->
<script is:inline>
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!a || typeof window.gtag !== 'function') return;
    var href = a.getAttribute('href') || '';
    if (href.indexOf('tel:') === 0) {
      gtag('event', 'click_phone_number', { link_url: href });
      return;
    }
    if (/schedule an appointment/i.test(a.textContent || '')) {
      gtag('event', 'Online Schedule', { link_url: href });
    }
  }, true);
</script>
</body>
</html>
