---
import Interior from "../layouts/Interior.astro";
import CtaStrip from "../components/CtaStrip.astro";
import pagesData from "../data/pages.json";
import { altFor } from "../lib/imageAlts";

// Curated resource list. Each entry resolves its title/excerpt from pages.json
// so copy stays in sync with the article itself; `image` is pinned here because
// a couple of posts share a featured image and the grid should not repeat one.
const CURATED: Array<{ slug: string; image?: string }> = [
  { slug: "rechargeable-hearing-aids", image: "/assets/img/mature-woman-with-hearing-aid-cc33bce0.webp" },
  { slug: "are-cheap-hearing-aids-worth-buying" },
  { slug: "what-is-a-hearing-doctor" },
  { slug: "over-the-counter-hearing-aids" },
  { slug: "what-kind-of-hearing-aids-would-work-best-for-me" },
  { slug: "should-you-get-a-hearing-test-online", image: "/assets/img/importance_of_hearing_tests_featured-5cd1afb0.webp" },
  { slug: "how-to-service-hearing-aids" },
  { slug: "what-helps-tinnitus-go-away" },
  { slug: "does-medicare-pay-for-hearing-aids" },
  { slug: "what-are-the-five-signs-of-hearing-loss" },
];

const bySlug = new Map((pagesData as any[]).map((p) => [p.slug, p]));

const posts = CURATED.map(({ slug, image }) => {
  const p: any = bySlug.get(slug);
  if (!p) return null;
  return {
    slug,
    title: (p.h1 ?? p.title ?? "").replace(/\s*[\|—-]\s*Ontario.*$/i, "").trim(),
    excerpt: p.meta_description ?? "",
    image: image ?? p.featured_image ?? "",
    read_time: Math.max(3, Math.round((p.content_markdown?.length ?? 1000) / 1500)) + " min read",
  };
}).filter(Boolean) as Array<{ slug: string; title: string; excerpt: string; image: string; read_time: string }>;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Hearing Health Resources",
  description:
    "Expert articles on hearing loss, hearing aids, tinnitus, and ear care from the audiologists at Ontario Hearing Center in Rochester, NY.",
  url: "https://ontariohearing.com/resources/",
  hasPart: posts.map((p) => ({
    "@type": "Article",
    headline: p.title,
    url: `https://ontariohearing.com/${p.slug}/`,
    image: p.image ? `https://ontariohearing.com${p.image}` : undefined,
  })),
};
---
<Interior
  title="Resources | Ontario Hearing Center"
  description="Read our blog to learn about hearing loss, hearing aids, tinnitus, and more. Our experts provide advice on the best ear care products available. We are your trusted resource for all things ears in Rochester NY!"
  pageTitle="Hearing health resources."
  pageSubtitle="Straightforward answers to the questions we hear most — written by the audiologists at Ontario Hearing Center."
  breadcrumbLabel="Resources"
  breadcrumbs={[{ label: "Home", href: "/" }]}
  canonical="https://ontariohearing.com/resources/"
  schemaJsonLd={schema}
>

  <section class="grid">
    <div class="grid__head">
      <h2 class="grid__title">Our recent posts</h2>
      <p style="color: var(--body); font-size: 16px;">{posts.length} articles</p>
    </div>
    <div class="cards-3 res-grid">
      {posts.map((p) => (
        <a class="pcard" href={`/${p.slug}/`}>
          <div class="pcard__media">
            {p.image
              ? <img src={p.image} alt={altFor(p.image, p.title)} loading="lazy" />
              : <div class="pcard__media-placeholder"></div>}
          </div>
          <div class="pcard__body">
            <p class="pcard__meta">Article · {p.read_time}</p>
            <h3 class="pcard__title">{p.title}</h3>
            <p class="pcard__excerpt">{p.excerpt}</p>
            <span class="pcard__more">Read more <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="res-more">
      <a class="btn btn--navy" href="/blog/">
        <span>View all articles</span><span class="arrow">→</span>
      </a>
    </div>
  </section>

  <CtaStrip />

</Interior>

<style>
  .res-grid { gap: 32px; margin-top: 32px; }
  .pcard {
    display: flex; flex-direction: column;
    background: #fff; border-radius: 8px; overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid #E1DCC8;
  }
  .pcard:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08); }
  .pcard:hover .pcard__more { gap: 10px; }
  .pcard__media { aspect-ratio: 16 / 10; overflow: hidden; background: #f5f2e8; }
  /* Anchor the crop to the top: several of these thumbnails are near-square
     marketing composites with the headline baked in at the top and an outdated
     "Ontario Hearing Centers" logo / address strip along the bottom. Cropping
     from the top keeps the headline readable and pushes the stale branding out
     of frame; the plain 16:10 photos lose only a few pixels off the bottom. */
  .pcard__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .pcard__media-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #BFE0CF 0%, #2F7D5B 100%); }
  .pcard__body { padding: 24px; flex: 1; display: flex; flex-direction: column; }
  .pcard__meta { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--green); margin: 0 0 8px; }
  .pcard__title { font-family: var(--font-serif); font-size: 22px; line-height: 1.3; color: var(--ink, #0A2540); margin: 0 0 12px; font-weight: 400; }
  .pcard__excerpt { font-size: 15px; line-height: 1.55; color: var(--body); margin: 0 0 16px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; color: var(--green); transition: gap 0.2s ease; }
  .res-more { margin-top: 48px; display: flex; justify-content: center; }
</style>
