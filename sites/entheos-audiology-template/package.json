{
  "name": "entheos-audiology-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "node scripts/build-css.mjs",
    "dev": "node scripts/build-css.mjs && astro dev",
    "build": "node scripts/build-css.mjs && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "upload-preview": "npm run build && wrangler versions upload",
    "seed:build": "tsx scripts/build-seed.ts",
    "seed:check": "emdash seed seed/seed.json --validate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.1.0",
    "@emdash-cms/cloudflare": "^1.2.0",
    "astro": "^7.3.8",
    "emdash": "^1.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "wrangler": "^4.99.0"
  },
  "emdash": {
    "label": "Entheos audiology template",
    "seed": "seed/seed.json"
  }
}
