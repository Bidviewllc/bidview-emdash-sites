---
import Icon from "./Icon.astro";
interface Props {
	size?: number;
	/** Announce the rating; leave off where the rating is already in the text. */
	label?: string;
	style?: string;
	/** Filled stars, 1 to 5; the rest show dimmed. */
	rating?: number;
}
const { size = 22, label, style, rating = 5 } = Astro.props;
---
<div class="stars" role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} style={style}>
	{[1, 2, 3, 4, 5].map((n) => (n <= rating ? <Icon name="star" size={size} /> : <span class="dim"><Icon name="star" size={size} /></span>))}
</div>
