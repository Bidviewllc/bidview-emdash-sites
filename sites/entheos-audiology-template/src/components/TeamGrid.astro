---
// "Meet the team" cards, laid out by the Review controls · Team cards choice:
// a three-column grid for the card layouts, one column for the list layout.
import type { Provider } from "../data/practice";
import { getSettings } from "../lib/settings";
import ProviderCard from "./ProviderCard.astro";

interface Props {
	people: (Provider & { linked: boolean })[];
	alignStart?: boolean;
}
const { people, alignStart = false } = Astro.props;
const s = getSettings(Astro.url);
---
{
	s.team === "list" ? (
		<div class="team-list">{people.map((p) => <ProviderCard p={p} linked={p.linked} />)}</div>
	) : (
		<div class="grid g-3 team-grid" style={`gap: 16px${alignStart ? "; align-items: start" : ""}`}>
			{people.map((p) => <ProviderCard p={p} linked={p.linked} />)}
		</div>
	)
}
