---
// Compact office card (Book appointment): address, tap-to-call phone, hours,
// "Get directions" to Google Maps. No map embed.
import { telHref, type Office } from "../data/practice";
import Icon from "./Icon.astro";

interface Props {
	o: Office;
	compact?: boolean;
}
const { o, compact = false } = Astro.props;
const H = compact ? "h3" : "h3";
---
<article class:list={["card bk-loc", { compact }]}>
	<H class={compact ? "h4" : "h3"}>{o.name}</H>
	<div class="drow"><span class="di"><Icon name="pin2" /></span><address style="font-style: normal; padding-top: 7px">{o.street}<br />{o.city}</address></div>
	<div class="drow"><span class="di"><Icon name="phone" /></span><a href={telHref(o.phone)} style="padding-top: 6px; font-weight: 700; font-size: 20px; white-space: nowrap">{o.phone}</a></div>
	<div class="drow"><span class="di"><Icon name="clock" /></span><span style="padding-top: 7px">{o.hoursLine}</span></div>
	<a class="link-arrow" href={o.mapsUrl} style="align-self: flex-start; margin-top: auto">Get directions <Icon name="arrowUR" size={18} /></a>
</article>
