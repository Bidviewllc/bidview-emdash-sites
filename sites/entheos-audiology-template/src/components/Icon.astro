---
// The design's icons, copied from the boards. Decorative by default (aria-hidden);
// buttons that use them carry their own aria-label.
interface Props {
	name: keyof typeof ICONS;
	size?: number;
}
const { name, size = 20 } = Astro.props;

const S = (d: string, w = 2) =>
	({ kind: "stroke", w, body: d.startsWith("<") ? d : `<path d="${d}"></path>` }) as const;
const F = (d: string) => ({ kind: "fill", body: `<path d="${d}"></path>` }) as const;

const ICONS = {
	phone: S("M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"),
	pin: S('<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path><circle cx="12" cy="9" r="2.5"></circle>'),
	pin2: S('<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>'),
	clock: S('<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>'),
	mail: S('<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path>'),
	chevD: S("m6 9 6 6 6-6", 2.2),
	chevU: S("m6 15 6-6 6 6", 2.2),
	arrowR: S("M5 12h14M13 6l6 6-6 6", 2.2),
	arrowL: S("M19 12H5M11 6l-6 6 6 6", 2.2),
	arrowUR: S("M7 17 17 7M8 7h9v9", 2.4),
	burger: S("M4 7h16M4 12h16M4 17h16", 2.2),
	close: S("M6 6l12 12M18 6 6 18", 2.2),
	plus: S("M12 5v14M5 12h14", 2.4),
	minus: S("M5 12h14", 2.4),
	pause: S("M9 5v14M15 5v14", 2.6),
	play: F("M8 5v14l11-7z"),
	star: F("m12 2.5 2.9 6 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6L2.5 9.3l6.6-.8z"),
	quote: F("M9.5 6H5a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h3c0 2-1 3.5-3 4l.5 1.5C9 17.5 10.5 15 10.5 11V7a1 1 0 0 0-1-1zm10 0H15a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h3c0 2-1 3.5-3 4l.5 1.5c3.5-1 5-3.5 5-7.5V7a1 1 0 0 0-1-1z"),
	facebook: S("M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"),
	instagram: S('<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5v.01"></path>'),
	youtube: S('<rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="m10 9.5 5 2.5-5 2.5z"></path>'),
	upload: S("M12 16V4M7 9l5-5 5 5M5 20h14", 2),
} as const;

const icon = ICONS[name];
---
{
	icon.kind === "stroke" ? (
		<svg
			viewBox="0 0 24 24"
			width={size}
			height={size}
			fill="none"
			stroke="currentColor"
			stroke-width={icon.w}
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			set:html={icon.body}
		/>
	) : (
		<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" set:html={icon.body} />
	)
}
