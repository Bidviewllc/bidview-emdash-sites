---
// A form from the admin (Plugins → Forms), drawn in the design. Half-width
// fields pair up two to a row; check-box groups and radios are the design's
// pill rows; the "location" select lists the practice's offices. Hidden fields
// (lead source, page, spam check) and the bot traps are filled in by the page
// script in Base.astro. Submissions go to /api/form.
import { fieldsOf, getForm, LOCATION_FIELD, TRACKING_FIELDS, type FormField } from "../lib/forms";
import { active, getMarketing, onLiveDomain } from "../lib/marketing";
import { getSettings } from "../lib/settings";
import Icon from "./Icon.astro";

interface Props {
	/** Form slug in the admin (contact, appointment-request). */
	slug: string;
	/** Prefix for element ids, unique on the page. */
	id: string;
	/** Full-width submit button (sidebar and narrow layouts). */
	blockButton?: boolean;
	/** Line under the button. */
	after?: string;
}
const { slug, id, blockButton = false, after } = Astro.props;
const s = getSettings(Astro);
const { id: formId, form } = await getForm(slug);
const fid = (name: string) => `${id}-${name}`;
const auto: Record<string, string> = { first: "given-name", last: "family-name", phone: "tel", email: "email" };
const errText = (f: FormField) =>
	f.type === "tel"
		? `Please enter a phone number so we can call you back, for example ${s.phone}.`
		: f.type === "email"
			? "Please enter an email address, for example name@example.com."
			: f.type === "select" || f.type === "radio"
				? `Please choose an answer for “${f.label}”.`
				: f.type === "checkbox-group"
					? `Please choose at least one for “${f.label}”.`
					: `Please enter your ${f.label.toLowerCase()}.`;
const optionsFor = (f: FormField) =>
	f.name === LOCATION_FIELD
		? [...s.offices.map((o) => ({ label: o.shortName, value: o.shortName })), ...(s.offices.length > 1 ? [{ label: "No preference", value: "No preference" }] : [])]
		: (f.options ?? []);

// Visible fields, with consecutive half-width fields paired into rows.
const visible = fieldsOf(form).filter((f) => f.type !== "hidden" && f.type !== "file");
const hidden = fieldsOf(form).filter((f) => f.type === "hidden");
const rows: FormField[][] = [];
for (const f of visible) {
	const last = rows[rows.length - 1];
	if (f.width === "half" && last && last.length === 1 && last[0].width === "half") last.push(f);
	else rows.push([f]);
}
const hasRequired = visible.some((f) => f.required);
// Cloudflare Turnstile (Marketing & tracking): live domain only, when both keys are saved.
const mk = await getMarketing();
const turnstile = onLiveDomain(mk, Astro.url.host) && active(mk, "turnstile_secret") ? active(mk, "turnstile_site_key") : "";
---
<div class="stack site-form" style="gap: 24px">
	{hasRequired && <p class="small muted" style="margin: 0">Fields marked <span aria-hidden="true">*</span><span class="sr">with an asterisk</span> are required.</p>}
	{
		rows.map((row) => {
			const cells = row.map((f) => {
				const desc = [f.helpText && f.name !== LOCATION_FIELD ? fid(`${f.name}-help`) : "", f.required ? fid(`${f.name}-err`) : ""].filter(Boolean).join(" ") || undefined;
				const mark = f.required && <span aria-hidden="true"> *</span>;
				const help = f.helpText && f.name !== LOCATION_FIELD && <p class="small muted" id={fid(`${f.name}-help`)} style="margin: 0">{f.helpText}</p>;
				const err = f.required && <p class="errmsg" id={fid(`${f.name}-err`)} hidden><Icon name="alert" /> {errText(f)}</p>;
				if (f.type === "checkbox-group" || f.type === "radio") {
					return (
						<fieldset class="field" data-group={f.required ? f.name : undefined} aria-describedby={desc}>
							<legend style="margin-bottom: 8px">{f.label}{mark}</legend>
							{help}
							<div class:list={["checks", { "bk-days": optionsFor(f).length > 3 }]}>
								{optionsFor(f).map((o) => (
									<label class="check"><input type={f.type === "radio" ? "radio" : "checkbox"} name={f.name} value={o.value} /> {o.label}</label>
								))}
							</div>
							{err}
						</fieldset>
					);
				}
				if (f.type === "checkbox") {
					return (
						<div class="field">
							<label class="check"><input type="checkbox" name={f.name} value="Yes" required={f.required} aria-describedby={desc} /> {f.label}{mark}</label>
							{help}
							{err}
						</div>
					);
				}
				return (
					<div class="field">
						<label for={fid(f.name)}>{f.label}{mark}</label>
						{help}
						{f.type === "textarea" ? (
							<textarea class="input" id={fid(f.name)} name={f.name} rows="5" placeholder={f.placeholder} required={f.required} aria-describedby={desc}>{f.defaultValue}</textarea>
						) : f.type === "select" ? (
							<select class="input" id={fid(f.name)} name={f.name} required={f.required} aria-describedby={desc}>
								{f.name !== LOCATION_FIELD && <option value="">Choose one</option>}
								{optionsFor(f).map((o) => <option value={o.value} selected={o.value === f.defaultValue}>{o.label}</option>)}
							</select>
						) : (
							<input class="input" id={fid(f.name)} name={f.name} type={f.type} autocomplete={auto[f.name]} placeholder={f.placeholder} value={f.defaultValue} required={f.required} aria-describedby={desc} />
						)}
						{err}
					</div>
				);
			});
			return row.length === 2 ? <div class="grid g-2 form-2" style="gap: 20px">{cells}</div> : cells;
		})
	}
	<input type="hidden" name="_form" value={slug} />
	<input type="hidden" name="_fs" value="" data-fs />
	{hidden.map((f) => <input type="hidden" name={f.name} value={(TRACKING_FIELDS as readonly string[]).includes(f.name) ? "" : (f.defaultValue ?? "")} />)}
	<div class="hp" aria-hidden="true"><label for={fid("website")}>Website</label><input id={fid("website")} name="website" type="text" tabindex="-1" autocomplete="off" /></div>
	{turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-action="form" data-size="flexible" />}
	{turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
	<p class="errmsg" data-form-error hidden role="alert" tabindex="-1"><Icon name="alert" /> <span>Sorry, that didn’t send. Please try again, or call us at {s.phone}.</span></p>
	<div class="stack g16" style="padding-top: 4px">
		<button class:list={["btn btn-primary", { block: blockButton }]} type="submit" style={blockButton ? undefined : "align-self: flex-start"} data-form-id={formId}>{form.settings.submitLabel || "Send"}</button>
		{after && <p class="small muted" style={`margin: 0; max-width: 560px${blockButton ? "; text-align: center; align-self: center" : ""}`}>{after}</p>}
	</div>
</div>
