				{
					showPosts && (
						<div class="panel">
							<div class="card side-card" style="gap: 8px">
								<h2 class="h3" style="margin-bottom: 6px">From our audiologists</h2>
								{posts.map((p) => (
									<a class="mini-post" href={h(routes.post(p.slug))}>
										<div class:list={["ph", p.tone]} />
										<div class="stack" style="gap: 2px"><span class="date">{p.date}</span><b>{p.title}</b></div>
									</a>
								))}
							</div>
						</div>
					)
				}
			</aside>
		</div>
	</section>

	<section class="band sd-faq" style="padding-top: 0">
		<div class="wrap faq-grid">
			<div class="stack g24">
				<span class="eyebrow">FAQ</span>
				<h2 class="h2">Frequently asked questions about {service.name.toLowerCase()}</h2>
				<div class="only-d" style="padding-top: 8px"><a class="btn btn-primary" href={h(routes.contact)}>Contact us</a></div>
			</div>
			<div class="acc-list">
				{
					faq.map((it, i) => (
						<div class:list={["acc", { open: i === 0 }]} data-acc>
							<h3 style="margin: 0">
								<button class="acc-btn" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-${i}`}>
									<span>{it.q}</span>
									<span class="acc-ic" aria-hidden="true"><span class="i-open"><Icon name="plus" /></span><span class="i-close"><Icon name="minus" /></span></span>
								</button>
							</h3>
							<div class="acc-body" id={`faq-${i}`} hidden={i !== 0}><p>{it.a}</p></div>
						</div>
					))
				}
			</div>
			<a class="btn btn-primary block only-m" href={h(routes.contact)}>Contact us</a>
		</div>
	</section>

	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="shead">
				<div class="stack g16"><span class="eyebrow">Services</span><h2 class="h2">Related services</h2></div>
				<a class="link-arrow" href={h(routes.services)}>All services <Icon name="arrowR" size={18} /></a>
			</div>
			<div class="panel grid g-3">
				{
					related.map((x) => (
						<article class="card">
							<h3 class="h3">{x.name}</h3>
							<p class="muted">{x.summary}</p>
							{x.hasPage && (
								<div class="actions">
									<a class="btn btn-gray sm" href={h(routes.service(x.slug))}>Learn more<span class="sr"> about {x.name}</span></a>
								</div>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<div class="cta-wrap after-inset">
		<CtaBand id="dcta" heading={service.ctaHeading} text="Consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore. Magna aliqua ut enim ad minim." bookLabel={service.bookLabel} photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>

<script>
	// Sidebar review carousel: moves only when the reader asks it to.
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((box) => {
		const slides = [...box.querySelectorAll<HTMLElement>("[data-slide]")];
		const dots = [...box.querySelectorAll<HTMLButtonElement>("[data-dot]")];
		let i = 0;
		const show = (n: number) => {
			i = (n + slides.length) % slides.length;
			slides.forEach((s, k) => (s.hidden = k !== i));
			dots.forEach((d, k) => {
				d.classList.toggle("on", k === i);
				d.setAttribute("aria-current", k === i ? "true" : "false");
			});
		};
		box.querySelector("[data-prev]")?.addEventListener("click", () => show(i - 1));
		box.querySelector("[data-next]")?.addEventListener("click", () => show(i + 1));
		dots.forEach((d, k) => d.addEventListener("click", () => show(k)));
	});
</script>
