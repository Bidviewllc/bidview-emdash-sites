---
// Page 3 · Service detail (boards ServiceDetail, ServiceDetailMobile,
// ServiceDetailPosts, ServiceDetailAlt). One template for every service.
// Hero → rich text with a right sidebar (Book card, reviews, recent posts) →
// FAQ → related services → CTA.
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import Stars from "../../components/Stars.astro";
import Base from "../../layouts/Base.astro";
import { ptHas, ptToHtml } from "../../lib/portable-text";
import { getSettings } from "../../lib/settings";
import { routes, telHref } from "../../lib/routes";

const { latest: posts, practice, services, sidebarReviews } = Astro.locals.site;

const service = services.find((x) => x.slug === Astro.params.slug);
const faq = service?.faq ?? [];
// "Give this service its own page" off = no page (switch-on rule).
if (!service || !service.hasPage) return Astro.rewrite("/404");

const tweaks: Tweak[] = [
	{ key: "reviews", label: "Sidebar reviews", type: "choice", default: "single", options: [["single", "Single review"], ["carousel", "Carousel (3)"]] },
	{ key: "revlink", label: "“Read more reviews” link", type: "bool", default: true },
	{ key: "posts", label: "Recent posts card", type: "bool", default: true },
	{ key: "sticky", label: "Sticky sidebar", type: "bool", default: true },
];

const s = getSettings(Astro);
const h = s.href;
const hero = s.heroFor("photo", service.heroImage);
const withPhoto = hero === "photo" || hero === "example";
const prim = hero === "primary";
const carousel = s.choice("reviews", ["single", "carousel"], "single") === "carousel";
const revLink = s.bool("revlink", true);
const showPosts = s.bool("posts", true);
const sticky = s.bool("sticky", true);
const tel = telHref(s.phone);
const city = practice.city;
const title = `${service.name} in ${city}`;
const related = services.filter((x) => x.slug !== service.slug && !x.hideFromHub).slice(0, 3);
const rvList = carousel ? sidebarReviews : sidebarReviews.slice(0, 1);
/** The service write-up from EmDash; the sample below shows until there is one. */
const rich = ptHas(service.content) ? ptToHtml(service.content) : undefined;
if (rich) rich.html = s.fill(rich.html);
const sampleToc = [
	{ id: "sd-tells", label: `What ${service.name.toLowerCase()} can tell you` },
	{ id: "sd-visit", label: "What happens during your visit" },
	{ id: "sd-who", label: "Who should schedule a visit" },
	{ id: "sd-why", label: `Why patients choose ${s.name}` },
];
const toc = rich ? rich.headings : sampleToc;
const shapeA = prim ? "color-mix(in srgb, var(--on-p) 8%, transparent)" : "color-mix(in srgb, var(--p) 7%, transparent)";
const shapeB = prim ? "color-mix(in srgb, var(--on-p) 6%, transparent)" : "color-mix(in srgb, var(--a) 14%, transparent)";
const crumbs = (
	[
		["Home", routes.home],
		["Services", routes.services],
	] as const
);
---
<Base
	title={`${title} | ${s.name}`}
	description={service.summary}
	pageName="Service detail"
	current="services"
	tweaks={tweaks}
	heroDefault="photo"
>
	{
		withPhoto ? (
			<section class="sd-hero">
				<div class="wrap ihero">
					<div class="stack g24">
						<nav aria-label="Breadcrumb">
							<ol class="crumbs">
								{crumbs.map(([l, u]) => (<><li><a href={h(u)}>{l}</a></li><li class="sep" aria-hidden="true">/</li></>))}
								<li aria-current="page">{service.name}</li>
							</ol>
						</nav>
						<h1 class="h1">{title}</h1>
						<p class="lead">{s.fill(service.intro ?? "")}</p>
						<div class="rowf hero-btns" style="gap: 12px; margin-top: 4px">
							<a class="btn btn-primary" href={h(routes.book)}>{service.bookLabel}</a>
							<a class="btn btn-secondary" href={tel}>Call {s.phone}</a>
						</div>
					</div>
					{hero === "example" ? (
						<div class="phimg"><img src="/assets/photos/consult.jpg" alt="An audiologist smiling as she talks with a patient across her desk" style="object-position: 55% 30%" /></div>
					) : service.heroImage ? (
						<div class="phimg"><img src={service.heroImage.src} alt={service.heroImage.alt} /></div>
					) : (
						<div class="ph warm" style="aspect-ratio: 3/2; border-radius: var(--r-hero)"><span class="ph-label">Page hero photo · 3:2, landscape</span></div>
					)}
				</div>
			</section>
		) : (
			<div class="sd-hero-np">
				<section class:list={["inophoto", { "on-p-text": prim }]} style={prim ? "background: var(--p); color: var(--on-p)" : "background: var(--l); color: var(--on-l)"}>
					<div class="shape np1" style={`border-color: ${shapeA}`} />
					<div class="shape np2" style={`border-color: ${shapeB}`} />
					<div class="wrap">
						<div class="stack g24" style="max-width: 860px">
							<nav aria-label="Breadcrumb">
								<ol class="crumbs">
									{crumbs.map(([l, u]) => (<><li><a href={h(u)}>{l}</a></li><li class="sep" aria-hidden="true">/</li></>))}
									<li aria-current="page">{service.name}</li>
								</ol>
							</nav>
							<h1 class="h1 xl" style="color: inherit">{title}</h1>
							<p class="lead" style="color: inherit; opacity: .88; max-width: 720px">Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod. Tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud. Exercitation ullamco laboris nisi ut aliquip ex ea commodo. Consequat duis aute irure dolor in reprehenderit in voluptate velit.</p>
							<div class="rowf hero-btns" style="gap: 12px; margin-top: 4px">
								<a class:list={["btn", prim ? "btn-inverse" : "btn-primary"]} href={h(routes.book)}>{service.bookLabel}</a>
								<a class:list={["btn", prim ? "btn-ghost-on-p" : "btn-secondary"]} href={tel}>Call {s.phone}</a>
							</div>
						</div>
					</div>
				</section>
			</div>
		)
	}

	<section class:list={["sd-main", { "after-photo": withPhoto }]}>
		<div class="wrap side-layout">
			<div class="stack g32">
				<nav class="jump acc" aria-label="Table of contents" data-acc>
					<h2 style="margin: 0">
						<button class="jump-btn" type="button" aria-expanded="false" aria-controls="sd-toc">
							<span>Table of contents</span>
							<span class="acc-ic" aria-hidden="true"><span class="i-open"><Icon name="chevD" size={22} /></span><span class="i-close"><Icon name="chevU" size={22} /></span></span>
						</button>
					</h2>
					<div class="jump-body" id="sd-toc" hidden>
						<ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
					</div>
				</nav>
