---
// Page 7 · Provider profile (boards PersonPage, PersonMobile, PersonPageAlt).
// Profile header (4:5 headshot + text, vertically centred) → full-width bio →
// intro video (optional) → locations (as Home) → services (as Home) → CTA.
import CtaBand from "../../components/CtaBand.astro";
import Headshot from "../../components/Headshot.astro";
import Icon from "../../components/Icon.astro";
import OfficesSection from "../../components/OfficesSection.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import ServiceCards from "../../components/ServiceCards.astro";
import { practice, providers, routes, services, telHref } from "../../data/practice";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";

const person = providers.find((p) => p.slug === Astro.params.person);
if (!person) return Astro.rewrite("/404");

const tweaks: Tweak[] = [{ key: "video", label: "Intro video", type: "bool", default: true }];
const s = getSettings(Astro.url);
const h = s.href;
const showVideo = s.bool("video", true);
const crumbName = person.name.replace(/, Au\.D\.$/, "");
---
<Base title={`${person.name}, ${person.title} | ${s.name}`} description={`${person.name} is ${person.title.toLowerCase()} at ${s.name}.`} pageName="Provider profile" current="about" tweaks={tweaks}>
	<section class="prof-hero">
		<div class="wrap prof">
			<div class="panel prof-img"><Headshot tone={person.tone} /></div>
			<div class="stack g24 prof-txt">
				<nav aria-label="Breadcrumb">
					<ol class="crumbs">
						<li><a href={h(routes.home)}>Home</a></li><li class="sep" aria-hidden="true">/</li>
						<li><a href={h(routes.about)}>About</a></li><li class="sep" aria-hidden="true">/</li>
						<li aria-current="page">{crumbName}</li>
					</ol>
				</nav>
				<div class="stack g12">
					<h1 class="h1">{person.name}</h1>
					<p class="prof-title">{person.title}</p>
				</div>
				<div class="rowf hero-btns" style="gap: 12px; margin-top: 8px">
					<a class="btn btn-primary" href={h(routes.book)}>Book appointment</a>
					<a class="btn btn-secondary" href={telHref(s.phone)}>Call {s.phone}</a>
				</div>
			</div>
		</div>
	</section>

	<section class="band bio-band">
		<div class="wrap">
			<div class="rt" style="max-width: none">
				<p>Pellentesque sed dapibus est sed lacinia sapien vel tellus lorem ipsum. Dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore. Magna aliqua ut enim ad minim veniam quis nostrud. <strong>Exercitation ullamco laboris nisi ut aliquip</strong> ex ea commodo consequat duis aute irure. Dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident.</p>
				<p>Tincidunt lacus nulla gravida orci a odio nullam varius turpis et commodo. Pharetra est eros bibendum elit nec luctus magna felis sollicitudin mauris. Integer in mauris eu nibh euismod gravida praesent blandit odio eu enim pellentesque sed dapibus. Est sed lacinia sapien vel tellus lorem ipsum dolor. Sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
				<h3>Clinical interests</h3>
				<p>Ad minim veniam quis nostrud exercitation ullamco laboris nisi ut. Aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in voluptate velit. Esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non. Proident sunt in culpa qui officia deserunt mollit anim id est.</p>
				<h3>Education and credentials</h3>
				<ul>
					<li><strong>Doctor of Audiology,</strong> Felis sollicitudin mauris integer in mauris.</li>
					<li><strong>Bachelor of Science,</strong> Eu nibh euismod gravida praesent.</li>
					<li><strong>Board certified,</strong> Blandit odio eu enim pellentesque sed.</li>
				</ul>
				<h3>Outside the clinic</h3>
				<p>Dapibus est sed lacinia sapien vel tellus lorem ipsum dolor sit amet consectetur adipiscing. Elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi. Ut aliquip ex ea commodo consequat duis aute irure dolor in <a href={h(routes.about)}>reprehenderit in voluptate</a> velit.</p>
			</div>
		</div>
	</section>

	{
		showVideo && (
			<section class="band pt0">
				<div class="wrap stack g32" style="max-width: 1040px">
					<h2 class="h2">Meet {person.short}</h2>
					<div class="vplayer" data-video>
						<img class="vposter" src="/assets/photos/consult.jpg" alt="" />
						<div class="vshade" />
						<button class="vbig" type="button" data-play aria-label={`Play video: Meet ${person.short} (2:14)`}><Icon name="play" size={40} /></button>
						<p class="vcap" hidden><span>Captions appear here, in large, high-contrast text.</span></p>
						<div class="vbar">
							<button class="vbtn" type="button" data-play aria-label="Play"><span class="i-play"><Icon name="play" size={22} /></span><span class="i-pause" hidden><Icon name="pause" size={22} /></span></button>
							<div class="vtrack" role="presentation"><span style="width: 0%" /></div>
							<span class="vtime">0:00 / 2:14</span>
							<button class="vbtn" type="button" aria-label="Mute"><Icon name="volume" size={22} /></button>
							<button class="vbtn" type="button" data-cc aria-pressed="false" aria-label="Captions"><Icon name="captions" size={22} /></button>
							<button class="vbtn" type="button" aria-label="Full screen"><Icon name="fullscreen" size={22} /></button>
						</div>
					</div>
					<p class="small muted">Sample player: the practice's own video goes here, with captions.</p>
				</div>
			</section>
		)
	}

	<OfficesSection />

	<section class="band">
		<div class="wrap stack g48">
			<div class="stack g16" style="max-width: 760px">
				<span class="eyebrow">Services</span>
				<h2 class="h2">Hearing care services in {practice.city}</h2>
				<p class="lead">Ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in voluptate velit esse cillum. Dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non. Proident sunt in.</p>
			</div>
			<div class="stack g24">
				<ServiceCards items={services.filter((x) => x.onHome !== false && !x.hideFromHub)} />
				<a class="link-arrow" href={h(routes.services)} style="align-self: flex-start">View all services <Icon name="arrowR" size={18} /></a>
			</div>
		</div>
	</section>

	<div class="cta-wrap">
		<CtaBand id="pcta" heading="Book your appointment" text={`Pellentesque sed dapibus est sed lacinia sapien vel tellus lorem ipsum. Dolor sit amet consectetur adipiscing elit.`} photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>

<script>
	// Sample video player: shows the playing state and captions toggle (no real video yet).
	document.querySelectorAll<HTMLElement>("[data-video]").forEach((v) => {
		const big = v.querySelector<HTMLElement>(".vbig")!;
		const bar = v.querySelector<HTMLElement>(".vtrack span")!;
		const time = v.querySelector<HTMLElement>(".vtime")!;
		const playBtn = v.querySelector<HTMLButtonElement>(".vbar [data-play]")!;
		let playing = false;
		v.querySelectorAll("[data-play]").forEach((b) =>
			b.addEventListener("click", () => {
				playing = !playing;
				big.hidden = true;
				bar.style.width = "28%";
				time.textContent = "0:37 / 2:14";
				playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
				playBtn.querySelector<HTMLElement>(".i-play")!.hidden = playing;
				playBtn.querySelector<HTMLElement>(".i-pause")!.hidden = !playing;
				if (playing) playBtn.focus();
			}),
		);
		const cc = v.querySelector<HTMLButtonElement>("[data-cc]")!;
		cc.addEventListener("click", () => {
			const on = cc.getAttribute("aria-pressed") !== "true";
			cc.setAttribute("aria-pressed", String(on));
			cc.classList.toggle("on", on);
			v.querySelector<HTMLElement>(".vcap")!.hidden = !on;
		});
	});
</script>
