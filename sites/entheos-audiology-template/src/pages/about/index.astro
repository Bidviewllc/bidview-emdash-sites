---
// Page 6 · About (boards AboutPage, AboutMobile, AboutPageAlt, AboutPageAltB).
// Hero → story → journey timeline (grid, horizontal or hidden) → values → team
// (provider cards, no bios) → community (optional) → credentials (optional) → CTA.
// Hidden sections never leave a double gap: the next white band drops its top padding.
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import TeamGrid from "../../components/TeamGrid.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";
import Photo from "../../components/Photo.astro";

const { associations, milestones, practice, providers, values } = Astro.locals.site;

const tweaks: Tweak[] = [
	{ key: "journey", label: "Our journey", type: "choice", default: "grid", options: [["grid", "Grid 2 × 2"], ["row", "Horizontal"], ["hidden", "Hidden"]] },
	{ key: "profiles", label: "Provider profiles linked", type: "bool", default: true },
	{ key: "community", label: "Community section", type: "bool", default: true },
	{ key: "creds", label: "Credentials section", type: "bool", default: true },
];
const s = getSettings(Astro);
const tx = s.text;
const hero = s.heroFor("photo");
const withPhoto = hero === "photo" || hero === "example";
const journey = s.choice("journey", ["grid", "row", "hidden"], "grid");
const profiles = s.bool("profiles", true);
const community = s.bool("community", true);
const creds = s.bool("creds", true);
const credHeights: Record<string, string> = { ada: "40px", aaa: "50px", aba: "54px", asha: "46px", hearingup: "40px" };
---
<Base title={`About us | ${s.name}`} description={practice.tagline} pageName="About" current="about" tweaks={tweaks} heroDefault="photo">
	<PageHero
		crumbs={[{ label: "Home" }, { label: "About" }]}
		title={tx("heading")}
		lead={tx("intro")}
		photoLabel="Team photo · 3:2"
	/>

	<section class:list={["band first", { "after-photo": withPhoto }]}>
		<div class="wrap about" style="align-items: start">
			<div class="stack g24">
				<span class="eyebrow">Our story</span>
				<h2 class="h2">{tx("about_story_heading")}</h2>
				{s.paras("about_story_text").map((p) => <p class="body">{p}</p>)}
			</div>
			<Photo photo={practice.photos.team} label="Team photo · 3:2" tone="stone" class="story-photo" />
		</div>
	</section>

	{
		journey === "grid" && (
			<section class="band bg-light">
				<div class="wrap journey-grid">
					<div class="stack g24">
						<span class="eyebrow">Our journey</span>
						<h2 class="h2">{tx("about_journey_heading")}</h2>
						<p class="lead">{tx("about_journey_intro")}</p>
					</div>
					<ol class="panel grid g-2 ms-list" style="list-style: none; margin: 0">
						{milestones.map((m) => <li class="ms"><div class="yr">{m.y}</div><p>{m.t}</p></li>)}
					</ol>
				</div>
			</section>
		)
	}
	{
		journey === "row" && (
			<section class="band bg-light">
				<div class="wrap stack g48">
					<div class="two-col" style="align-items: end; gap: 80px">
						<div class="stack g16"><span class="eyebrow">Our journey</span><h2 class="h2">{tx("about_journey_heading")}</h2></div>
						<p class="lead">{tx("about_journey_intro")}</p>
					</div>
					<ol class="panel grid g-4 ms-list" style="list-style: none; margin: 0">
						{milestones.map((m) => <li class="ms"><div class="yr">{m.y}</div><p>{m.t}</p></li>)}
					</ol>
				</div>
			</section>
		)
	}

	<section class:list={["band", { pt0: journey === "hidden" }]}>
		<div class="wrap stack g48">
			<div class="stack g16 text-col">
				<span class="eyebrow">Our values</span>
				<h2 class="h2">{tx("about_values_heading")}</h2>
			</div>
			<div class="panel grid g-4">
				{
					values.map((v) => (
						<article class="card val">
							<span class="qmark"><Icon name={v.icon} size={28} /></span>
							<h3 class="h4">{v.t}</h3>
							<p class="muted">{v.d}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="band bg-light" id="team">
		<div class="wrap stack g48">
			<div class="stack g16 text-col">
				<span class="eyebrow">Our team</span>
				<h2 class="h2">{tx("about_team_heading")}</h2>
			</div>
			<TeamGrid people={providers.map((p) => ({ ...p, linked: profiles && p.hasPage }))} alignStart />
		</div>
	</section>

	{
		community && (
			<section class="band">
				<div class="wrap about community">
					<Photo photo={Astro.locals.site.pages.about.communityPhoto} label="Community photo · 3:2 (event, school screening, sponsorship)" tone="sky" />
					<div class="stack g24">
						<span class="eyebrow">Community</span>
						<h2 class="h2">{tx("about_community_heading")}</h2>
						<p class="body">{tx("about_community_text")}</p>
					</div>
				</div>
			</section>
		)
	}

	{
		creds && (
			<section class="band bg-gray">
				<div class="wrap stack g32">
					<div class="two-col" style="align-items: end; gap: 80px">
						<div class="stack g16"><span class="eyebrow">Credentials</span><h2 class="h2">{tx("about_creds_heading")}</h2></div>
						<p class="body">{tx("about_creds_text")}</p>
					</div>
					<ul class="creds">
						{associations.map((a) => <li class="cred"><img src={`/assets/associations/color/${a.key}.png`} alt={a.name} style={`max-height: ${credHeights[a.key] ?? "44px"}`} /></li>)}
						<li class="cred add"><Icon name="plus" />Additional badge (optional)</li>
					</ul>
				</div>
			</section>
		)
	}

	<div class:list={["cta-wrap", { "after-inset": creds || !community }]}>
		<CtaBand id="acta" heading={tx("cta_heading")} text={tx("cta_text")} photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>
