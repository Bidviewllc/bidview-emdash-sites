---
// Page 1 · Home (boards Home1 + Home2, HomeMobile, HomeStates).
// Hero with trust bar → about teaser → providers → services → brands →
// reviews → locations → latest posts → CTA.
import CtaBand from "../components/CtaBand.astro";
import HomeHero from "../components/HomeHero.astro";
import OfficesSection from "../components/OfficesSection.astro";
import TeamGrid from "../components/TeamGrid.astro";
import ReviewCard from "../components/ReviewCard.astro";
import ServiceCards from "../components/ServiceCards.astro";
import Icon from "../components/Icon.astro";
import type { Tweak } from "../components/ReviewControls.astro";
import Stars from "../components/Stars.astro";
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/settings";
import { routes } from "../lib/routes";
import Photo from "../components/Photo.astro";

const { brands, latest: posts, practice, providers, reviews, services } = Astro.locals.site;

const tweaks: Tweak[] = [
	{ key: "about", label: "“Read our story” link", type: "bool", default: true },
	{ key: "provlinks", label: "Provider profiles linked", type: "bool", default: true },
	{ key: "svclinks", label: "Service “Learn more”", type: "choice", default: "mixed", options: [["mixed", "Mixed (pages that exist)"], ["all", "All cards"], ["none", "None"]] },
	{ key: "sample", label: "Sample card with photo", type: "bool", default: false },
	{ key: "brandlinks", label: "Brand tiles", type: "choice", default: "mixed", options: [["mixed", "Mixed (pages that exist)"], ["all", "All linked"], ["none", "All plain"]] },
	{ key: "revlink", label: "“Read more reviews” link", type: "bool", default: true },
	{ key: "posts", label: "Latest posts", type: "bool", default: true },
	{ key: "trustmove", label: "Trust bar logos", type: "choice", default: "scroll", options: [["scroll", "Scrolling (with pause)"], ["still", "Still"]] },
	{ key: "trustrating", label: "Trust bar rating", type: "choice", default: "boxed", options: [["boxed", "In its own box"], ["plain", "Plain (no box)"]] },
];

const s = getSettings(Astro);
const tx = s.text;
const h = s.href;
const aboutLink = s.bool("about", true);
const provLinked = s.bool("provlinks", true);
const svcLinks = s.choice("svclinks", ["mixed", "all", "none"], "mixed");
const sample = s.bool("sample", false);
const brandLinks = s.choice("brandlinks", ["mixed", "all", "none"], "mixed");
const revLink = s.bool("revlink", true);
const showPosts = s.bool("posts", true);

const brandTiles = brands.filter((b) => !b.hideFromHub).map((b) => ({ ...b, linked: brandLinks === "all" ? true : brandLinks === "none" ? false : b.hasPage }));
const team = providers.map((p) => ({ ...p, linked: provLinked && p.hasPage }));
const city = practice.city;
---
<Base
	title={`${s.name} | Audiologists in ${city}`}
	description={practice.tagline}
	pageName="Home"
	tweaks={tweaks}
	heroDefault="photo"
>
	<HomeHero />

	<section class="band">
		<div class="wrap about">
			<Photo photo={practice.photos.team} label="Team photo · 3:2" tone="stone" />
			<div class="stack g24">
				<span class="eyebrow">About us</span>
				<h2 class="h2">{tx("home_about_heading")}</h2>
				<p class="body">{tx("home_about_text")}</p>
				<div class="panel grid g-2 facts" style="--pad: 12px">
					<div class="fact"><b>{practice.years}</b><span>caring for {city}</span></div>
					<div class="fact"><b>Au.D.</b><span>Doctors of Audiology on staff</span></div>
				</div>
				{aboutLink && <a class="link-arrow" href={h(routes.about)} style="align-self: flex-start">Read our story <Icon name="arrowR" size={18} /></a>}
			</div>
		</div>
	</section>

	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="stack g16 text-col">
				<span class="eyebrow">Our team</span>
				<h2 class="h2">{tx("home_team_heading")}</h2>
				<p class="lead">{tx("home_team_intro")}</p>
			</div>
			<TeamGrid people={team} />
		</div>
	</section>

	<section class="band">
		<div class="wrap stack g48">
			<div class="stack g16" style="max-width: 760px">
				<span class="eyebrow">Services</span>
				<h2 class="h2">{tx("home_services_heading")}</h2>
				<p class="lead">{tx("home_services_intro")}</p>
			</div>
			<div class="stack g24">
				<ServiceCards links={svcLinks} items={services.filter((x) => x.onHome !== false && !x.hideFromHub)} />
				<a class="link-arrow" href={h(routes.services)} style="align-self: flex-start">View all services <Icon name="arrowR" size={18} /></a>
			</div>
			{
				sample && (
					<div class="stack g12" style="max-width: 400px">
						<span class="state-label">Card with optional photo (sample, not part of the grid)</span>
						<div class="panel">
							<article class="card">
								<div class="ph sage" style="aspect-ratio: 4/3"><span class="ph-label">Service card image · 4:3</span></div>
								<h3 class="h3" style="margin-top: 8px">{services[0].name}</h3>
								<p class="muted">{services[0].summary}</p>
								<div class="actions"><a class="btn btn-gray sm" href={h(routes.service(services[0].slug))}>Learn more<span class="sr"> about {services[0].name}</span></a></div>
							</article>
						</div>
					</div>
				)
			}
		</div>
	</section>

	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="stack g16" style="max-width: 760px">
				<span class="eyebrow">Hearing aids</span>
				<h2 class="h2">{tx("home_brands_heading")}</h2>
				<p class="lead">{tx("home_brands_intro")}</p>
			</div>
			<div class="panel" style="--pad: 12px">
				<ul class="brands" style="list-style: none; margin: 0; padding: 0">
					{
						brandTiles.map((b) => (
							<li style="display: contents">
								{b.linked ? (
									<a class="brandtile" href={h(routes.brand(b.slug))}>
										<span class="go" aria-hidden="true"><Icon name="arrowUR" size={14} /></span>
										<span class="lbox"><img src={b.logo} alt={b.name} style={`max-width: 160px; max-height: ${b.logoHeight}; width: auto; height: auto; display: block`} /></span>
										<span class="sr"> hearing aids</span>
									</a>
								) : (
									<div class="brandtile plain">
										<span class="lbox"><img src={b.logo} alt={b.name} style={`max-width: 160px; max-height: ${b.logoHeight}; width: auto; height: auto; display: block`} /></span>
									</div>
								)}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap stack g48">
			<div class="stack g16">
				<span class="eyebrow">Reviews</span>
				<h2 class="h2">{tx("home_reviews_heading")}</h2>
				<div class="rowf" style="gap: 12px">
					<Stars size={24} />
					<span class="lead" style="color: var(--ink)"><b>{practice.rating.score} out of 5</b> from {practice.rating.count} Google reviews</span>
				</div>
			</div>
			<div class="stack g24" data-review-pager>
				<div class="panel grid g-2">
					{reviews.map((r, i) => <ReviewCard review={r} index={i} hidden={i > 1} />)}
				</div>
				<div class="rv-row">
					<div class="rowf rv-pager" style="gap: 12px">
						<button class="icon-btn" type="button" data-prev aria-label="Previous reviews" style="background: var(--panel); color: var(--ink)"><Icon name="arrowL" size={22} /></button>
						<button class="icon-btn" type="button" data-next aria-label="Next reviews" style="background: var(--p); color: var(--on-p)"><Icon name="arrowR" size={22} /></button>
						<span class="small muted" aria-live="polite" style="margin-left: 6px" data-page-label>1 of {Math.ceil(reviews.length / 2)}</span>
					</div>
					{revLink && <a class="link-arrow" href={h(routes.reviews)}>Read more reviews <Icon name="arrowR" size={18} /></a>}
				</div>
			</div>
		</div>
	</section>

	<OfficesSection />

	{
		showPosts && (
			<section class="band">
				<div class="wrap stack g48">
					<div class="shead">
						<div class="stack g16"><span class="eyebrow">Articles</span><h2 class="h2">{tx("home_blog_heading")}</h2></div>
						<a class="link-arrow" href={h(routes.blog)}>All posts <Icon name="arrowR" size={18} /></a>
					</div>
					<div class="grid g-3 posts-grid" style="gap: 32px">
						{posts.map((p) => (
							<a class="post" href={h(routes.post(p.slug))}>
								<div class="img">
									<div class:list={["ph", p.tone]} style="aspect-ratio: 16/9"><span class="ph-label tl">16:9</span></div>
									<span class="badge" aria-hidden="true"><Icon name="arrowUR" size={22} /></span>
								</div>
								<span class="date">{p.date}</span>
								<h3 class="ptitle">{p.title}</h3>
								<p class="sum">{p.summary}</p>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<div class:list={["cta-wrap", { "after-inset": !showPosts }]}>
		<CtaBand id="hcta" heading={tx("cta_heading")} text={tx("cta_text")} />
	</div>
</Base>

<script>
	// Reviews: two at a time, with previous / next.
	document.querySelectorAll<HTMLElement>("[data-review-pager]").forEach((box) => {
		const cards = [...box.querySelectorAll<HTMLElement>("[data-review]")];
		const pages = Math.ceil(cards.length / 2);
		const label = box.querySelector<HTMLElement>("[data-page-label]")!;
		let page = 0;
		const show = () => {
			cards.forEach((c, i) => (c.hidden = Math.floor(i / 2) !== page));
			label.textContent = `${page + 1} of ${pages}`;
		};
		box.querySelector("[data-prev]")!.addEventListener("click", () => { page = (page - 1 + pages) % pages; show(); });
		box.querySelector("[data-next]")!.addEventListener("click", () => { page = (page + 1) % pages; show(); });
	});
</script>
