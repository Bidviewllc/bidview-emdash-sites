---
// Page 14 · Patient resources (boards ResourcesPage, ResourcesAccordion,
// ResourcesGrouped, ResourcesMobile). Hero → resources as cards or an accordion,
// optionally grouped by tag with a "Jump to" list (chips on phones) → latest
// articles → outside organizations → CTA.
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import PostCard from "../components/PostCard.astro";
import ResCard from "../components/ResCard.astro";
import type { Tweak } from "../components/ReviewControls.astro";
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/settings";
import { routes, slugify } from "../lib/routes";

const { posts, resourceGroups, resources } = Astro.locals.site;

const tweaks: Tweak[] = [
	{ key: "layout", label: "Layout", type: "choice", default: "cards", options: [["cards", "Cards"], ["accordion", "Accordion"]] },
	{ key: "group", label: "Group by", type: "choice", default: "none", options: [["none", "None"], ["tag", "Tag"]] },
];
const s = getSettings(Astro);
const h = s.href;
const hero = s.heroFor("photo");
const withPhoto = hero === "photo" || hero === "example";
const layout = s.choice("layout", ["cards", "accordion"], "cards");
const grouped = s.choice("group", ["none", "tag"], "none") === "tag";
const groups = resourceGroups
	.map((name, i) => ({ name, id: "g-" + slugify(name), items: resources.filter((r) => r.tags[0] === name) }))
	.filter((g) => g.items.length)
	.map((g, i) => ({ ...g, n: i + 1 }));
---
<Base title={`Patient resources | ${s.name}`} description="What to expect, insurance and financing, forms and hearing aid care, in one place." pageName="Patient resources" current="resources" tweaks={tweaks} heroDefault="photo">
	<PageHero
		crumbs={[{ label: "Home" }, { label: "Patient Resources" }]}
		title="Patient resources"
		lead="Pariatur excepteur sint occaecat cupidatat non proident sunt in culpa. Qui officia deserunt mollit anim id est laborum curabitur pretium tincidunt lacus nulla gravida. Orci a odio nullam varius turpis."
		photoLabel="Page hero photo · 3:2"
	/>

	<section class:list={["band first", { "after-photo": withPhoto }]}>
		<div class="wrap">
			{
				!grouped && layout === "cards" && (
					<div class="panel grid g-3">
						{resources.map((r) => <ResCard r={r} />)}
					</div>
				)
			}
			{
				!grouped && layout === "accordion" && (
					<div class="acc-list res-acc">
						{resources.map((r, i) => (
							<div class="acc" data-acc>
								<h2 style="margin: 0">
									<button class="acc-btn" type="button" aria-expanded="false" aria-controls={`res-${i}`}>
										<span class="stack g8" style="align-items: flex-start"><span class="res-tags">{r.tags.map((t) => <span class="tag">{t}</span>)}</span><span>{r.t}</span></span>
										<span class="acc-ic" aria-hidden="true"><span class="i-open"><Icon name="plus" /></span><span class="i-close"><Icon name="minus" /></span></span>
									</button>
								</h2>
								<div class="acc-body" id={`res-${i}`} hidden>
									<p>{r.d}</p>
									{r.page && <div class="actions"><a class="btn btn-gray sm" href={h(routes.resource(r.slug))}>Learn more<span class="sr"> about {r.t}</span></a></div>}
									{r.forms && <div class="actions rowf" style="gap: 10px"><a class="btn btn-secondary sm" href="#"><Icon name="doc" size={18} /> Download PDF</a><a class="btn btn-primary sm" href="#">Fill out online</a></div>}
								</div>
							</div>
						))}
					</div>
				)
			}
			{
				grouped && (
					<div class="res-grouped">
						<nav class="res-toc" aria-label="Jump to a topic">
							<span class="feat-h" style="margin: 0 0 8px 14px">Jump to</span>
							<ul>{groups.map((g, i) => <li><a class:list={["side-cat", { on: i === 0 }]} href={`#${g.id}`}><span>{g.name}</span><span class="cnt">{g.items.length}</span></a></li>)}</ul>
						</nav>
						<div class="stack g64">
							{groups.map((g) => (
								<section class="stack g24" aria-labelledby={g.id} id={`${g.id}-s`}>
									<div class="res-gh"><span class="res-num" aria-hidden="true">{g.n}</span><h2 class="h2" id={g.id} style="font-size: 34px">{g.name}</h2></div>
									<div class="panel grid g-2">{g.items.map((r) => <ResCard r={r} />)}</div>
								</section>
							))}
						</div>
					</div>
				)
			}
		</div>
	</section>

	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="shead">
				<div class="stack g16"><span class="eyebrow">From our blog</span><h2 class="h2">Latest articles</h2></div>
				<a class="link-arrow" href={h(routes.blog)}>All articles <Icon name="arrowR" size={18} /></a>
			</div>
			<div class="grid g-3 posts-grid" style="gap: 32px">{posts.slice(0, 3).map((p) => <PostCard p={p} />)}</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap stack g32">
			<div class="stack g12"><span class="eyebrow">Outside organizations</span><h2 class="h2">Helpful organizations</h2></div>
			<ul class="creds org-row">
				<li><a class="cred org" href="#"><span class="org-word">Hearing Loss Association of America</span><span class="org-note">Logo placeholder</span></a></li>
				<li><a class="cred org" href="#"><img src="/assets/associations/color/aaa.png" alt="American Academy of Audiology" style="max-height: 50px" /></a></li>
				<li><a class="cred org" href="#"><span class="org-word">American Tinnitus Association</span><span class="org-note">Logo placeholder</span></a></li>
				<li><a class="cred org" href="#"><img src="/assets/associations/color/asha.png" alt="American Speech-Language-Hearing Association (ASHA)" style="max-height: 46px" /></a></li>
			</ul>
		</div>
	</section>

	<div class="cta-wrap">
		<CtaBand id="prcta" heading="Take the first step toward better hearing" text="Pretium tincidunt lacus nulla gravida orci a odio nullam varius turpis. Et commodo pharetra est eros bibendum elit." photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>
