---
// Anything without a page of its own. Paths for content that comes later
// (resource articles, the sitemap, the /review hub in Step 3) get a short
// "coming later" note; everything else gets the designed 404 page.
import Icon from "../components/Icon.astro";
import NotFound from "../components/NotFound.astro";
import { routes, services } from "../data/practice";
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/settings";

const s = getSettings(Astro.url);
const slug = Astro.params.slug ?? "";
const later = /^(patient-resources\/|sitemap$|review$)/.test(slug);
const last = slug.split("/").filter(Boolean).pop() ?? "";
const name = last.replace(/-/g, " ").replace(/^\w/, (c) => c.toUpperCase()) || "This page";
---
{
	later ? (
		<Base title={`${name} | ${s.name}`} description="This page comes in a later build step." pageName={name}>
			<div class="pg-hero-np">
				<section class="inophoto short" style="background: var(--l); color: var(--on-l)">
					<div class="wrap">
						<div class="stack g24" style="max-width: 760px">
							<span class="eyebrow">Coming later</span>
							<h1 class="h1">{name}</h1>
							<p class="lead" style="color: inherit">This page is not part of the 17 designed templates yet. In the live template it comes from the practice’s own content.</p>
							<div class="rowf" style="gap: 12px">
								<a class="btn btn-primary" href={s.href(routes.home)}>Go to the home page</a>
								<a class="btn btn-secondary" href={s.href(routes.service(services[0].slug))}>See a service page <Icon name="arrowR" /></a>
							</div>
						</div>
					</div>
				</section>
			</div>
			<div style="height: 96px" />
		</Base>
	) : (
		<NotFound />
	)
}
