---
// Page 8 · Location (boards LocationPage, LocationMobile, LocationPageAlt). One per office.
// Hero (office exterior) → details card + map → providers at this office
// (horizontal cards) → services (Home card style) → reviews → CTA.
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import ProviderCard from "../../components/ProviderCard.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import ServiceCards from "../../components/ServiceCards.astro";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";
import { routes, telHref } from "../../lib/routes";

const { offices: allOffices, providers, reviewsByLocation, services } = Astro.locals.site;

const s = getSettings(Astro);
const office = s.offices.find((o) => o.slug === Astro.params.office) ?? allOffices.find((o) => o.slug === Astro.params.office);
if (!office) return Astro.rewrite("/404");

const tweaks: Tweak[] = [
	{ key: "svclinks", label: "Service “Learn more”", type: "choice", default: "mixed", options: [["mixed", "Mixed (pages that exist)"], ["all", "All cards"], ["none", "None"]] },
	{ key: "provlinks", label: "Provider profile linked", type: "bool", default: true },
];
const h = s.href;
const hero = s.heroFor("photo", office.photo);
/** This office's two newest reviews (none: the section is left out). */
const officeReviews = (reviewsByLocation[office.slug] ?? []).slice(0, 2);
const withPhoto = hero === "photo" || hero === "example";
const svcLinks = s.choice("svclinks", ["mixed", "all", "none"], "mixed");
const provLinked = s.bool("provlinks", true);
const team = providers.filter((p) => p.offices.includes(office.slug) && p.title.includes("Audiologist"));
const town = office.shortName;
const others = (p: (typeof providers)[number]) =>
	p.offices.length > 1 ? `Sees patients in ${p.offices.map((o) => allOffices.find((x) => x.slug === o)?.shortName).join(" and ")}` : "";
---
<Base title={`Hearing care in ${town} | ${s.name}`} description={`Our ${town} office: address, phone, hours, directions and the audiologists who see patients there.`} pageName="Location" tweaks={tweaks} heroDefault="photo">
	<PageHero
		crumbs={[{ label: "Home" }, { label: "Locations", href: routes.contact }, { label: town }]}
		title={`Hearing care in ${town}`}
		lead={s.fill(office.intro ?? "")}
		photoLabel="Office exterior photo · 3:2"
		image={office.photo}
		photoTone="stone"
	/>

	<section class:list={["band first", { "after-photo": withPhoto }]}>
		<div class="wrap">
			<div class="panel loc-grid">
				<div class="card loc-card">
					<div class="stack g8"><span class="eyebrow">Office details</span><h2 class="h2">{office.name}</h2></div>
					<div class="loc-facts">
						<div class="drow"><span class="di"><Icon name="pin2" /></span><div class="stack g4"><span class="feat-h">Address</span><address style="font-style: normal">{office.street}<br />{office.city}</address></div></div>
						<div class="drow"><span class="di"><Icon name="phone" /></span><div class="stack g4"><span class="feat-h">Phone</span><a href={telHref(office.phone)} style="font-weight: 700; font-size: 20px">{office.phone}</a></div></div>
						<div class="drow"><span class="di"><Icon name="clock" /></span><div class="stack g4"><span class="feat-h">Hours</span><span set:html={office.hoursLong} /></div></div>
					</div>
					<div class="loc-notes">
						<div class="drow"><span class="di"><Icon name="car" /></span><div class="stack g4"><h3 class="h4">Directions and parking</h3><p class="muted">{s.fill(office.directions ?? "")}</p></div></div>
						<div class="drow"><span class="di"><Icon name="access" /></span><div class="stack g4"><h3 class="h4">Accessibility</h3><p class="muted">{s.fill(office.accessNotes ?? "")}</p></div></div>
					</div>
					<a class="btn btn-primary" href={office.mapsUrl} style="align-self: flex-start">Get directions <Icon name="arrowUR" /></a>
				</div>
				<div class="ph stone loc-map"><span class="ph-label">Map · loads on tap</span></div>
			</div>
		</div>
	</section>

	<section class="band bg-light">
		<div class="wrap loc-prov">
			<div class="stack g16">
				<span class="eyebrow">Providers</span>
				<h2 class="h2">Your audiologists in {town}</h2>
				<a class="link-arrow" href={h(routes.about + "#team")} style="align-self: flex-start">Meet the whole team <Icon name="arrowR" size={18} /></a>
			</div>
			<div class="provh-grid">
				{team.map((p) => (
					<ProviderCard p={p} linked={provLinked && p.hasPage} horizontal>
						{others(p) && <span class="ptitle">{others(p)}</span>}
					</ProviderCard>
				))}
			</div>
		</div>
	</section>

	<section class="band">
		<div class="wrap stack g48">
			<div class="stack g16" style="max-width: 760px">
				<span class="eyebrow">Services</span>
				<h2 class="h2">Services offered in {town}</h2>
			</div>
			<div class="stack g24">
				<div class="loc-svc"><ServiceCards items={services.filter((x) => x.onHome !== false).slice(0, 4)} links={svcLinks} /></div>
				<a class="link-arrow" href={h(routes.services)} style="align-self: flex-start">View all services <Icon name="arrowR" size={18} /></a>
			</div>
		</div>
	</section>

	{officeReviews.length > 0 && (
	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="stack g16">
				<span class="eyebrow">Reviews</span>
				<h2 class="h2">What {town} patients say</h2>
			</div>
			<div class="panel grid g-2">{officeReviews.map((r) => <ReviewCard review={r} />)}</div>
			<a class="link-arrow" href={h(routes.reviews)} style="align-self: flex-start">Read more reviews <Icon name="arrowR" size={18} /></a>
		</div>
	</section>
	)}

	<div class="cta-wrap after-inset">
		<CtaBand id="lcta" heading={`Visit our ${town} office`} text="Ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure. Dolor in reprehenderit in voluptate." photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>
