---
// Page 13 · Blog post (boards PostPage, PostMobile, PostPageAlt).
// Header: text left (breadcrumb, tag, H1, byline), 3:2 image right (optional) →
// article (20px) with a mid-article booking box, then the author box; sticky
// sidebar with a Book card and Recent articles → related articles → CTA.
// Post links are fine here: this is the blog, not a service page.
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import PostCard from "../../components/PostCard.astro";
import type { Tweak } from "../../components/ReviewControls.astro";
import { articleBody, featured, posts } from "../../data/blog";
import { providers, routes, telHref } from "../../data/practice";
import Base from "../../layouts/Base.astro";
import { getSettings } from "../../lib/settings";

const post = [featured, ...posts].find((p) => p.slug === Astro.params.slug);
if (!post) return Astro.rewrite("/404");

const tweaks: Tweak[] = [
	{ key: "image", label: "Featured image", type: "bool", default: true },
	{ key: "authorlink", label: "Author profile linked", type: "bool", default: true },
];
const s = getSettings(Astro.url);
const h = s.href;
const showImage = s.bool("image", true);
const authorLinked = s.bool("authorlink", true);
const author = providers.find((p) => p.name === post.author) ?? providers[0];
const recent = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const related = posts.filter((p) => p.slug !== post.slug && p.catSlug === post.catSlug).concat(posts.filter((p) => p.catSlug !== post.catSlug)).slice(0, 3);
const midCta = `<aside class="mid-cta" aria-label="Book a hearing evaluation"><span class="mc-ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg></span><div class="stack g12"><p class="mc-t">Not sure where your hearing stands? Book a hearing evaluation.</p><a class="btn btn-primary" href="${h(routes.book)}" style="align-self: flex-start">Book appointment</a></div></aside>`;
const body = articleBody.map((b) => (b === "MIDCTA" ? midCta : b)).join("\n");
const sil = `<svg class="sil" viewBox="0 0 200 220" aria-hidden="true"><circle cx="100" cy="80" r="44" fill="currentColor"></circle><path d="M18 220c0-54 37-88 82-88s82 34 82 88z" fill="currentColor"></path></svg>`;
---
<Base title={`${post.title} | ${s.name}`} description={post.summary} pageName="Blog post" current="blog" tweaks={tweaks}>
	<article>
		<header class="band post-head">
			<div class:list={["wrap", { ihero: showImage }]}>
				<div class="stack g24" style={showImage ? undefined : "max-width: 820px"}>
					<nav aria-label="Breadcrumb">
						<ol class="crumbs">
							<li><a href={h(routes.home)}>Home</a></li><li class="sep" aria-hidden="true">/</li>
							<li><a href={h(routes.blog)}>Blog</a></li><li class="sep" aria-hidden="true">/</li>
							<li aria-current="page">{post.cat}</li>
						</ol>
					</nav>
					<a class="tag" href={h(routes.category(post.catSlug))} style="text-decoration: none">{post.cat}</a>
					<h1 class="h1 xl post-h1">{post.title}</h1>
					<div class="byline">
						<span class="avatar ph stone" aria-hidden="true" set:html={sil} />
						<div class="stack g4">
							<span class="by-name">By {authorLinked && author.hasPage ? <a href={h(routes.provider(author.slug))}>{author.name}</a> : <b>{author.name}</b>}</span>
							<span class="by-meta"><time>{post.date}</time><span aria-hidden="true"> · </span>6 min read</span>
						</div>
					</div>
				</div>
				{showImage && <div class:list={["ph", post.tone]} style="aspect-ratio: 3/2; border-radius: var(--r-hero)"><span class="ph-label">Featured image · 3:2 (optional)</span></div>}
			</div>
		</header>

		<div class="band post-body">
			<div class="wrap side-layout">
				<div class="stack g64">
					<div class="rt" set:html={body} />
					<div class="panel author-box">
						<div class="card" style="flex-direction: row; gap: 24px; align-items: flex-start">
							<span class="avatar lg ph stone" aria-hidden="true" set:html={sil} />
							<div class="stack g12">
								<span class="feat-h" style="margin: 0">About the author</span>
								<h2 class="h3">{author.name}</h2>
								<p class="muted" style="margin: 0">Ad minim veniam quis nostrud exercitation ullamco laboris nisi. Ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in. Voluptate velit esse cillum dolore eu fugiat nulla.</p>
								{authorLinked && author.hasPage && <a class="link-arrow" href={h(routes.provider(author.slug))} style="align-self: flex-start">View {author.short}’s profile <Icon name="arrowR" size={18} /></a>}
							</div>
						</div>
					</div>
				</div>
				<aside class="sidebar sticky" aria-label="Book and recent articles">
					<div class="panel">
						<div class="card side-card">
							<h2 class="h3">Book a hearing evaluation</h2>
							<p class="muted">Aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit. In voluptate velit.</p>
							<a class="btn btn-primary block" href={h(routes.book)}>Book appointment</a>
							<a class="tel" href={telHref(s.phone)} style="justify-content: center"><span class="ico"><Icon name="phone" /></span>{s.phone}</a>
						</div>
					</div>
					<div class="panel">
						<div class="card side-card" style="gap: 8px">
							<h2 class="h3" style="margin-bottom: 6px">Recent articles</h2>
							{recent.map((p) => (
								<a class="mini-post" href={h(routes.post(p.slug))}>
									<div class:list={["ph", p.tone]} />
									<div class="stack" style="gap: 2px"><span class="date">{p.date}</span><b>{p.title}</b></div>
								</a>
							))}
						</div>
					</div>
				</aside>
			</div>
		</div>
	</article>

	<section class="band bg-light">
		<div class="wrap stack g48">
			<div class="shead">
				<div class="stack g16"><span class="eyebrow">Keep reading</span><h2 class="h2">Related articles</h2></div>
				<a class="link-arrow" href={h(routes.blog)}>All articles <Icon name="arrowR" size={18} /></a>
			</div>
			<div class="grid g-3 posts-grid" style="gap: 32px">{related.map((p) => <PostCard p={p} />)}</div>
		</div>
	</section>

	<div class="cta-wrap after-inset">
		<CtaBand id="bpcta" heading="Take the first step toward better hearing" text="Pretium tincidunt lacus nulla gravida orci a odio nullam varius turpis. Et commodo pharetra est eros bibendum elit." photoLabel="Lifestyle photo · conversation, meal, outdoors" />
	</div>
</Base>
