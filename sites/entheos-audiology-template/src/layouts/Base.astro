---
// Page shell: fonts, styles, practice colours, header, footer and (on review
// builds) the Review controls panel.
import "../styles/d1.css";
import "../styles/site.css";
import ReviewControls, { type Tweak } from "../components/ReviewControls.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { roleVars, styleString } from "../lib/color";
import { getSettings, type HeroKey } from "../lib/settings";

interface Props {
	title: string;
	description: string;
	pageName: string;
	current?: "services" | "hearing-aids" | "about" | "resources" | "blog" | "contact";
	tweaks?: Tweak[];
	heroDefault?: HeroKey;
}
const { title, description, pageName, current, tweaks = [], heroDefault } = Astro.props;
const s = getSettings(Astro);
const style = styleString(roleVars(s.colors));
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="d1 page" style={style} data-lshape={s.logoShape}>
		<a class="skip" href="#main">Skip to main content</a>
		<SiteHeader current={current} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
		{s.showPanel && <ReviewControls pageName={pageName} tweaks={tweaks} heroDefault={heroDefault} />}
		<script>
			// Accordions (FAQ, tables of contents, resource lists): the button opens and closes its panel.
			document.querySelectorAll<HTMLElement>("[data-acc]").forEach((acc) => {
				const btn = acc.querySelector<HTMLButtonElement>("button[aria-controls]");
				const panel = btn && document.getElementById(btn.getAttribute("aria-controls")!);
				if (!btn || !panel) return;
				btn.addEventListener("click", () => {
					const open = panel.hidden;
					panel.hidden = !open;
					btn.setAttribute("aria-expanded", String(open));
					acc.classList.toggle("open", open);
				});
			});
			// Demo form: checks the required fields and shows the error next to each one,
			// in words. When it passes, it goes to the thank-you page (nothing is sent yet).
			document.querySelectorAll<HTMLFormElement>("[data-form]").forEach((form) => {
				form.addEventListener("submit", (e) => {
					e.preventDefault();
					let first: HTMLInputElement | null = null;
					form.querySelectorAll<HTMLInputElement>("[required]").forEach((input) => {
						const err = document.getElementById(input.getAttribute("aria-describedby") ?? "");
						const bad = !input.value.trim() || (input.type === "tel" && input.value.replace(/\D/g, "").length < 7);
						input.classList.toggle("err", bad);
						input.setAttribute("aria-invalid", String(bad));
						if (err) err.hidden = !bad;
						if (bad && !first) first = input;
					});
					if (first) (first as HTMLInputElement).focus();
					else location.assign(form.getAttribute("action")!);
				});
			});
			// "Read more" on a clamped review opens the full text.
			document.querySelectorAll<HTMLButtonElement>(".readmore").forEach((btn) => {
				btn.addEventListener("click", () => {
					const text = btn.parentElement!.querySelector(".rtext")!;
					const open = text.classList.toggle("is-open");
					btn.setAttribute("aria-expanded", String(open));
					btn.textContent = open ? "Show less" : "Read more";
				});
			});
		</script>
	</body>
</html>
